--
-- Table structure for table `link_games`
--

DROP TABLE IF EXISTS `link_games`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `link_games` (
  `link_id` int NOT NULL AUTO_INCREMENT,
  `parent_game_id` int NOT NULL,
  `child_game_id` int NOT NULL,
  `user_id` int NOT NULL,
  `game_isSequel` tinyint(1) DEFAULT '0',
  `game_isDLC` tinyint(1) DEFAULT '0',
  `game_cDate` text,
  `game_link_approved` tinyint(1) DEFAULT '0',
  `game_aDate` text,
  `game_denied` tinyint(1) DEFAULT '0',
  `game_dDate` text,
  `game_dDes` text,
  PRIMARY KEY (`link_id`),
  KEY `parent_game_id` (`parent_game_id`),
