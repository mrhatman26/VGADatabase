--
-- Table structure for table `link_game_user`
--

DROP TABLE IF EXISTS `link_game_user`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `link_game_user` (
  `link_id` int NOT NULL AUTO_INCREMENT,
  `game_id` int NOT NULL,
  `user_id` int NOT NULL,
  `game_cDate` text,
  `game_link_approved` tinyint(1) DEFAULT '0',
  `game_aDate` text,
  `game_denied` tinyint(1) DEFAULT '0',
  `game_dDate` text,
  `game_dDes` text,
  PRIMARY KEY (`link_id`),
  KEY `game_id` (`game_id`),
  KEY `user_id` (`user_id`),
  CONSTRAINT `link_game_user_ibfk_1` FOREIGN KEY (`game_id`) REFERENCES `table_games` (`game_id`),
  CONSTRAINT `link_game_user_ibfk_2` FOREIGN KEY (`user_id`) REFERENCES `table_users` (`user_id`)
) ENGINE=InnoDB AUTO_INCREMENT=9445 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

