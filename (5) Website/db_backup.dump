  CONSTRAINT `link_game_update_ibfk_1` FOREIGN KEY (`game_id`) REFERENCES `table_games` (`game_id`),
  CONSTRAINT `link_game_update_ibfk_2` FOREIGN KEY (`update_id`) REFERENCES `table_update_history` (`update_id`),
  CONSTRAINT `link_game_update_ibfk_3` FOREIGN KEY (`user_id`) REFERENCES `table_users` (`user_id`)
) ENGINE=InnoDB AUTO_INCREMENT=9445 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
