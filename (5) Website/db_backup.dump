LOCK TABLES `table_games` WRITE;
/*!40000 ALTER TABLE `table_games` DISABLE KEYS */;
INSERT INTO `table_games` VALUES (1,'counter-strike_2',NULL,'For over two decades, Counter-Strike has offered an elite competitive experience, one shaped by millions of players from across the globe. And now the next chapter in the CS story is about to begin. This is Counter-Strike 2.','2012/8/21','Released','https://store.steampowered.com/app/730/CounterStrike_2/?snr=1_7_7_230_150_1'),(2,'clair_obscur:_expedition_33',NULL,'Lead the members of Expedition 33 on their quest to destroy the Paintress so that she can never paint death again. Explore a world of wonders inspired by Belle Époque France and battle unique enemies in this turn-based RPG with real-time mechanics.','2025/4/24','Released','https://store.steampowered.com/app/1903340/Clair_Obscur_Expedition_33/?snr=1_7_7_230_150_1'),(3,'cyberpunk_2077',NULL,'Cyberpunk 2077 is an open-world, action-adventure RPG set in the dark future of Night City — a dangerous megalopolis obsessed with power, glamor, and ceaseless body modification.','2020/12/9','Released','https://store.steampowered.com/app/1091500/Cyberpunk_2077/?snr=1_7_7_230_150_1'),(4,'baldur\'s_gate_3',NULL,'Baldur’s Gate 3 is a story-rich, party-based RPG set in the universe of Dungeons & Dragons, where your choices shape a tale of fellowship and betrayal, survival and sacrifice, and the lure of absolute power.','2023/8/3','Released','https://store.steampowered.com/app/1086940/Baldurs_Gate_3/?snr=1_7_7_230_150_1'),(5,'dead_by_daylight',NULL,'Trapped forever in a realm of eldritch evil where even death is not an escape, four determined Survivors face a bloodthirsty Killer in a vicious game of nerve and wits. Pick a side and step into a world of tension and terror with horror gaming\'s best asymmetrical multiplayer.','2016/6/14','Released','https://store.steampowered.com/app/381210/Dead_by_Daylight/?snr=1_7_7_230_150_1'),(6,'schedule_i',NULL,'From small-time dope pusher to kingpin - manufacture and distribute a range of drugs throughout the grungy city of Hyland Point. Expand your empire with properties, businesses, employees and more.','2025/3/24','Released','https://store.steampowered.com/app/3164500/Schedule_I/?snr=1_7_7_230_150_1'),(7,'red_dead_redemption_2',NULL,'Winner of over 175 Game of the Year Awards and recipient of over 250 perfect scores, RDR2 is the epic tale of outlaw Arthur Morgan and the infamous Van der Linde gang, on the run across America at the dawn of the modern age. Also includes access to the shared living world of Red Dead Online.','2019/12/5','Released','https://store.steampowered.com/app/1174180/Red_Dead_Redemption_2/?snr=1_7_7_230_150_1'),(8,'elden_ring',NULL,'THE CRITICALLY ACCLAIMED FANTASY ACTION RPG. Rise, Tarnished, and be guided by grace to brandish the power of the Elden Ring and become an Elden Lord in the Lands Between.','2022/2/24','Released','https://store.steampowered.com/app/1245620/ELDEN_RING/?snr=1_7_7_230_150_1'),(9,'warframe',NULL,'Awaken as an unstoppable warrior and battle alongside your friends in this story-driven free-to-play online action game','2013/3/25','Released','https://store.steampowered.com/app/230410/Warframe/?snr=1_7_7_230_150_1'),(10,'war_thunder',NULL,'War Thunder is the most comprehensive free-to-play, cross-platform, MMO military game dedicated to aviation, armoured vehicles, and naval craft, from the early 20th century to the most advanced modern combat units. Join now and take part in major battles on land, in the air, and at sea.','2013/8/15','Released','https://store.steampowered.com/app/236390/War_Thunder/?snr=1_7_7_230_150_1'),(11,'r.e.p.o.',NULL,'An online co-op horror game with up to 6 players. Locate valuable, fully physics-based objects and handle them with care as you retrieve and extract to satisfy your creator\'s desires.','2025/2/26','Released','https://store.steampowered.com/app/3241660/REPO/?snr=1_7_7_230_150_1'),(12,'rematch',NULL,'Control one player on your team and compete in fast-paced 5v5 matches from an immersive third-person perspective. Team up with your friends and join the action.','2025/6/19','Released','https://store.steampowered.com/app/2138720/REMATCH/?snr=1_7_7_230_150_1'),(13,'death_stranding_director\'s_cut',NULL,'From legendary game creator Hideo Kojima comes a genre-defying experience, now expanded in this definitive DIRECTOR’S CUT. As Sam Bridges, your mission is to deliver hope to humanity by connecting the last survivors of a decimated America. Can you reunite the shattered world, one step at a time?','2022/3/30','Released','https://store.steampowered.com/app/1850570/DEATH_STRANDING_DIRECTORS_CUT/?snr=1_7_7_230_150_1'),(14,'stellaris',NULL,'Explore a galaxy full of wonders in this sci-fi grand strategy game from Paradox Development Studios. Interact with diverse alien races, discover strange new worlds with unexpected events and expand the reach of your empire. Each new adventure holds almost limitless possibilities.','2016/5/9','Released','https://store.steampowered.com/app/281990/Stellaris/?snr=1_7_7_230_150_1'),(15,'cyberpunk_2077:_phantom_liberty',NULL,'This content requires the base game Cyberpunk 2077 on Steam in order to play.','2023/9/25','Released','https://store.steampowered.com/app/2138330/Cyberpunk_2077_Phantom_Liberty/?snr=1_7_7_230_150_1'),(16,'the_elder_scrolls®_online',NULL,'Every legend starts somewhere and in The Elder Scrolls Online, it starts with you. Join millions of players in an online, fantasy RPG set in a vast living Elder Scrolls world.','2014/4/4','Released','https://store.steampowered.com/app/306130/The_Elder_Scrolls_Online/?snr=1_7_7_230_150_1'),(17,'tom_clancy\'s_rainbow_six®_siege_x',NULL,'Rainbow Six Siege X is the reference in tactical team shooters, where elite strategy and execution triumph. Enjoy free access to Quick Match, Unranked and Dual Front game modes with a selection of operators.','2015/12/1','Released','https://store.steampowered.com/app/359550/Tom_Clancys_Rainbow_Six_Siege_X/?snr=1_7_7_230_150_1'),(18,'date_everything!',NULL,'Date Everything! is a sandbox dating simulator set in the comfort of your own home, featuring 100 fully voice acted datable characters! Let the romance flow between your bed, smoke alarm and… Overwhelming Sense of Existential Dread? Are you ready to Date Everything?','2025/6/17','Released','https://store.steampowered.com/app/2201320/Date_Everything/?snr=1_7_7_230_150_1'),(19,'warhammer_40,000:_darktide',NULL,'Take back the city of Tertium from hordes of bloodthirsty foes in this intense and brutal action shooter. Warhammer 40,000: Darktide is the new co-op focused experience from the award-winning team behind the Vermintide series. As Tertium falls, Rejects Will Rise.','2022/11/30','Released','https://store.steampowered.com/app/1361210/Warhammer_40000_Darktide/?snr=1_7_7_230_150_1'),(20,'warhammer_40,000:_rogue_trader',NULL,'Made in a close partnership with Games Workshop, Warhammer 40,000: Rogue Trader is a story-rich classical RPG from Owlcat Games, developers of the critically acclaimed game, Pathfinder: Wrath of the Righteous.','2023/12/7','Released','https://store.steampowered.com/app/2186680/Warhammer_40000_Rogue_Trader/?snr=1_7_7_230_150_1'),(21,'warhammer_40,000:_space_marine_2',NULL,'Embody the superhuman skill and brutality of a Space Marine. Unleash deadly abilities and devastating weaponry to obliterate the relentless Tyranid swarms. Defend the Imperium in spectacular third-person action in solo or multiplayer modes.','2024/9/9','Released','https://store.steampowered.com/app/2183900/Warhammer_40000_Space_Marine_2/?snr=1_7_7_230_150_1'),(22,'helldivers™_2',NULL,'The Galaxy’s Last Line of Offence. Enlist in the Helldivers and join the fight for freedom across a hostile galaxy in a fast, frantic, and ferocious third-person shooter.','2024/2/8','Released','https://store.steampowered.com/app/553850/HELLDIVERS_2/?snr=1_7_7_230_150_1'),(23,'dota_2',NULL,'Every day, millions of players worldwide enter battle as one of over a hundred Dota heroes. And no matter if it\'s their 10th hour of play or 1,000th, there\'s always something new to discover. With regular updates that ensure a constant evolution of gameplay, features, and heroes, Dota 2 has taken on a life of its own.','2013/7/9','Released','https://store.steampowered.com/app/570/Dota_2/?snr=1_7_7_230_150_1'),(24,'star_wars™_battlefront™_ii',NULL,'Be the hero in the ultimate STAR WARS™ battle fantasy with STAR WARS™ Battlefront™ II: Celebration Edition!','2017/11/16','Released','https://store.steampowered.com/app/1237950/STAR_WARS_Battlefront_II/?snr=1_7_7_230_150_1'),(25,'sons_of_the_forest',NULL,'Sent to find a missing billionaire on a remote island, you find yourself in a cannibal-infested hellscape. Craft, build, and struggle to survive, alone or with friends, in this terrifying new open-world survival horror simulator.','2024/2/22','Released','https://store.steampowered.com/app/1326470/Sons_Of_The_Forest/?snr=1_7_7_230_150_1'),(26,'elden_ring_nightreign',NULL,'ELDEN RING NIGHTREIGN is a standalone adventure within the ELDEN RING universe, crafted to offer players a new gaming experience by reimagining the game’s core design.','2025/5/29','Released','https://store.steampowered.com/app/2622380/ELDEN_RING_NIGHTREIGN/?snr=1_7_7_230_150_1'),(27,'hearts_of_iron_iv',NULL,'Victory is at your fingertips! Your ability to lead your nation is your supreme weapon, the strategy game Hearts of Iron IV lets you take command of any nation in World War II; the most engaging conflict in world history.','2016/6/6','Released','https://store.steampowered.com/app/394360/Hearts_of_Iron_IV/?snr=1_7_7_230_150_1'),(28,'destiny_2',NULL,'Destiny 2 is an action MMO with a single evolving world that you and your friends can join anytime, anywhere, absolutely free.','2019/10/1','Released','https://store.steampowered.com/app/1085660/Destiny_2/?snr=1_7_7_230_150_1'),(29,'the_sims™_4',NULL,'Play with life and discover the possibilities. Unleash your imagination and create a world of Sims that’s wholly unique. Explore and customize every detail from Sims to homes–and much more.','2014/9/2','Released','https://store.steampowered.com/app/1222670/The_Sims_4/?snr=1_7_7_230_150_1'),(30,'ready_or_not',NULL,'Ready or Not is an intense, tactical, first-person shooter that depicts a modern-day world in which SWAT police units are called to defuse hostile and confronting situations.','2023/12/13','Released','https://store.steampowered.com/app/1144200/Ready_or_Not/?snr=1_7_7_230_150_1'),(31,'rust',NULL,'The only aim in Rust is to survive. Everything wants you to die - the island’s wildlife, other inhabitants, the environment, and other survivors. Do whatever it takes to last another night.','2018/2/8','Released','https://store.steampowered.com/app/252490/Rust/?snr=1_7_7_230_150_1'),(32,'total_war:_warhammer_iii',NULL,'The cataclysmic conclusion to the Total War: WARHAMMER trilogy is here. Rally your forces and step into the Realm of Chaos, a dimension of mind-bending horror where the very fate of the world will be decided. Will you conquer your Daemons… or command them?','2022/2/16','Released','https://store.steampowered.com/app/1142710/Total_War_WARHAMMER_III/?snr=1_7_7_230_150_1'),(33,'the_elder_scrolls_iv:_oblivion_remastered',NULL,'Explore Cyrodiil like never before with stunning new visuals and refined gameplay in The Elder Scrolls IV: Oblivion™ Remastered.','2025/4/22','Released','https://store.steampowered.com/app/2623190/The_Elder_Scrolls_IV_Oblivion_Remastered/?snr=1_7_7_230_150_1'),(34,'euro_truck_simulator_2',NULL,'Travel across Europe as king of the road, a trucker who delivers important cargo across impressive distances! With dozens of cities to explore, your endurance, skill and speed will all be pushed to their limits.','2012/10/18','Released','https://store.steampowered.com/app/227300/Euro_Truck_Simulator_2/?snr=1_7_7_230_150_1'),(35,'deltarune',NULL,'Dive into the parallel story to UNDERTALE! Fight or spare your way through action-packed battles as you explore a mysterious world alongside an endearing cast of new and familiar characters. Chapters 1-4 will be available on launch, with more planned as free updates!','2025/6/4','Released','https://store.steampowered.com/app/1671210/DELTARUNE/?snr=1_7_7_230_150_1'),(36,'ea_sports_fc™_25',NULL,'EA SPORTS FC™ 25 gives you more ways to win for the club. Team up with friends in your favourite modes with the new 5v5 Rush, and manage your club to victory as FC IQ delivers more tactical control than ever before.','2024/9/26','Released','https://store.steampowered.com/app/2669320/EA_SPORTS_FC_25/?snr=1_7_7_230_150_1'),(37,'lies_of_p',NULL,'Lies of P is a thrilling soulslike that takes the story of Pinocchio, turns it on its head, and sets it against the darkly elegant backdrop of the Belle Epoque era.','2023/9/18','Released','https://store.steampowered.com/app/1627720/Lies_of_P/?snr=1_7_7_230_150_1'),(38,'jurassic_world_evolution_2',NULL,'Jurassic World Evolution 2 is the much-anticipated sequel to Frontier’s highly successful Jurassic World Evolution. This bold new era in the Jurassic World Evolution game franchise builds upon the ground-breaking and immersive 2018 management simulation.','2021/11/9','Released','https://store.steampowered.com/app/1244460/Jurassic_World_Evolution_2/?snr=1_7_7_230_150_1'),(39,'crusader_kings_iii',NULL,'Love, fight, scheme, and claim greatness. Determine your noble house’s legacy in the sprawling grand strategy of Crusader Kings III. Death is only the beginning as you guide your dynasty’s bloodline in the rich and larger-than-life simulation of the Middle Ages.','2020/9/1','Released','https://store.steampowered.com/app/1158310/Crusader_Kings_III/?snr=1_7_7_230_150_1'),(40,'stellar_blade™',NULL,'Save humanity from extinction in post-apocalyptic action-adventure Stellar Blade™. Experience blistering combat and a twisting storyline as you unravel the mysteries of Earth’s downfall.','2025/6/11','Released','https://store.steampowered.com/app/3489700/Stellar_Blade/?snr=1_7_7_230_150_1'),(41,'persona5:_the_phantom_x',NULL,'“We’re the Phantom Thieves, and we’re here to steal your heart!” The beloved RPG series with over 23.5 million copies sold finally arrives on PC and mobile!','2025/6/25','Released','https://store.steampowered.com/app/3061570/Persona5_The_Phantom_X/?snr=1_7_7_230_150_1'),(42,'kingdom_come:_deliverance_ii',NULL,'A thrilling story-driven action RPG, with a rich open world, set in 15th century Medieval Europe. Experience the ultimate medieval adventure - through the eyes of young Henry - as you embark on a journey of epic proportions.','2025/2/4','Released','https://store.steampowered.com/app/1771300/Kingdom_Come_Deliverance_II/?snr=1_7_7_230_150_1'),(43,'iracing',NULL,'We are the world’s premier motorsports racing game. An iRacing membership provides entry into the newest form of motorsport: internet racing. Internet racing is a fun, easy, and inexpensive way for race fan and gamers alike to enjoy the thrill of the racetrack from the comfort of their home.','2015/1/12','Released','https://store.steampowered.com/app/266410/iRacing/?snr=1_7_7_230_150_1'),(44,'f1®_25',NULL,'Leave your mark on the world of racing in F1® 25, the official video game of the 2025 FIA Formula One World Championship™, featuring a revamped My Team mode, the thrilling third chapter of Braking Point, and more!','2025/5/30','Released','https://store.steampowered.com/app/3059520/F1_25/?snr=1_7_7_230_150_1'),(45,'forza_horizon_5',NULL,'Explore the vibrant open world landscapes of Mexico with limitless, fun driving action in the world’s greatest cars.','2021/11/8','Released','https://store.steampowered.com/app/1551360/Forza_Horizon_5/?snr=1_7_7_230_150_1'),(46,'ark:_survival_ascended',NULL,'ARK is reimagined from the ground-up into the next-generation of video game technology with Unreal Engine 5! Form a tribe, tame & breed hundreds of unique dinosaurs and primeval creatures, explore, craft, build, and fight your way to the top of the food-chain. Your new world awaits!','2023/10/25','Released','https://store.steampowered.com/app/2399830/ARK_Survival_Ascended/?snr=1_7_7_230_150_1'),(47,'apex_legends™',NULL,'Apex Legends is the award-winning, free-to-play Hero Shooter from Respawn Entertainment. Master an ever-growing roster of legendary characters with powerful abilities, and experience strategic squad play and innovative gameplay in the next evolution of Hero Shooter and Battle Royale.','2020/11/4','Released','https://store.steampowered.com/app/1172470/Apex_Legends/?snr=1_7_7_230_150_1'),(48,'rimworld',NULL,'A sci-fi colony sim driven by an intelligent AI storyteller. Generates stories by simulating psychology, ecology, gunplay, melee combat, climate, biomes, diplomacy, interpersonal relationships, art, medicine, trade, and more.','2018/10/17','Released','https://store.steampowered.com/app/294100/RimWorld/?snr=1_7_7_230_150_1'),(49,'stardew_valley',NULL,'You\'ve inherited your grandfather\'s old farm plot in Stardew Valley. Armed with hand-me-down tools and a few coins, you set out to begin your new life. Can you learn to live off the land and turn these overgrown fields into a thriving home?','2016/2/26','Released','https://store.steampowered.com/app/413150/Stardew_Valley/?snr=1_7_7_230_150_2'),(50,'palworld',NULL,'Fight, farm, build and work alongside mysterious creatures called \"Pals\" in this completely new multiplayer, open world survival and crafting game!','2024/1/18','Released','https://store.steampowered.com/app/1623730/Palworld/?snr=1_7_7_230_150_2'),(51,'ghost_of_tsushima_director\'s_cut',NULL,'A storm is coming. Venture into the complete Ghost of Tsushima DIRECTOR’S CUT on PC; forge your own path through this open-world action adventure and uncover its hidden wonders. Brought to you by Sucker Punch Productions, Nixxes Software and PlayStation Studios.','2024/5/16','Released','https://store.steampowered.com/app/2215430/Ghost_of_Tsushima_DIRECTORS_CUT/?snr=1_7_7_230_150_2'),(52,'marvel\'s_spider-man_2',NULL,'Be Greater. Together. The incredible power of the symbiote forces Peter Parker and Miles Morales into a desperate fight as they balance their lives, friendships, and their duty to protect in an exciting chapter of the critically acclaimed Spider-Man franchise on PC.','2025/1/30','Released','https://store.steampowered.com/app/2651280/Marvels_SpiderMan_2/?snr=1_7_7_230_150_2'),(53,'fallout_76',NULL,'Bethesda Game Studios welcome you to Fallout 76. Twenty-five years after the bombs fall, you and your fellow Vault Dwellers emerge into post-nuclear America. Explore a vast wasteland in this open-world multiplayer addition to the Fallout story.','2020/4/14','Released','https://store.steampowered.com/app/1151340/Fallout_76/?snr=1_7_7_230_150_2'),(54,'broken_arrow',NULL,'Broken Arrow is a large-scale real-time modern warfare tactics game that combines the complexity of joint-forces wargaming with action-packed real-time tactics gameplay.','2025/6/19','Released','https://store.steampowered.com/app/1604270/Broken_Arrow/?snr=1_7_7_230_150_2'),(55,'black_myth:_wukong',NULL,'Black Myth: Wukong is an action RPG rooted in Chinese mythology. You shall set out as the Destined One to venture into the challenges and marvels ahead, to uncover the obscured truth beneath the veil of a glorious legend from the past.','2024/8/19','Released','https://store.steampowered.com/app/2358720/Black_Myth_Wukong/?snr=1_7_7_230_150_2'),(56,'the_last_of_us™_part_i',NULL,'Discover the award-winning game that inspired the critically acclaimed television show. Guide Joel and Ellie through a post-apocalyptic America, and encounter unforgettable allies and enemies in The Last of Us™.','2023/3/28','Released','https://store.steampowered.com/app/1888930/The_Last_of_Us_Part_I/?snr=1_7_7_230_150_2'),(57,'hogwarts_legacy',NULL,'Hogwarts Legacy is an immersive, open-world action RPG. Now you can take control of the action and be at the center of your own adventure in the wizarding world.','2023/2/10','Released','https://store.steampowered.com/app/990080/Hogwarts_Legacy/?snr=1_7_7_230_150_2'),(58,'marvel_rivals',NULL,'Marvel Rivals is a Super Hero Team-Based PVP Shooter! Assemble an all-star Marvel squad, devise countless strategies by combining powers to form unique Team-Up skills and fight in destructible, ever-changing battlefields across the continually evolving Marvel universe!','2024/12/5','Released','https://store.steampowered.com/app/2767030/Marvel_Rivals/?snr=1_7_7_230_150_2'),(59,'crash_bandicoot™_n._sane_trilogy',NULL,'Your favorite marsupial, Crash Bandicoot™, is back! He’s enhanced, entranced and ready-to-dance with the N. Sane Trilogy. Relive all your favorite moments in Crash Bandicoot™, Crash Bandicoot™ 2: Cortex Strikes Back and Crash Bandicoot™ 3: Warped, now in fully-remastered graphical glory!','2018/6/29','Released','https://store.steampowered.com/app/731490/Crash_Bandicoot_N_Sane_Trilogy/?snr=1_7_7_230_150_2'),(60,'victoria_3',NULL,'Paradox Development Studio invites you to build your ideal society in the tumult of the exciting and transformative 19th century. Balance the competing interests in your society and earn your place in the sun in Victoria 3, one of the most anticipated games in Paradox’s history.','2022/10/25','Released','https://store.steampowered.com/app/529340/Victoria_3/?snr=1_7_7_230_150_2'),(61,'red_dead_redemption',NULL,'Experience the story of former outlaw John Marston as he tracks down the last remaining members of the notorious Van der Linde Gang in the PC debut of the critically acclaimed predecessor to Red Dead Redemption 2.','2024/10/29','Released','https://store.steampowered.com/app/2668510/Red_Dead_Redemption/?snr=1_7_7_230_150_2'),(62,'train_sim_world®_5',NULL,'The Rails are Yours in Train Sim World 5! Take on new challenges and new roles as you master the tracks and trains of iconic cities across 3 new routes. Immerse yourself in the ultimate rail hobby and embark on your next journey.','2024/9/17','Released','https://store.steampowered.com/app/2967990/Train_Sim_World_5/?snr=1_7_7_230_150_2'),(63,'runescape:_dragonwilds',NULL,'On RuneScape’s forgotten continent of Ashenfall, dragons have awoken. Gather, build, skill and craft to survive in this co-operative (1-4) survival crafting game. Only by mastering survival and uncovering ancient secrets can they hope to slay the Dragon Queen—alone or with allies.','2025/4/15','Released','https://store.steampowered.com/app/1374490/RuneScape_Dragonwilds/?snr=1_7_7_230_150_2'),(64,'arma_reforger',NULL,'Experience authentic Cold War combat and join the struggle for the sprawling, mid-Atlantic island of Everon and its smaller, offshore territory, Arland – or take on the role of Game Master and create your very own scenarios for others to enjoy.','2023/11/16','Released','https://store.steampowered.com/app/1874880/Arma_Reforger/?snr=1_7_7_230_150_2'),(65,'tainted_grail:_the_fall_of_avalon',NULL,'Step into a dark reimagination of Arthurian legends in this first person, open world RPG. Explore a world stuck in everlasting autumn, witness falling legends and make meaningful choices woven into a complex, branching storyline.','2025/5/23','Released','https://store.steampowered.com/app/1466060/Tainted_Grail_The_Fall_of_Avalon/?snr=1_7_7_230_150_2'),(66,'phasmophobia',NULL,'Phasmophobia is a 4 player online co-op psychological horror. Paranormal activity is on the rise and it’s up to you and your team to use all the ghost-hunting equipment at your disposal in order to gather as much evidence as you can.','2020/9/18','Released','https://store.steampowered.com/app/739630/Phasmophobia/?snr=1_7_7_230_150_2'),(67,'vrchat',NULL,'Join our growing community as you explore, play, and help craft the future of social VR. Create worlds and custom avatars. Welcome to VRChat.','2017/2/1','Released','https://store.steampowered.com/app/438100/VRChat/?snr=1_7_7_230_150_2'),(68,'assassin’s_creed_shadows',NULL,'Experience an epic action-adventure story set in feudal Japan! Become a lethal shinobi assassin and powerful legendary samurai as you explore a beautiful open world in a time of chaos.','2025/3/19','Released','https://store.steampowered.com/app/3159330/Assassins_Creed_Shadows/?snr=1_7_7_230_150_2'),(69,'planet_zoo',NULL,'Build a world for wildlife in Planet Zoo. From the developers of Planet Coaster and Zoo Tycoon comes the ultimate zoo sim. Construct detailed habitats, manage your zoo, and meet authentic living animals who think, feel and explore the world you create around them.','2019/11/5','Released','https://store.steampowered.com/app/703080/Planet_Zoo/?snr=1_7_7_230_150_2'),(70,'satisfactory',NULL,'Satisfactory is a first-person open-world factory building game with a dash of exploration and combat. Play alone or with friends, explore an alien planet, create multi-story factories, and enter conveyor belt heaven!','2024/9/10','Released','https://store.steampowered.com/app/526870/Satisfactory/?snr=1_7_7_230_150_2'),(71,'star_wars_jedi:_survivor™',NULL,'The story of Cal Kestis continues in STAR WARS Jedi: Survivor™, a galaxy-spanning, third-person, action-adventure game.','2023/4/27','Released','https://store.steampowered.com/app/1774580/STAR_WARS_Jedi_Survivor/?snr=1_7_7_230_150_2'),(72,'pubg:_battlegrounds',NULL,'PUBG: BATTLEGROUNDS, the high-stakes winner-take-all shooter that started the Battle Royale craze, is free-to-play! Drop into diverse maps, loot unique weapons and supplies, and survive in an ever-shrinking zone where every turn could be your last.','2017/12/21','Released','https://store.steampowered.com/app/578080/PUBG_BATTLEGROUNDS/?snr=1_7_7_230_150_2'),(73,'resident_evil_4',NULL,'Survival is just the beginning. Six years have passed since the biological disaster in Raccoon City. Leon S. Kennedy, one of the survivors, tracks the president\'s kidnapped daughter to a secluded European village, where there is something terribly wrong with the locals.','2023/3/23','Released','https://store.steampowered.com/app/2050650/Resident_Evil_4/?snr=1_7_7_230_150_2'),(74,'drive_beyond_horizons',NULL,'Rev up your engines and venture into the unknown with Drive Beyond Horizons! Conquer dynamic landscapes, customize your ride, and unearth hidden treasures. Get ready for heart-pounding challenges and endless excitement. Your adventure starts now !','2025/3/24','Released','https://store.steampowered.com/app/2625420/Drive_Beyond_Horizons/?snr=1_7_7_230_150_2'),(75,'farming_simulator_25',NULL,'Farming Simulator 25 invites you to join the rewarding farm life, single-handedly or cooperatively in multiplayer. This Farm is Your Farm!','2024/11/12','Released','https://store.steampowered.com/app/2300320/Farming_Simulator_25/?snr=1_7_7_230_150_2'),(76,'nba_2k25',NULL,'Command every court with authenticity and realism Powered by ProPLAY™, giving you ultimate control over how you play in NBA 2K25. Define your legacy in MyCAREER, MyTEAM, MyNBA, and The W.','2024/10/28','Released','https://store.steampowered.com/app/2878980/NBA_2K25/?snr=1_7_7_230_150_2'),(77,'blue_prince',NULL,'Welcome to Mt. Holly, where every dawn unveils a new mystery. Navigate through shifting corridors and ever-changing chambers in this genre-defying strategy puzzle adventure. But will your unpredictable path lead you to the rumored Room 46?','2025/4/10','Released','https://store.steampowered.com/app/1569580/Blue_Prince/?snr=1_7_7_230_150_2'),(78,'europa_universalis_iv',NULL,'Rule your land and dominate the world with unparalleled freedom, depth and historical accuracy. Write a new history of the world and build an empire for the ages.','2013/8/13','Released','https://store.steampowered.com/app/236850/Europa_Universalis_IV/?snr=1_7_7_230_150_2'),(79,'house_flipper_2',NULL,'Clean your worries away with this relaxing renovation simulator! Buy, fix, sell, and become a local legend. Or grab your power tools and build anything from scratch! With the online 2-4 players co-op mode, you can play both in sandbox and story mode together.','2023/12/14','Released','https://store.steampowered.com/app/1190970/House_Flipper_2/?snr=1_7_7_230_150_2'),(80,'hitman_world_of_assassination',NULL,'Enter the world of the ultimate assassin. HITMAN World of Assassination delivers the definitive stealth action experience, putting you in the shoes of Agent 47, a master assassin. Explore immersive locations, uncover hidden secrets, and eliminate targets with complete freedom of approach.','2022/1/20','Released','https://store.steampowered.com/app/1659040/HITMAN_World_of_Assassination/?snr=1_7_7_230_150_2'),(81,'sea_of_thieves:_2025_edition',NULL,'Sea of Thieves is a smash-hit pirate adventure game, offering the quintessential pirate experience of plundering lost treasures, intense battles, vanquishing sea monsters and more. Dive in with this revised edition of the game, which includes access to digital bonus media.','2020/6/3','Released','https://store.steampowered.com/app/1172620/Sea_of_Thieves_2025_Edition/?snr=1_7_7_230_150_2'),(82,'robocop:_rogue_city',NULL,'Become the legendary part man, part machine, all cop hero and deliver justice in Old Detroit.','2023/11/2','Released','https://store.steampowered.com/app/1681430/RoboCop_Rogue_City/?snr=1_7_7_230_150_2'),(83,'split_fiction',NULL,'Embrace mind-blowing moments as you’re pulled deep into the many worlds of Split Fiction, a boundary-pushing co-op adventure.','2025/3/6','Released','https://store.steampowered.com/app/2001120/Split_Fiction/?snr=1_7_7_230_150_2'),(84,'football_manager_2024',NULL,'Build a world-class team ready to dominate your rivals in football’s most prestigious competitions. Progress never stops when you’re pursuing footballing greatness.','2023/11/6','Released','https://store.steampowered.com/app/2252570/Football_Manager_2024/?snr=1_7_7_230_150_2'),(85,'the_witcher_3:_wild_hunt',NULL,'You are Geralt of Rivia, mercenary monster slayer. Before you stands a war-torn, monster-infested continent you can explore at will. Your current contract? Tracking down Ciri — the Child of Prophecy, a living weapon that can alter the shape of the world.','2015/5/18','Released','https://store.steampowered.com/app/292030/The_Witcher_3_Wild_Hunt/?snr=1_7_7_230_150_2'),(86,'beamng.drive',NULL,'A dynamic soft-body physics vehicle simulator capable of doing just about anything.','2015/5/29','Released','https://store.steampowered.com/app/284160/BeamNGdrive/?snr=1_7_7_230_150_2'),(87,'american_truck_simulator',NULL,'Experience legendary American trucks and deliver various cargoes across sunny California, sandy Nevada, and the Grand Canyon State of Arizona. American Truck Simulator takes you on a journey through the breathtaking landscapes and widely recognized landmarks around the States.','2016/2/2','Released','https://store.steampowered.com/app/270880/American_Truck_Simulator/?snr=1_7_7_230_150_2'),(88,'star_wars™:_the_old_republic™',NULL,'STAR WARS™: The Old Republic™ is a free-to-play MMORPG that puts you at the center of your own story-driven saga. Play as a Jedi, Sith, Bounty Hunter, or one of many other iconic STAR WARS roles in the galaxy far, far away over three thousand years before the classic films.','2011/12/20','Released','https://store.steampowered.com/app/1286830/STAR_WARS_The_Old_Republic/?snr=1_7_7_230_150_2'),(89,'umamusume:_pretty_derby',NULL,'Umamusume: Pretty Derby is ready to race! Scout featured trainees and supporters as you navigate the immersive sports life simulation through the game\'s in-depth training system and top-of-the-line 3D graphics!','2025/6/24','Released','https://store.steampowered.com/app/3224770/Umamusume_Pretty_Derby/?snr=1_7_7_230_150_2'),(90,'call_of_duty®:_black_ops_iii',NULL,'Call of Duty®: Black Ops III Zombies Chronicles Edition includes the full base game plus the Zombies Chronicles content expansion.','2015/11/5','Released','https://store.steampowered.com/app/311210/Call_of_Duty_Black_Ops_III/?snr=1_7_7_230_150_2'),(91,'wuthering_waves',NULL,'Wuthering Waves is a story-rich open-world action RPG with a high degree of freedom. You wake from your slumber as Rover, joined by a vibrant cast of Resonators on a journey to reclaim your lost memories and change the world.','2025/4/28','Released','https://store.steampowered.com/app/3513350/Wuthering_Waves/?snr=1_7_7_230_150_2'),(92,'final_fantasy_vii_remake_intergrade',NULL,'Cloud Strife, an ex-SOLDIER operative, descends on the mako-powered city of Midgar. The world of the timeless classic FINAL FANTASY VII is reborn, using cutting-edge graphics technology, a new battle system and an additional adventure featuring Yuffie Kisaragi.','2022/6/17','Released','https://store.steampowered.com/app/1462040/FINAL_FANTASY_VII_REMAKE_INTERGRADE/?snr=1_7_7_230_150_2'),(93,'grand_theft_auto_v_enhanced',NULL,'Experience entertainment blockbusters Grand Theft Auto V and Grand Theft Auto Online — now upgraded for a new generation with stunning visuals, faster loading, 3D audio, and more, plus exclusive content for GTA Online players.','2025/3/4','Released','https://store.steampowered.com/app/3240220/Grand_Theft_Auto_V_Enhanced/?snr=1_7_7_230_150_2'),(94,'powerwash_simulator',NULL,'Release the Pressure with PowerWash Simulator! Wash away your worries with the soothing sounds of high-pressure water. Fire up your power washer and blast away every speck of dirt and grime you can find, all with the simple satisfaction of power-washing to a sparkling finish.','2022/7/14','Released','https://store.steampowered.com/app/1290000/PowerWash_Simulator/?snr=1_7_7_230_150_2'),(95,'borderlands_3',NULL,'The original shooter-looter returns, packing bazillions of guns and a mayhem-fueled adventure! Blast through new worlds and enemies as one of four new Vault Hunters.','2020/3/13','Released','https://store.steampowered.com/app/397540/Borderlands_3/?snr=1_7_7_230_150_2'),(96,'tom_clancy’s_the_division®_2',NULL,'Join an elite group of civilian agents in this action-packed RPG shooter. Engage in intense tactical combat, team-up with your friends, and survive in a dynamic open world to save Washington, D.C.','2023/1/12','Released','https://store.steampowered.com/app/2221490/Tom_Clancys_The_Division_2/?snr=1_7_7_230_150_2'),(97,'black_desert',NULL,'Played by over 20 million Adventurers - Black Desert Online is an open-world, action MMORPG. Experience intense, action-packed combat, battle massive world bosses, fight alongside friends to siege and conquer castles, and train in professions such as fishing, trading, crafting, cooking, and more!','2017/5/24','Released','https://store.steampowered.com/app/582660/Black_Desert/?snr=1_7_7_230_150_2'),(98,'the_elder_scrolls_v:_skyrim_special_edition',NULL,'Winner of more than 200 Game of the Year Awards, The Elder Scrolls V: Skyrim Special Edition brings the epic fantasy to life in stunning detail. The Special Edition includes the critically acclaimed game and add-ons with all-new features.','2016/10/27','Released','https://store.steampowered.com/app/489830/The_Elder_Scrolls_V_Skyrim_Special_Edition/?snr=1_7_7_230_150_3'),(99,'dayz',NULL,'How long can you survive a post-apocalyptic world? A land overrun with an infected \"zombie\" population, where you compete with other survivors for limited resources. Will you team up with strangers and stay strong together? Or play as a lone wolf to avoid betrayal? This is DayZ – this is your story.','2018/12/13','Released','https://store.steampowered.com/app/221100/DayZ/?snr=1_7_7_230_150_3'),(100,'team_fortress_2',NULL,'Nine distinct classes provide a broad range of tactical abilities and personalities. Constantly updated with new game modes, maps, equipment and, most importantly, hats!','2007/10/10','Released','https://store.steampowered.com/app/440/Team_Fortress_2/?snr=1_7_7_230_150_3'),(101,'ark:_lost_colony_expansion_pass',NULL,'This content requires the base game ARK: Survival Ascended on Steam in order to play.','2025/6/18','Released','https://store.steampowered.com/app/3720100/ARK_Lost_Colony_Expansion_Pass/?snr=1_7_7_230_150_3'),(102,'god_of_war_ragnarök',NULL,'Kratos and Atreus embark on a mythic journey for answers before Ragnarök arrives – now on PC.','2024/9/19','Released','https://store.steampowered.com/app/2322010/God_of_War_Ragnark/?snr=1_7_7_230_150_3'),(103,'two_point_museum',NULL,'Curate and manage incredible museums! Explore to discover amazing artifacts. Design and refine the layout, keep staff happy, guests entertained, donations plentiful… and children off the exhibits','2025/3/4','Released','https://store.steampowered.com/app/2185060/Two_Point_Museum/?snr=1_7_7_230_150_3'),(104,'planet_coaster_2',NULL,'Build and customise thrilling roller coasters and incredible water slides, manage the ultimate theme park experience, and share your epic creations. Are you ready to ride the wave? ','2024/11/6','Released','https://store.steampowered.com/app/2688950/Planet_Coaster_2/?snr=1_7_7_230_150_3'),(105,'call_of_duty®:_black_ops_6',NULL,'Call of Duty®: Black Ops 6 is signature Black Ops across a cinematic single-player Campaign, a best-in-class Multiplayer experience and with the epic return of Round-Based Zombies.','2024/10/24','Released','https://store.steampowered.com/app/2933620/Call_of_Duty_Black_Ops_6/?snr=1_7_7_230_150_3'),(106,'project_zomboid',NULL,'Project Zomboid is the ultimate in zombie survival. Alone or in MP: you loot, build, craft, fight, farm and fish in a struggle to survive. A hardcore RPG skillset, a vast map, massively customisable sandbox and a cute tutorial raccoon await the unwary. So how will you die? All it takes is a bite..','2013/11/8','Released','https://store.steampowered.com/app/108600/Project_Zomboid/?snr=1_7_7_230_150_3'),(107,'no_man\'s_sky',NULL,'No Man\'s Sky is a game about exploration and survival in an infinite procedurally generated universe.','2016/8/12','Released','https://store.steampowered.com/app/275850/No_Mans_Sky/?snr=1_7_7_230_150_3'),(108,'little_nightmares_ii',NULL,'Little Nightmares II is the second game in a series that has thrilled and captivated millions of players worldwide since 2017. Now it’s your turn to try to survive this critically acclaimed entry in the most charming horror series ever made.','2021/2/10','Released','https://store.steampowered.com/app/860510/Little_Nightmares_II/?snr=1_7_7_230_150_3'),(109,'monster_hunter_wilds',NULL,'The unbridled force of nature runs wild and relentless, with environments transforming drastically from one moment to the next. This is a story of monsters and humans and their struggles to live in harmony in a world of duality.','2025/2/27','Released','https://store.steampowered.com/app/2246340/Monster_Hunter_Wilds/?snr=1_7_7_230_150_3'),(110,'kerbal_space_program',NULL,'In Kerbal Space Program, take charge of the space program for the alien race known as the Kerbals. You have access to an array of parts to assemble fully-functional spacecraft that flies (or doesn’t) based on realistic aerodynamic and orbital physics.','2015/4/27','Released','https://store.steampowered.com/app/220200/Kerbal_Space_Program/?snr=1_7_7_230_150_3'),(111,'fantasy_life_i:_the_girl_who_steals_time',NULL,'Step into this Slow-Life RPG where you can freely switch between 14 unique jobs, so called \"Lives,\" and enjoy a carefree life in a fantasy world. Fish, cook, shape the island to your liking, or team up with friends to battle monsters across the vast world.','2025/5/21','Released','https://store.steampowered.com/app/2993780/FANTASY_LIFE_i_The_Girl_Who_Steals_Time/?snr=1_7_7_230_150_3'),(112,'final_fantasy_xiv_online',NULL,'Join over 30 million adventurers worldwide and take part in an epic and ever-changing FINAL FANTASY. Experience an unforgettable story, exhilarating battles, and a myriad of captivating environments to explore.','2014/2/18','Released','https://store.steampowered.com/app/39210/FINAL_FANTASY_XIV_Online/?snr=1_7_7_230_150_3'),(113,'the_binding_of_isaac:_rebirth',NULL,'The Binding of Isaac: Rebirth is a randomly generated action RPG shooter with heavy Rogue-like elements. Following Isaac on his journey players will find bizarre treasures that change Isaac’s form giving him super human abilities and enabling him to fight off droves of mysterious creatures, discover secrets and fight his way to safety.','2014/11/4','Released','https://store.steampowered.com/app/250900/The_Binding_of_Isaac_Rebirth/?snr=1_7_7_230_150_3'),(114,'lies_of_p:_overture',NULL,'This content requires the base game Lies of P on Steam in order to play.','2025/6/6','Released','https://store.steampowered.com/app/2848330/Lies_of_P_Overture/?snr=1_7_7_230_150_3'),(115,'persona_3_reload',NULL,'Dive into the Dark Hour and awaken the depths of your heart. Persona 3 Reload is a captivating reimagining of the genre-defining RPG, reborn for the modern era with cutting-edge graphics and gameplay.','2024/2/1','Released','https://store.steampowered.com/app/2161700/Persona_3_Reload/?snr=1_7_7_230_150_3'),(116,'house_flipper',NULL,'House Flipper is a unique chance to become a one-man renovation crew. Buy, repair and remodel devastated houses. Give them a second life and sell them at a profit!','2018/5/17','Released','https://store.steampowered.com/app/613100/House_Flipper/?snr=1_7_7_230_150_3'),(117,'silent_hill_2',NULL,'Investigating a letter from his late wife, James returns to where they made so many memories - Silent Hill. What he finds is a ghost town, prowled by disturbing monsters and cloaked in deep fog. Confront the monsters, solve puzzles, and search for traces of your wife in this remake of SILENT HILL 2.','2024/10/7','Released','https://store.steampowered.com/app/2124490/SILENT_HILL_2/?snr=1_7_7_230_150_3'),(118,'it_takes_two_friend\'s_pass',NULL,'Download Friend\'s Pass* and play It Takes Two with a friend for free. Just grab a friend who owns the full game, download Friend\'s Pass for free, and play together!','2021/5/25','Released','https://store.steampowered.com/app/2995920/It_Takes_Two_Friends_Pass/?snr=1_7_7_230_150_3'),(119,'balatro',NULL,'The poker roguelike. Balatro is a hypnotically satisfying deckbuilder where you play illegal poker hands, discover game-changing jokers, and trigger adrenaline-pumping, outrageous combos.','2024/2/20','Released','https://store.steampowered.com/app/2379780/Balatro/?snr=1_7_7_230_150_3'),(120,'grounded',NULL,'The world is a vast, beautiful and dangerous place – especially when you have been shrunk to the size of an ant. Can you thrive alongside the hordes of giant insects, fighting to survive the perils of the backyard?','2022/9/27','Released','https://store.steampowered.com/app/962130/Grounded/?snr=1_7_7_230_150_3'),(121,'raft',NULL,'Raft™ throws you and your friends into an epic oceanic adventure! Alone or together, players battle to survive a perilous voyage across a vast sea! Gather debris, scavenge reefs and build your own floating home, but be wary of the man-eating sharks!','2022/6/20','Released','https://store.steampowered.com/app/648800/Raft/?snr=1_7_7_230_150_3'),(122,'the_outlast_trials',NULL,'Red Barrels invites you to experience mind-numbing terror, this time with friends. Whether you go through the trials alone or in teams, if you survive long enough and complete the therapy, Murkoff will happily let you leave… but will you be the same?','2024/3/5','Released','https://store.steampowered.com/app/1304930/The_Outlast_Trials/?snr=1_7_7_230_150_3'),(123,'enshrouded',NULL,'You are Flameborn, last ember of hope of a dying race. Awaken, survive the terror of a corrupting fog, and reclaim the lost beauty of your kingdom. Venture into a vast world, vanquish punishing bosses, build grand halls and forge your path in this co-op survival action RPG for up to 16 players.','2024/1/24','Released','https://store.steampowered.com/app/1203620/Enshrouded/?snr=1_7_7_230_150_3'),(124,'horizon_forbidden_west™_complete_edition',NULL,'Experience the epic Horizon Forbidden West™ in its entirety with bonus content and the Burning Shores expansion included. The Burning Shores add-on contains additional content for Aloy’s adventure, including new storylines, characters, and experiences in a stunning yet hazardous new area.','2024/3/21','Released','https://store.steampowered.com/app/2420110/Horizon_Forbidden_West_Complete_Edition/?snr=1_7_7_230_150_3'),(125,'throne_and_liberty',NULL,'Welcome to THRONE AND LIBERTY, a free-to-play, multi-platform MMORPG. With an always changing environment, Massive Scale PvPvE, and the ability to transform into creatures to battle across land, sea, and air.','2024/10/1','Released','https://store.steampowered.com/app/2429640/THRONE_AND_LIBERTY/?snr=1_7_7_230_150_3'),(126,'disney_dreamlight_valley',NULL,'Explore a world filled with the magic of Disney as you discover rich stories and build the perfect neighborhood alongside Disney and Pixar heroes and villains in this new life-sim adventure game. Welcome to Disney Dreamlight Valley.','2023/12/5','Released','https://store.steampowered.com/app/1401590/Disney_Dreamlight_Valley/?snr=1_7_7_230_150_3'),(127,'it_takes_two',NULL,'Embark on the craziest journey of your life in It Takes Two. Invite a friend to join for free with Friend’s Pass and work together across a huge variety of gleefully disruptive gameplay challenges. Winner of GAME OF THE YEAR at the Game Awards 2021.','2021/3/25','Released','https://store.steampowered.com/app/1426210/It_Takes_Two/?snr=1_7_7_230_150_3'),(128,'age_of_wonders_4',NULL,'Rule a fantasy realm of your own design! Explore new magical realms in Age of Wonders’ signature blend of 4X strategy and turn-based tactical combat. Control a faction that grows and changes as you expand your empire with each turn!','2023/5/2','Released','https://store.steampowered.com/app/1669000/Age_of_Wonders_4/?snr=1_7_7_230_150_3'),(129,'risk_of_rain_2',NULL,'Escape a chaotic alien planet by fighting through hordes of frenzied monsters – with your friends, or on your own. Combine loot in surprising ways and master each character until you become the havoc you feared upon your first crash landing.','2020/8/11','Released','https://store.steampowered.com/app/632360/Risk_of_Rain_2/?snr=1_7_7_230_150_3'),(130,'five_nights_at_freddy\'s:_secret_of_the_mimic',NULL,'Enter the abandoned workshop of Murray’s Costume Manor and unravel the mystery left behind by the reclusive inventor. In Five Nights at Freddy’s: Secret of the Mimic, you’ll step into a world where every dark corner holds a secret and every flicker of light hints at an ever-present threat.','2025/6/13','Released','https://store.steampowered.com/app/2215390/Five_Nights_at_Freddys_Secret_of_the_Mimic/?snr=1_7_7_230_150_3'),(131,'automobilista_2',NULL,'Automobilista 2 is all the racing simulators you ever wanted - in just one. An incredibly diverse collection of cars and tracks cohesively simulated, featuring incredible graphics and audio quality, dynamic weather and track conditions and the best VR support for a racing experience like no other.','2020/3/31','Released','https://store.steampowered.com/app/1066890/Automobilista_2/?snr=1_7_7_230_150_3'),(132,'hollow_knight',NULL,'Forge your own path in Hollow Knight! An epic action adventure through a vast ruined kingdom of insects and heroes. Explore twisting caverns, battle tainted creatures and befriend bizarre bugs, all in a classic, hand-drawn 2D style.','2017/2/24','Released','https://store.steampowered.com/app/367520/Hollow_Knight/?snr=1_7_7_230_150_3'),(133,'cities:_skylines',NULL,'Cities: Skylines is a modern take on the classic city simulation. The game introduces new game play elements to realize the thrill and hardships of creating and maintaining a real city whilst expanding on some well-established tropes of the city building experience.','2015/3/10','Released','https://store.steampowered.com/app/255710/Cities_Skylines/?snr=1_7_7_230_150_3'),(134,'marvel’s_spider-man_remastered',NULL,'In Marvel’s Spider-Man Remastered, the worlds of Peter Parker and Spider-Man collide in an original action-packed story. Play as an experienced Peter Parker, fighting big crime and iconic villains in Marvel’s New York. Web-swing through vibrant neighborhoods and defeat villains with epic takedowns.','2022/8/12','Released','https://store.steampowered.com/app/1817070/Marvels_SpiderMan_Remastered/?snr=1_7_7_230_150_3'),(135,'v_rising',NULL,'Awaken as a Vampire. Hunt for blood in nearby settlements to regain your strength and evade the scorching sun to survive. Raise your castle and thrive in an ever-changing, open world full of mystery. Gain allies online and conquer the land of the living.','2024/5/8','Released','https://store.steampowered.com/app/1604030/V_Rising/?snr=1_7_7_230_150_3'),(136,'factorio',NULL,'Factorio is a game about building and creating automated factories to produce items of increasing complexity, within an infinite 2D world. Use your imagination to design your factory, combine simple elements into ingenious structures, and finally protect it from the creatures who don\'t really like you.','2020/8/14','Released','https://store.steampowered.com/app/427520/Factorio/?snr=1_7_7_230_150_3'),(137,'s.t.a.l.k.e.r._2:_heart_of_chornobyl',NULL,'Discover the vast Chornobyl Exclusion Zone full of dangerous enemies, deadly anomalies and powerful artifacts. Unveil your own epic story as you make your way to the Heart of Chornobyl. Make your choices wisely, as they will determine your fate in the end.','2024/11/20','Released','https://store.steampowered.com/app/1643320/STALKER_2_Heart_of_Chornobyl/?snr=1_7_7_230_150_3'),(138,'7_days_to_die',NULL,'7 Days to Die is an open-world game that is a unique combination of first-person shooter, survival horror, tower defense, and role-playing games. Play the definitive zombie survival sandbox RPG that came first. Navezgane awaits!','2024/7/25','Released','https://store.steampowered.com/app/251570/7_Days_to_Die/?snr=1_7_7_230_150_3'),(139,'microsoft_flight_simulator_2024',NULL,'Explore the world with our largest fleet of aircraft and take simulation to new heights while pursuing your aviation career within Microsoft Flight Simulator 2024.','2024/11/19','Released','https://store.steampowered.com/app/2537590/Microsoft_Flight_Simulator_2024/?snr=1_7_7_230_150_3'),(140,'magic:_the_gathering_arena',NULL,'Magic: The Gathering Arena empowers you to discover your strategy, meet the planeswalkers, explore the multiverse, and battle friends around the world. Start playing for free, challenge your friends, unlock cards, and feel the magic of the original fantasy CCG!','2023/5/23','Released','https://store.steampowered.com/app/2141910/Magic_The_Gathering_Arena/?snr=1_7_7_230_150_3'),(141,'roadcraft',NULL,'As the leader of a company specialized in restoring sites devastated by natural disasters, use your construction machinery to restart the local industry. Clear debris and faulty equipment, rebuild roads and bridges damaged by weather, and much more!','2025/5/20','Released','https://store.steampowered.com/app/2104890/RoadCraft/?snr=1_7_7_230_150_3'),(142,'final_fantasy_vii_rebirth',NULL,'The Unknown Journey Continues... After escaping the city of Midgar, Cloud and his friends set out on a journey across the planet. New adventures await in a vibrant, expansive world in this standalone entry of the FFVII remake trilogy.','2025/1/23','Released','https://store.steampowered.com/app/2909400/FINAL_FANTASY_VII_REBIRTH/?snr=1_7_7_230_150_3'),(143,'warhammer_40,000:_darktide_-_arbites_class_deluxe_edition',NULL,'This content requires the base game Warhammer 40,000: Darktide on Steam in order to play.','2025/6/23','Released','https://store.steampowered.com/app/3710950/Warhammer_40000_Darktide__Arbites_Class_Deluxe_Edition/?snr=1_7_7_230_150_3'),(144,'the_precinct',NULL,'Averno City, 1983. Gangs rule the streets and your father lies restless in his grave. Clean up the city, uncover the truth, and embark on thrilling vehicle chases through destructible environments in this neon-noir action sandbox police game.','2025/5/13','Released','https://store.steampowered.com/app/490110/The_Precinct/?snr=1_7_7_230_150_3'),(145,'hades',NULL,'Defy the god of the dead as you hack and slash out of the Underworld in this rogue-like dungeon crawler from the creators of Bastion, Transistor, and Pyre.','2020/9/17','Released','https://store.steampowered.com/app/1145360/Hades/?snr=1_7_7_230_150_3'),(146,'subnautica',NULL,'Descend into the depths of an alien underwater world filled with wonder and peril. Craft equipment, pilot submarines and out-smart wildlife to explore lush coral reefs, volcanoes, cave systems, and more - all while trying to survive.','2018/1/23','Released','https://store.steampowered.com/app/264710/Subnautica/?snr=1_7_7_230_150_3'),(147,'hello_kitty_island_adventure',NULL,'Embark on a cozy, open-world adventure with Hello Kitty and Friends. Befriend beloved characters as you explore and restore a mysterious island, solve ancient puzzles, cook delicious dishes, customize yourself and your cabins, and so much more.','2025/1/30','Released','https://store.steampowered.com/app/2495100/Hello_Kitty_Island_Adventure/?snr=1_7_7_230_150_3'),(148,'thehunter:_call_of_the_wild™',NULL,'Discover an atmospheric hunting game like no other in this realistic, stunning open world – regularly updated in collaboration with the community. Immerse yourself in the single player campaign, or share the ultimate hunting experience with friends.','2017/2/16','Released','https://store.steampowered.com/app/518790/theHunter_Call_of_the_Wild/?snr=1_7_7_230_150_4'),(149,'once_human',NULL,'Once Human is a multiplayer open-world survival game set in a strange, post-apocalyptic future. Unite with friends to fight monstrous enemies, uncover secret plots, compete for resources, and build your own territory. Once, you were merely human. Now, you have the power to remake the world.','2024/7/9','Released','https://store.steampowered.com/app/2139460/Once_Human/?snr=1_7_7_230_150_4'),(150,'god_of_war',NULL,'His vengeance against the Gods of Olympus years behind him, Kratos now lives as a man in the realm of Norse Gods and monsters. It is in this harsh, unforgiving world that he must fight to survive… and teach his son to do the same.','2022/1/14','Released','https://store.steampowered.com/app/1593500/God_of_War/?snr=1_7_7_230_150_4'),(151,'microsoft_flight_simulator_(2020)_40th_anniversary_edition',NULL,'From gliders and helicopters to wide-body jets, fly highly detailed and accurate aircraft in the Microsoft Flight Simulator 40th Anniversary Edition. The world is at your fingertips.','2020/8/17','Released','https://store.steampowered.com/app/1250410/Microsoft_Flight_Simulator_2020_40th_Anniversary_Edition/?snr=1_7_7_230_150_4'),(152,'arma_3',NULL,'Experience true combat gameplay in a massive military sandbox. Deploying a wide variety of single- and multiplayer content, over 20 vehicles and 40 weapons, and limitless opportunities for content creation, this is the PC’s premier military game. Authentic, diverse, open - Arma 3 sends you to war.','2013/9/12','Released','https://store.steampowered.com/app/107410/Arma_3/?snr=1_7_7_230_150_4'),(153,'hades_ii',NULL,'Battle beyond the Underworld using dark sorcery to take on the Titan of Time in this bewitching sequel to the award-winning rogue-like dungeon crawler.','2024/5/6','Released','https://store.steampowered.com/app/1145350/Hades_II/?snr=1_7_7_230_150_4'),(154,'persona_5_royal',NULL,'Don the mask and join the Phantom Thieves of Hearts as they stage grand heists, infiltrate the minds of the corrupt, and make them change their ways!','2022/10/20','Released','https://store.steampowered.com/app/1687950/Persona_5_Royal/?snr=1_7_7_230_150_4'),(155,'dave_the_diver',NULL,'DAVE THE DIVER is a casual, singleplayer adventure RPG featuring deep-sea exploration and fishing during the day and sushi restaurant management at night. Join Dave and his quirky friends as they seek to uncover the secrets of the mysterious Blue Hole.','2023/6/28','Released','https://store.steampowered.com/app/1868140/DAVE_THE_DIVER/?snr=1_7_7_230_150_4'),(156,'dredge',NULL,'DREDGE is a single-player fishing adventure with a sinister undercurrent. Sell your catch, upgrade your boat, and dredge the depths for long-buried secrets. Explore a mysterious archipelago and discover why some things are best left forgotten.','2023/3/30','Released','https://store.steampowered.com/app/1562430/DREDGE/?snr=1_7_7_230_150_4'),(157,'outer_wilds',NULL,'Named Game of the Year 2019 by Giant Bomb, Polygon, Eurogamer, and The Guardian, Outer Wilds is a critically-acclaimed and award-winning open world mystery about a solar system trapped in an endless time loop.','2020/6/18','Released','https://store.steampowered.com/app/753640/Outer_Wilds/?snr=1_7_7_230_150_4'),(158,'path_of_exile',NULL,'You are an Exile, struggling to survive on the dark continent of Wraeclast, as you fight to earn power that will allow you to exact your revenge against those who wronged you. Path of Exile is an online Action RPG set in a dark fantasy world. The game is completely free and will never be pay-to-win.','2013/10/23','Released','https://store.steampowered.com/app/238960/Path_of_Exile/?snr=1_7_7_230_150_4'),(159,'lost_ark',NULL,'Embark on an odyssey for the Lost Ark in a vast, vibrant world: explore new lands, seek out lost treasures, and test yourself in thrilling action combat in this action-packed free-to-play RPG.','2022/2/11','Released','https://store.steampowered.com/app/1599340/Lost_Ark/?snr=1_7_7_230_150_4'),(160,'diablo®_iv',NULL,'Join the fight for Sanctuary in Diablo® IV, the ultimate action RPG adventure. Experience the critically acclaimed campaign and new seasonal content.','2023/10/17','Released','https://store.steampowered.com/app/2344520/Diablo_IV/?snr=1_7_7_230_150_4'),(161,'borderlands_4',NULL,'Borderlands 4 is a mayhem-fueled looter shooter, jam-packed with billions of weapons, deadly enemies, and intense co-op action. Break free from a dangerous hidden planet as one of four new badass Vault Hunters.','2025/9/12','Unreleased','https://store.steampowered.com/app/1285190/Borderlands_4/?snr=1_7_7_230_150_4'),(162,'len\'s_island',NULL,'An open-world survival crafting game for 1–8 players, blending intense dungeon crawling and ARPG combat with peaceful farming and creative building. Take on quests and explore a vast, procedurally-generated world full of danger and discovery.','2025/6/19','Released','https://store.steampowered.com/app/1335830/Lens_Island/?snr=1_7_7_230_150_4'),(163,'the_alters',NULL,'Explore an emotional sci-fi game with a unique blend of survival, adventure, and base-building elements. Help Jan Dolski, the sole survivor of an ill-fated space expedition, create alternative versions of himself to escape a hostile planet and tackle personal turmoils with this unconventional crew.','2025/6/13','Released','https://store.steampowered.com/app/1601570/The_Alters/?snr=1_7_7_230_150_4'),(164,'le_mans_ultimate',NULL,'Le Mans is a continually evolving story... powered by emotion, speed and glory. Le Mans Ultimate - the official game of the FIA World Endurance Championship and 24 Hours of Le Mans.','2024/2/20','Released','https://store.steampowered.com/app/2399420/Le_Mans_Ultimate/?snr=1_7_7_230_150_4'),(165,'halo:_the_master_chief_collection',NULL,'The Master Chief’s iconic journey includes six games, built for PC and collected in a single integrated experience. Whether you’re a long-time fan or meeting Spartan 117 for the first time, The Master Chief Collection is the definitive Halo gaming experience.','2019/12/3','Released','https://store.steampowered.com/app/976730/Halo_The_Master_Chief_Collection/?snr=1_7_7_230_150_4'),(166,'terraria',NULL,'Dig, fight, explore, build! Nothing is impossible in this action-packed adventure game. Four Pack also available!','2011/5/16','Released','https://store.steampowered.com/app/105600/Terraria/?snr=1_7_7_230_150_4'),(167,'the_planet_crafter',NULL,'A space survival open world terraforming crafting game, designed for 1 to 10 players. Alter the ecosystem of an inhospitable planet to render it habitable for humanity. Survive, gather resources, and build your base. Then, generate oxygen, warmth, and pressure to create a brand new biosphere.','2024/4/10','Released','https://store.steampowered.com/app/1284190/The_Planet_Crafter/?snr=1_7_7_230_150_4'),(168,'9_kings',NULL,'A fast-paced roguelike kingdom builder. Grow your empire and fight massive battles against powerful rival kings. Break the game with thousands of insane builds to become the King of Kings.','2025/5/23','Released','https://store.steampowered.com/app/2784470/9_Kings/?snr=1_7_7_230_150_4'),(169,'tempest_rising',NULL,'Command distinct factions in a desperate struggle for power and resources in Tempest Rising - a classic RTS set on Earth after a nuclear war.','2025/4/24','Released','https://store.steampowered.com/app/1486920/Tempest_Rising/?snr=1_7_7_230_150_4'),(170,'doom_eternal',NULL,'Hell’s armies have invaded Earth. Become the Slayer in an epic single-player campaign to conquer demons across dimensions and stop the final destruction of humanity. The only thing they fear... is you.','2020/3/19','Released','https://store.steampowered.com/app/782330/DOOM_Eternal/?snr=1_7_7_230_150_4'),(171,'disco_elysium_-_the_final_cut',NULL,'Disco Elysium - The Final Cut is a groundbreaking role playing game. You’re a detective with a unique skill system at your disposal and a whole city to carve your path across. Interrogate unforgettable characters, crack murders or take bribes. Become a hero or an absolute disaster of a human being.','2019/10/15','Released','https://store.steampowered.com/app/632470/Disco_Elysium__The_Final_Cut/?snr=1_7_7_230_150_4'),(172,'hunt:_showdown_1896',NULL,'Hunt: Showdown 1896 is a new era of the addictively unforgiving extraction shooter. In corrupted backwaters lost to history, fight back alone – or with friends – against timeless evil. Twisted monsters and other ruthless Hunters stand between you and your Bounty. Risk everything as Hunt consumes you','2019/8/27','Released','https://store.steampowered.com/app/594650/Hunt_Showdown_1896/?snr=1_7_7_230_150_4'),(173,'cast_n_chill',NULL,'Cast n Chill is a cozy idle (and active) fishing game where you explore serene lakes, rivers, and oceans. Catch rare fish, upgrade your gear and reel in legendary catches - all with your loyal companion by your side.','2025/6/16','Released','https://store.steampowered.com/app/3483740/Cast_n_Chill/?snr=1_7_7_230_150_4'),(174,'detroit:_become_human',NULL,'Detroit: Become Human puts the destiny of both mankind and androids in your hands, taking you to a near future where machines have become more intelligent than humans. Every choice you make affects the outcome of the game, with one of the most intricately branching narratives ever created.','2020/6/18','Released','https://store.steampowered.com/app/1222140/Detroit_Become_Human/?snr=1_7_7_230_150_4'),(175,'dead_space',NULL,'The sci-fi survival-horror classic returns, completely rebuilt to offer an even more immersive experience — including visual, audio, and gameplay improvements — while staying faithful to the original game’s thrilling vision.','2023/1/27','Released','https://store.steampowered.com/app/1693980/Dead_Space/?snr=1_7_7_230_150_4'),(176,'the_finals',NULL,'Join THE FINALS, the world-famous, free-to-play, combat-centered game show! Fight alongside your teammates in virtual arenas that you can alter, exploit, and even destroy. Build your own playstyle in this first-person shooter to win escalating tournaments and lasting fame.','2023/12/7','Released','https://store.steampowered.com/app/2073850/THE_FINALS/?snr=1_7_7_230_150_4'),(177,'warhammer_40,000:_darktide_-_arbites_class',NULL,'This content requires the base game Warhammer 40,000: Darktide on Steam in order to play.','2025/6/23','Released','https://store.steampowered.com/app/3710910/Warhammer_40000_Darktide__Arbites_Class/?snr=1_7_7_230_150_4'),(178,'surroundead',NULL,'SurrounDead is an open world survival game. Taking place in a world ravaged by an apocalyptic catastrophe. The dead reign free and will stop at nothing to kill you.','2022/6/24','Released','https://store.steampowered.com/app/1645820/SurrounDead/?snr=1_7_7_230_150_4'),(179,'riders_republic',NULL,'Jump into a massive multiplayer playground! Bike, ski, snowboard, or wingsuit across an open world sports paradise.','2023/6/8','Released','https://store.steampowered.com/app/2290180/Riders_Republic/?snr=1_7_7_230_150_4'),(180,'resident_evil_7_biohazard',NULL,'Fear and isolation seep through the walls of an abandoned southern farmhouse. \"7\" marks a new beginning for survival horror with the “Isolated View” of the visceral new first-person perspective.','2017/1/23','Released','https://store.steampowered.com/app/418370/Resident_Evil_7_Biohazard/?snr=1_7_7_230_150_4'),(181,'indiana_jones_and_the_great_circle',NULL,'Uncover one of history’s greatest mysteries in a first-person, single-player adventure. The year is 1937, sinister forces are scouring the globe for the secret to an ancient power connected to the Great Circle, and only one person can stop them - Indiana Jones™.','2024/12/8','Released','https://store.steampowered.com/app/2677660/Indiana_Jones_and_the_Great_Circle/?snr=1_7_7_230_150_4'),(182,'world_of_warships',NULL,'Immerse yourself in thrilling naval battles and assemble an armada of over 600 ships from the first half of the 20th century — from stealthy destroyers to gigantic battleships. Change the look of your ship, choose upgrades to suit your play style, and go into battle with other players!','2017/11/15','Released','https://store.steampowered.com/app/552990/World_of_Warships/?snr=1_7_7_230_150_4'),(183,'cities:_skylines_ii',NULL,'Raise a city from the ground up and transform it into a thriving metropolis with the most realistic city builder ever. Push your creativity and problem-solving to build on a scale you\'ve never experienced. With deep simulation and a living economy, this is world-building without limits.','2023/10/24','Released','https://store.steampowered.com/app/949230/Cities_Skylines_II/?snr=1_7_7_230_150_4'),(184,'yu-gi-oh!_master_duel',NULL,'Yu-Gi-Oh! MASTER DUEL is the ultimate free-to-play cross-platform strategy card game with fast-paced Duels, stunning HD graphics and a new, dynamic soundtrack! Get ready to challenge Duelists around the world!','2022/1/18','Released','https://store.steampowered.com/app/1449850/YuGiOh_Master_Duel/?snr=1_7_7_230_150_4'),(185,'manor_lords',NULL,'Manor Lords is a medieval strategy game featuring in-depth city building, large-scale tactical battles, and complex economic and social simulations. Rule your lands as a medieval lord – the seasons pass, the weather changes, and cities rise and fall.','2024/4/26','Released','https://store.steampowered.com/app/1363080/Manor_Lords/?snr=1_7_7_230_150_4'),(186,'total_war:_warhammer_ii',NULL,'Strategy gaming perfected. A breath-taking campaign of exploration, expansion and conquest across a fantasy world. Turn-based civilisation management and real-time epic strategy battles with thousands of troops and monsters at your command.','2017/9/28','Released','https://store.steampowered.com/app/594570/Total_War_WARHAMMER_II/?snr=1_7_7_230_150_4'),(187,'sid_meier\'s_civilization_vii',NULL,'The award-winning strategy game franchise returns with a revolutionary new chapter. Sid Meier\'s Civilization® VII empowers you to build the greatest empire the world has ever known!','2025/2/10','Released','https://store.steampowered.com/app/1295660/Sid_Meiers_Civilization_VII/?snr=1_7_7_230_150_4'),(188,'monster_train_2',NULL,'Monster Train returns with all new clans, new enemy factions, new challenges, new modes and more! Defend your Pyre in the classic three-tiered, vertical gameplay that made the original roguelike deckbuilder a hit.','2025/5/21','Released','https://store.steampowered.com/app/2742830/Monster_Train_2/?snr=1_7_7_230_150_4'),(189,'the_last_of_us™_part_ii_remastered',NULL,'Experience the winner of over 300 Game of the Year awards, now on PC. Discover Ellie and Abby’s story with graphical enhancements, gameplay modes like the roguelike survival experience No Return, and more.','2025/4/3','Released','https://store.steampowered.com/app/2531310/The_Last_of_Us_Part_II_Remastered/?snr=1_7_7_230_150_4'),(190,'starfield',NULL,'Starfield is the first new universe in 25 years from Bethesda Game Studios, the award-winning creators of The Elder Scrolls V: Skyrim and Fallout 4.','2023/9/5','Released','https://store.steampowered.com/app/1716740/Starfield/?snr=1_7_7_230_150_4'),(191,'dying_light_2_stay_human:_reloaded_edition',NULL,'Humanity is fighting a losing battle against the virus. Experience a post-apocalyptic open world overrun by hordes of zombies, where your parkour and combat skills are key to survival. Traverse the City freely during the day, but watch the monsters take over during the night.','2022/2/3','Released','https://store.steampowered.com/app/534380/Dying_Light_2_Stay_Human_Reloaded_Edition/?snr=1_7_7_230_150_4'),(192,'parcel_simulator',NULL,'Inspect and process parcels and packages in this parcel inspection simulator! Receive and sort deliveries, examine labels for mistakes, and automate to maximise warehouse efficiency. Upgrade and expand your warehouse to build your parcel empire!','2025/6/20','Released','https://store.steampowered.com/app/2424010/Parcel_Simulator/?snr=1_7_7_230_150_4'),(193,'metaphor:_refantazio',NULL,'After his assassination, the will of the late king decrees the next monarch to be elected by the people. Forge bonds and win over a kingdom divided in this award-winning fantasy RPG with turn-based and action combat, party customization with powerful Archetypes, and hours of exploration.','2024/10/10','Released','https://store.steampowered.com/app/2679460/Metaphor_ReFantazio/?snr=1_7_7_230_150_4'),(194,'ultrakill',NULL,'ULTRAKILL is a fast-paced ultraviolent retro FPS combining the skill-based style scoring from character action games with unadulterated carnage inspired by the best shooters of the \'90s. Rip apart your foes with varied destructive weapons and shower in their blood to regain your health.','2020/9/3','Released','https://store.steampowered.com/app/1229490/ULTRAKILL/?snr=1_7_7_230_150_4'),(195,'age_of_empires_ii:_definitive_edition',NULL,'42 Civilizations, 229 Campaign Missions, Singleplayer, Co-Op, Multiplayer, In-Game Editor, Mods, Cross-play...It is good to be the king.','2019/11/14','Released','https://store.steampowered.com/app/813780/Age_of_Empires_II_Definitive_Edition/?snr=1_7_7_230_150_4'),(196,'guild_wars_2',NULL,'Guild Wars 2 is an award-winning online roleplaying game with fast-paced action combat, deep character customization, and no subscription fee required. Choose from an arsenal of professions and weapons, explore a vast open world, compete in PVP modes and more. Join over 16 million players now!','2022/8/23','Released','https://store.steampowered.com/app/1284210/Guild_Wars_2/?snr=1_7_7_230_150_4'),(197,'marvel\'s_guardians_of_the_galaxy',NULL,'Fire up a wild ride across the cosmos with a fresh take on Marvel’s Guardians of the Galaxy. In this action-adventure game, you are Star-Lord leading the unpredictable Guardians from one explosion of chaos to the next. You got this. Probably.','2021/10/26','Released','https://store.steampowered.com/app/1088850/Marvels_Guardians_of_the_Galaxy/?snr=1_7_7_230_150_4'),(198,'overwatch®_2',NULL,'Overwatch 2 is a critically acclaimed, team-based shooter game set in an optimistic future with an evolving roster of heroes. Team up with friends and jump in today.','2023/8/10','Released','https://store.steampowered.com/app/2357570/Overwatch_2/?snr=1_7_7_230_150_5'),(199,'mount_&_blade_ii:_bannerlord',NULL,'A strategy/action RPG. Create a character, engage in diplomacy, craft, trade and conquer new lands in a vast medieval sandbox. Raise armies to lead into battle and command and fight alongside your troops in massive real-time battles using a deep but intuitive skill-based combat system.','2022/10/25','Released','https://store.steampowered.com/app/261550/Mount__Blade_II_Bannerlord/?snr=1_7_7_230_150_5'),(200,'doom:_the_dark_ages',NULL,'DOOM: The Dark Ages is the prequel to the critically acclaimed DOOM (2016) and DOOM Eternal that tells an epic cinematic story worthy of the DOOM Slayer’s legend. Players will step into the blood-stained boots of the DOOM Slayer, in this never-before-seen dark and sinister medieval war against Hell.','2025/5/14','Released','https://store.steampowered.com/app/3017860/DOOM_The_Dark_Ages/?snr=1_7_7_230_150_5'),(201,'deep_rock_galactic',NULL,'Deep Rock Galactic is a 1-4 player co-op FPS featuring badass space Dwarves, 100% destructible environments, procedurally-generated caves, and endless hordes of alien monsters.','2020/5/13','Released','https://store.steampowered.com/app/548430/Deep_Rock_Galactic/?snr=1_7_7_230_150_5'),(202,'cult_of_the_lamb',NULL,'Start your own cult in a land of false prophets, venturing out into diverse and mysterious regions to build a loyal community of woodland Followers and spread your Word to become the one true cult.','2022/8/11','Released','https://store.steampowered.com/app/1313140/Cult_of_the_Lamb/?snr=1_7_7_230_150_5'),(203,'deadzone:_rogue',NULL,'Deadzone: Rogue is a roguelite FPS set in space. Blast through hordes of enemies with devastating weapons. Define your combat style with powerful augments and upgrades. Grow stronger with each death, solo or in co-op. Fight. Die. Revive. Repeat.','2025/4/29','Released','https://store.steampowered.com/app/3228590/Deadzone_Rogue/?snr=1_7_7_230_150_5'),(204,'assetto_corsa',NULL,'Assetto Corsa v1.16 introduces the new \"Laguna Seca\" laser-scanned track, 7 new cars among which the eagerly awaited Alfa Romeo Giulia Quadrifoglio! Check the changelog for further info!','2014/12/19','Released','https://store.steampowered.com/app/244210/Assetto_Corsa/?snr=1_7_7_230_150_5'),(205,'star_wars_outlaws',NULL,'Experience the first-ever open world Star Wars™ game and explore distinct locations across the galaxy, both iconic and new. Risk it all as scoundrel Kay Vess, seeking freedom and the means to start a new life.','2024/11/21','Released','https://store.steampowered.com/app/2842040/Star_Wars_Outlaws/?snr=1_7_7_230_150_5'),(206,'inzoi',NULL,'\"Every life becomes a story\" Create your unique story by controlling and observing the lives of \'Zois\'. Customize characters and build houses using inZOI\'s easy-to-use tools to live the life of your dreams and experience the different emotions of life created by its deep and detailed simulation.','2025/3/27','Released','https://store.steampowered.com/app/2456740/inZOI/?snr=1_7_7_230_150_5'),(207,'fallout_4',NULL,'Bethesda Game Studios, the award-winning creators of Fallout 3 and The Elder Scrolls V: Skyrim, welcome you to the world of Fallout 4 – their most ambitious game ever, and the next generation of open-world gaming.','2015/11/9','Released','https://store.steampowered.com/app/377160/Fallout_4/?snr=1_7_7_230_150_5'),(208,'idleon_-_the_idle_rpg',NULL,'Create your own heroes who keep playing after you close the game! When you return, spend their loot on upgrades and powerful synergies — each BOSS you defeat unlocks new content, so you won\'t reach endgame without a fight!','2021/4/2','Released','https://store.steampowered.com/app/1476970/IdleOn__The_Idle_RPG/?snr=1_7_7_230_150_5'),(209,'sid_meier’s_civilization®_vi',NULL,'Expand your empire, advance your culture and go head-to-head against history’s greatest leaders. Will your civilization stand the test of time?','2016/10/20','Released','https://store.steampowered.com/app/289070/Sid_Meiers_Civilization_VI/?snr=1_7_7_230_150_5'),(210,'atomic_heart',NULL,'In a mad and sublime utopian world, take part in explosive encounters. Adapt your fighting style to each opponent, use your environment and upgrade your equipment to fulfill your mission. If you want to reach the truth, you\'ll have to pay in blood.','2023/2/20','Released','https://store.steampowered.com/app/668580/Atomic_Heart/?snr=1_7_7_230_150_5'),(211,'black_mesa',NULL,'Relive Half-Life.','2020/3/6','Released','https://store.steampowered.com/app/362890/Black_Mesa/?snr=1_7_7_230_150_5'),(212,'revenge_of_the_savage_planet',NULL,'Revenge of the Savage Planet is an upbeat, satirical action adventure Sci-Fi. Jump, shoot and collect your way across vibrant alien worlds, uncovering new gear and upgrades, while discovering various hidden secrets.','2025/5/8','Released','https://store.steampowered.com/app/2787320/Revenge_of_the_Savage_Planet/?snr=1_7_7_230_150_5'),(213,'age_of_empires_iv:_anniversary_edition',NULL,'Celebrating its first year of delighting millions of global players, the award-winning and best-selling strategy franchise continues with Age of Empires IV: Anniversary Edition, putting you at the center of even more epic historical battles that shaped the world.','2021/10/28','Released','https://store.steampowered.com/app/1466860/Age_of_Empires_IV_Anniversary_Edition/?snr=1_7_7_230_150_5'),(214,'tabletop_simulator',NULL,'Tabletop Simulator is the only simulator where you can let your aggression out by flipping the table! There are no rules to follow: just you, a physics sandbox, and your friends. Make your own online board games or play the thousands of community created mods. Unlimited gaming possibilities!','2015/6/5','Released','https://store.steampowered.com/app/286160/Tabletop_Simulator/?snr=1_7_7_230_150_5'),(215,'bloons_td_6',NULL,'The Bloons are back and better than ever! Get ready for a massive 3D tower defense game designed to give you hours and hours of the best strategy gaming available.','2018/12/17','Released','https://store.steampowered.com/app/960090/Bloons_TD_6/?snr=1_7_7_230_150_5'),(216,'anno_1800',NULL,'Anno 1800™ – Lead the Industrial Revolution! Welcome to the dawn of the Industrial Age. The path you choose will define your world. Are you an innovator or an exploiter? A conqueror or a liberator? How the world remembers your name is up to you.','2019/4/16','Released','https://store.steampowered.com/app/916440/Anno_1800/?snr=1_7_7_230_150_5'),(217,'cuphead',NULL,'Cuphead is a classic run and gun action game heavily focused on boss battles. Inspired by cartoons of the 1930s, the visuals and audio are painstakingly created with the same techniques of the era, i.e. traditional hand drawn cel animation, watercolor backgrounds, and original jazz recordings.','2017/9/29','Released','https://store.steampowered.com/app/268910/Cuphead/?snr=1_7_7_230_150_5'),(218,'half-life:_alyx',NULL,'Half-Life: Alyx is Valve’s VR return to the Half-Life series. It’s the story of an impossible fight against a vicious alien race known as the Combine, set between the events of Half-Life and Half-Life 2. Playing as Alyx Vance, you are humanity’s only chance for survival.','2020/3/23','Released','https://store.steampowered.com/app/546560/HalfLife_Alyx/?snr=1_7_7_230_150_5'),(219,'dcs_world_steam_edition',NULL,'Feel the excitement of flying the Su-25T \"Frogfoot\" attack jet and the TF-51D \"Mustang\" in the free-to-play Digital Combat Simulator World!','2018/3/18','Released','https://store.steampowered.com/app/223750/DCS_World_Steam_Edition/?snr=1_7_7_230_150_5'),(220,'street_fighter™_6',NULL,'Here comes Capcom’s newest challenger! Street Fighter™ 6 launches worldwide on June 2nd, 2023 and represents the next evolution of the Street Fighter™ series! Street Fighter 6 spans three distinct game modes, including World Tour, Fighting Ground and Battle Hub.','2023/6/1','Released','https://store.steampowered.com/app/1364780/Street_Fighter_6/?snr=1_7_7_230_150_5'),(221,'star_wars_jedi:_fallen_order™',NULL,'A galaxy-spanning adventure awaits in Star Wars Jedi: Fallen Order, a 3rd person action-adventure title from Respawn. An abandoned Padawan must complete his training, develop new powerful Force abilities, and master the art of the lightsaber - all while staying one step ahead of the Empire.','2019/11/14','Released','https://store.steampowered.com/app/1172380/STAR_WARS_Jedi_Fallen_Order/?snr=1_7_7_230_150_5'),(222,'assetto_corsa_competizione',NULL,'Assetto Corsa Competizione, the official GT World Challenge videogame. Thanks to the extraordinary quality of simulation, you will experience the atmosphere of the GT3 championship. Compete against official drivers, teams, cars and official circuits reproduced to the highest quality ever seen.','2019/5/29','Released','https://store.steampowered.com/app/805550/Assetto_Corsa_Competizione/?snr=1_7_7_230_150_5'),(223,'resident_evil_village',NULL,'Experience survival horror like never before in the 8th major installment in the Resident Evil franchise - Resident Evil Village. With detailed graphics, intense first-person action and masterful storytelling, the terror has never felt more realistic.','2021/5/6','Released','https://store.steampowered.com/app/1196590/Resident_Evil_Village/?snr=1_7_7_230_150_5'),(224,'efootball™',NULL,'The feverish football game with a worldwide total of 850 million downloads is waiting for you! Play eFootball™ with users around the world!','2021/9/29','Released','https://store.steampowered.com/app/1665460/eFootball/?snr=1_7_7_230_150_5'),(225,'palia',NULL,'Discover a welcoming world in Palia, a free-to-play fantasy life sim adventure where you can craft, explore, and create the life and home of your dreams. With nearly endless ways to make Palia your home, you’ll find relaxation and joy in every corner of this vibrant, heartwarming world.','2024/3/25','Released','https://store.steampowered.com/app/2707930/Palia/?snr=1_7_7_230_150_5'),(226,'train_simulator_classic_2024',NULL,'Celebrate 15 years of the ultimate railway hobby! Learn to operate officially licensed locomotives from historic steam to modern day electrics and explore realistic detailed routes from around the world. Train Simulator Classic 2024 is the simulation made by railfans for railfans.','2009/7/12','Released','https://store.steampowered.com/app/24010/Train_Simulator_Classic_2024/?snr=1_7_7_230_150_5'),(227,'nier:automata™',NULL,'NieR: Automata tells the story of androids 2B, 9S and A2 and their battle to reclaim the machine-driven dystopia overrun by powerful machines.','2017/3/17','Released','https://store.steampowered.com/app/524220/NieRAutomata/?snr=1_7_7_230_150_5'),(228,'dying_light',NULL,'First-person action survival game set in a post-apocalyptic open world overrun by flesh-hungry zombies. Roam a city devastated by a mysterious virus epidemic. Scavenge for supplies, craft weapons, and face hordes of the infected.','2015/1/26','Released','https://store.steampowered.com/app/239140/Dying_Light/?snr=1_7_7_230_150_5'),(229,'call_of_duty®:_black_ops_ii',NULL,'Pushing the boundaries of what fans have come to expect from the record-setting entertainment franchise, Call of Duty®: Black Ops II propels players into a near future Cold War','2012/11/12','Released','https://store.steampowered.com/app/202970/Call_of_Duty_Black_Ops_II/?snr=1_7_7_230_150_5'),(230,'limbus_company',NULL,'As the Executive Manager of Limbus Company, lead your group of twelve Sinners, venture into the buried facilities of Lobotomy Corporation, and lay claim on the Golden Boughs.','2023/2/26','Released','https://store.steampowered.com/app/1973530/Limbus_Company/?snr=1_7_7_230_150_5'),(231,'blasphemous',NULL,'Blasphemous is a brutal action-platformer with skilled hack’n slash combat set in the nightmare world of Cvstodia. Explore, upgrade your abilities, and perform savage executions on the hordes of enemies that stand between you and your quest to break eternal damnation.','2019/9/10','Released','https://store.steampowered.com/app/774361/Blasphemous/?snr=1_7_7_230_150_5'),(232,'atomfall',NULL,'A nuclear disaster has left an area of Britain in tatters. Atomfall, a new survival-action game, will see you explore, scavenge, craft, barter and fight your way through beautifully recreated scenery in search of answers.','2025/3/27','Released','https://store.steampowered.com/app/801800/Atomfall/?snr=1_7_7_230_150_5'),(233,'call_to_arms_-_gates_of_hell:_ostfront',NULL,'Call to Arms - Gates of Hell is a realistic RTS/ RTT game that offers endless replay value. Command all types of troops in historical singleplayer, dynamic campaign, PvP and PvE battles. Are you ready for some serious immersion in World War 2?','2021/6/11','Released','https://store.steampowered.com/app/400750/Call_to_Arms__Gates_of_Hell_Ostfront/?snr=1_7_7_230_150_5'),(234,'oxygen_not_included',NULL,'Oxygen Not Included is a space-colony simulation game. Deep inside an alien space rock your industrious crew will need to master science, overcome strange new lifeforms, and harness incredible space tech to survive, and possibly, thrive.','2019/7/30','Released','https://store.steampowered.com/app/457140/Oxygen_Not_Included/?snr=1_7_7_230_150_5'),(235,'sekiro™:_shadows_die_twice_-_goty_edition',NULL,'Game of the Year - The Game Awards 2019 Best Action Game of 2019 - IGN Carve your own clever path to vengeance in the award winning adventure from developer FromSoftware, creators of Bloodborne and the Dark Souls series. Take Revenge. Restore Your Honor. Kill Ingeniously.','2019/3/21','Released','https://store.steampowered.com/app/814380/Sekiro_Shadows_Die_Twice__GOTY_Edition/?snr=1_7_7_230_150_5'),(236,'final_fantasy_xvi',NULL,'An epic dark fantasy where fates are decided by mighty Eikons and the Dominants who wield them. This is the tale of Clive Rosfield, a tragic warrior who swears revenge on the Dark Eikon Ifrit, a mysterious entity that leaves naught but calamity in its wake.','2024/9/17','Released','https://store.steampowered.com/app/2515020/FINAL_FANTASY_XVI/?snr=1_7_7_230_150_5'),(237,'delta_force',NULL,'Delta Force is back! The iconic series returns as the definitive free-to-play modern team-based tactical shooter and featuring three distinct gameplay modes: large-scale PvP warfare, intense extraction shooter action, and a remake of the legendary Black Hawk Down campaign.','2024/12/4','Released','https://store.steampowered.com/app/2507950/Delta_Force/?snr=1_7_7_230_150_5'),(238,'lego®_star_wars™:_the_skywalker_saga',NULL,'Play through all nine Skywalker saga films in a game unlike any other. With over 300 playable characters, over 100 vehicles, and 23 planets to explore, a galaxy far, far away has never been more fun! *Includes classic Obi-Wan Kenobi playable character','2022/4/5','Released','https://store.steampowered.com/app/920210/LEGO_Star_Wars_The_Skywalker_Saga/?snr=1_7_7_230_150_5'),(239,'the_first_berserker:_khazan',NULL,'The First Berserker: Khazan is a hardcore action role-playing game. The player will become Khazan, the great general of the Pell Los Empire, who overcame death, and sets out to reveal the incidents that led to his downfall and seek vengeance on his enemies.','2025/3/27','Released','https://store.steampowered.com/app/2680010/The_First_Berserker_Khazan/?snr=1_7_7_230_150_5'),(240,'kindergarten_3',NULL,'Kindergarten 3 is the long awaited threequel to the Kindergarten series! Explore a new school with old and new friends...and new ways to get ruthlessly murdered.','2025/6/18','Released','https://store.steampowered.com/app/2695570/Kindergarten_3/?snr=1_7_7_230_150_5'),(241,'wartales',NULL,'Wartales is an open world RPG in which you lead a group of mercenaries in their search for wealth across a massive medieval universe. Explore the world, recruit companions, collect bounties and unravel the secrets of the tombs of the ancients!','2023/4/12','Released','https://store.steampowered.com/app/1527950/Wartales/?snr=1_7_7_230_150_5'),(242,'victoria_3:_charters_of_commerce',NULL,'This content requires the base game Victoria 3 on Steam in order to play.','2025/6/17','Released','https://store.steampowered.com/app/3450170/Victoria_3_Charters_of_Commerce/?snr=1_7_7_230_150_5'),(243,'squad',NULL,'Squad is a tactical FPS that provides authentic combat experiences through teamwork, communication, and realistic combat. It bridges the gap between arcade shooter and military realism with 100-player battles, combined-arms warfare, and base building.','2020/9/23','Released','https://store.steampowered.com/app/393380/Squad/?snr=1_7_7_230_150_5'),(244,'nine_sols',NULL,'Nine Sols is a lore rich, hand-drawn 2D action-platformer featuring Sekiro-inspired deflection focused combat. Embark on a journey of eastern fantasy, explore the land once home to an ancient alien race, and follow a vengeful hero’s quest to slay the 9 Sols, formidable rulers of this forsaken realm.','2024/5/28','Released','https://store.steampowered.com/app/1809540/Nine_Sols/?snr=1_7_7_230_150_5'),(245,'days_gone',NULL,'Ride and fight into a deadly, post pandemic America. Play as Deacon St. John, a drifter and bounty hunter who rides the broken road, fighting to survive while searching for a reason to live in this open-world action-adventure game.','2021/5/17','Released','https://store.steampowered.com/app/1259420/Days_Gone/?snr=1_7_7_230_150_5'),(246,'captain_of_industry',NULL,'Land your crew of survivors on an abandoned island and survive! Mine raw materials, grow food, build factories, manufacture products, research new tech, and trade with others. Become an industrial superpower! But this is no easy task, you will be put to the test to keep your settlement alive.','2022/5/31','Released','https://store.steampowered.com/app/1594320/Captain_of_Industry/?snr=1_7_7_230_150_5'),(247,'car_dealer_simulator',NULL,'Uncover a goldmine in the used car market! Sniff out deals, buy low, modify, and sell high. Your journey from amateur grease monkey to car dealer magnate awaits. How fast will you rise in this lucrative venture?','2025/5/29','Released','https://store.steampowered.com/app/2404880/Car_Dealer_Simulator/?snr=1_7_7_230_150_6'),(248,'total_war:_rome_ii_-_emperor_edition',NULL,'Emperor Edition is the definitive edition of ROME II, featuring an improved politics system, overhauled building chains, rebalanced battles and improved visuals in both campaign and battleEmperor Edition contains all free feature updates since its release in 2013, which includes bug fixes, balancing, Twitch.','2013/9/2','Released','https://store.steampowered.com/app/214950/Total_War_ROME_II__Emperor_Edition/?snr=1_7_7_230_150_6'),(249,'car_mechanic_simulator_2021',NULL,'Work your way to a service empire. Get your hands dirty in a highly realistic simulation game that pays major attention to details. Pay a visit to a new Auction house and buy cars in various conditions. Expand your range of services by investing in a new work space and equipment.','2021/8/11','Released','https://store.steampowered.com/app/1190000/Car_Mechanic_Simulator_2021/?snr=1_7_7_230_150_6'),(250,'kingdom_hearts_-hd_1.5+2.5_remix-',NULL,'KINGDOM HEARTS -HD 1.5+2.5 ReMIX- is an HD remastered collection of 6 unforgettable KINGDOM HEARTS experiences. Take up your Keyblade to save the Disney worlds from darkness.','2024/6/13','Released','https://store.steampowered.com/app/2552430/KINGDOM_HEARTS_HD_1525_ReMIX/?snr=1_7_7_230_150_6'),(251,'dead_island_2',NULL,'A deadly virus is spreading across Los Angeles, turning its inhabitants into zombies. Bitten, infected, but more than just immune, uncover the truth behind the outbreak and discover who - or what - you are. Survive, evolve and become the ultimate Zombie Slayer.','2024/4/22','Released','https://store.steampowered.com/app/934700/Dead_Island_2/?snr=1_7_7_230_150_6'),(252,'path_of_exile_2',NULL,'Path of Exile 2 is a next generation Action RPG from Grinding Gear Games, featuring co-op for up to six players. Set years after the original Path of Exile, you will return to the dark world of Wraeclast and seek to end the corruption that is spreading.','2024/12/6','Released','https://store.steampowered.com/app/2694490/Path_of_Exile_2/?snr=1_7_7_230_150_6'),(253,'stray',NULL,'Lost, alone and separated from family, a stray cat must untangle an ancient mystery to escape a long-forgotten cybercity and find their way home.','2022/7/19','Released','https://store.steampowered.com/app/1332010/Stray/?snr=1_7_7_230_150_6'),(254,'bodycam',NULL,'Bodycam is the first ultra-realistic multiplayer, first-person shooter game made using the latest technologies of the next-gen game engine Unreal Engine 5. Get ready to dive into fast-paced Bodycam actions, where every bullet counts and every choice can decide over the victory or loss of your team.','2024/6/7','Released','https://store.steampowered.com/app/2406770/Bodycam/?snr=1_7_7_230_150_6'),(255,'undertale',NULL,'UNDERTALE! The RPG game where you don\'t have to destroy anyone.','2015/9/15','Released','https://store.steampowered.com/app/391540/Undertale/?snr=1_7_7_230_150_6'),(256,'sniper_elite_5',NULL,'The award-winning series returns as Karl Fairburne fights to uncover Project Kraken in 1944 France. The genre-defining authentic sniping, with enhanced kill cam, has never looked or felt better as you fight across immersive maps to stop the Nazi war machine in its tracks.','2022/5/25','Released','https://store.steampowered.com/app/1029690/Sniper_Elite_5/?snr=1_7_7_230_150_6'),(257,'rimworld_-_biotech',NULL,'This content requires the base game RimWorld on Steam in order to play.','2022/10/21','Released','https://store.steampowered.com/app/1826140/RimWorld__Biotech/?snr=1_7_7_230_150_6'),(258,'devil_may_cry_5',NULL,'The ultimate Devil Hunter is back in style, in the game action fans have been waiting for.','2019/3/7','Released','https://store.steampowered.com/app/601150/Devil_May_Cry_5/?snr=1_7_7_230_150_6'),(259,'guilty_as_sock!',NULL,'Enter a chaotic courtroom where socks play lawyers, prosecutors, and judges! Use absurd evidence, craft wild arguments, and deliver verdicts in this hilarious online party game. Improvise, strategize, and shout \"Objection!\"—because in Guilty as Sock!, chaos always wins!','2025/5/29','Released','https://store.steampowered.com/app/3400930/Guilty_as_Sock/?snr=1_7_7_230_150_6'),(260,'valheim',NULL,'A brutal exploration and survival game for 1-10 players, set in a procedurally-generated purgatory inspired by viking culture. Battle, build, and conquer your way to a saga worthy of Odin’s patronage!','2021/2/2','Released','https://store.steampowered.com/app/892970/Valheim/?snr=1_7_7_230_150_6'),(261,'snowrunner',NULL,'Get ready for the next-generation off-road experience! Drive powerful vehicles and overcome extreme open environments to complete dozens of challenging missions solo or with up to 3 friends!','2021/5/17','Released','https://store.steampowered.com/app/1465360/SnowRunner/?snr=1_7_7_230_150_6'),(262,'the_forest',NULL,'As the lone survivor of a passenger jet crash, you find yourself in a mysterious forest battling to stay alive against a society of cannibalistic mutants. Build, explore, survive in this terrifying first person survival horror simulator.','2018/4/30','Released','https://store.steampowered.com/app/242760/The_Forest/?snr=1_7_7_230_150_6'),(263,'the_outer_worlds',NULL,'The Outer Worlds is an award-winning single-player RPG from Obsidian Entertainment and Private Division. As you explore a space colony, the character you decide to become will determine how this player-driven story unfolds. In the colony\'s corporate equation, you are the unplanned variable.','2020/10/23','Released','https://store.steampowered.com/app/578650/The_Outer_Worlds/?snr=1_7_7_230_150_6'),(264,'slay_the_spire',NULL,'We fused card games and roguelikes together to make the best single player deckbuilder we could. Craft a unique deck, encounter bizarre creatures, discover relics of immense power, and Slay the Spire!','2019/1/23','Released','https://store.steampowered.com/app/646570/Slay_the_Spire/?snr=1_7_7_230_150_6'),(265,'world_of_tanks',NULL,'Jump into the free-to-play team-based shooter with an ever-expanding roster of historical vehicles, stunning graphics, spectacular locales, and orchestral scores. Show your mastery and face other players in thrilling PvP clashes. A unique mix of strategy and action awaits!','2021/4/28','Released','https://store.steampowered.com/app/1407200/World_of_Tanks/?snr=1_7_7_230_150_6'),(266,'tcg_card_shop_simulator',NULL,'Open your own local game store. Stock shelves with the latest booster packs, or crack them and collect the cards for yourself. Set your own prices, hire staff, host events, and expand your card shop.','2024/9/15','Released','https://store.steampowered.com/app/3070070/TCG_Card_Shop_Simulator/?snr=1_7_7_230_150_6'),(267,'monster_hunter:_world',NULL,'Welcome to a new world! In Monster Hunter: World, the latest installment in the series, you can enjoy the ultimate hunting experience, using everything at your disposal to hunt monsters in a new world teeming with surprises and excitement.','2018/8/8','Released','https://store.steampowered.com/app/582010/Monster_Hunter_World/?snr=1_7_7_230_150_6'),(268,'call_of_duty®:_warzone™',NULL,'Welcome to Call of Duty®: Warzone™, the massive free-to-play combat arena. Experience thrilling modes & new gameplay features in Verdansk and Rebirth Island.','2022/11/16','Released','https://store.steampowered.com/app/1962663/Call_of_Duty_Warzone/?snr=1_7_7_230_150_6'),(269,'beyond:_two_souls',NULL,'A unique psychological action thriller delivered by A-list Hollywood performances by Elliot Page and Willem Dafoe, Beyond: Two Souls takes you on a thrilling journey across the globe as you play out the remarkable life of Jodie Holmes.','2020/6/18','Released','https://store.steampowered.com/app/960990/Beyond_Two_Souls/?snr=1_7_7_230_150_6'),(270,'mass_effect™_legendary_edition',NULL,'The Mass Effect™ Legendary Edition includes single-player base content and over 40 DLC from the highly acclaimed Mass Effect, Mass Effect 2, and Mass Effect 3 games, including promo weapons, armors, and packs — remastered and optimized for 4K Ultra HD.','2021/5/14','Released','https://store.steampowered.com/app/1328670/Mass_Effect_Legendary_Edition/?snr=1_7_7_230_150_6'),(271,'teardown',NULL,'Prepare the perfect heist in this simulated and fully destructible voxel world. Tear down walls with vehicles or explosives to create shortcuts. Stack objects to reach higher. Use the environment to your advantage in the most creative way you can think of.','2022/4/21','Released','https://store.steampowered.com/app/1167630/Teardown/?snr=1_7_7_230_150_6'),(272,'factorio:_space_age',NULL,'This content requires the base game Factorio on Steam in order to play.','2024/10/21','Released','https://store.steampowered.com/app/645390/Factorio_Space_Age/?snr=1_7_7_230_150_6'),(273,'end_of_zoe',NULL,'This content requires the base game Resident Evil 7 Biohazard on Steam in order to play.','2017/12/11','Released','https://store.steampowered.com/app/530611/End_of_Zoe/?snr=1_7_7_230_150_6'),(274,'elden_ring_shadow_of_the_erdtree',NULL,'This content requires the base game ELDEN RING on Steam in order to play.','2024/6/20','Released','https://store.steampowered.com/app/2778580/ELDEN_RING_Shadow_of_the_Erdtree/?snr=1_7_7_230_150_6'),(275,'barony',NULL,'Barony is the premier first-person roguelike with cooperative play! Adventure alone, or gather a party with iconic and unusual RPG classes to face off against the brutal dungeons. Test your resourcefulness, wits, and friendships, on your quest to lift the evil lich\'s curse!','2015/6/23','Released','https://store.steampowered.com/app/371970/Barony/?snr=1_7_7_230_150_6'),(276,'system_shock_2:_25th_anniversary_remaster',NULL,'System Shock® 2: 25th Anniversary Remaster is a genre defining experience that established innovative game-play mechanics that are a staple of the FPS and RPG genre today. Survive the wretched corridors of the Von Braun. Your training has prepared you for this.','2025/6/26','Released','https://store.steampowered.com/app/866570/System_Shock_2_25th_Anniversary_Remaster/?snr=1_7_7_230_150_6'),(277,'crusader_kings_iii:_roads_to_power',NULL,'This content requires the base game Crusader Kings III on Steam in order to play.','2024/9/24','Released','https://store.steampowered.com/app/2671070/Crusader_Kings_III_Roads_to_Power/?snr=1_7_7_230_150_6'),(278,'lethal_company',NULL,'A co-op horror about scavenging at abandoned moons to sell scrap to the Company.','2023/10/23','Released','https://store.steampowered.com/app/1966720/Lethal_Company/?snr=1_7_7_230_150_6'),(279,'avatar:_frontiers_of_pandora™',NULL,'Avatar: Frontiers of Pandora™ is a first-person, action-adventure game set in the Western Frontier. Reconnect with your lost heritage and discover what it truly means to be Na\'vi as you join other clans to protect Pandora.','2024/6/17','Released','https://store.steampowered.com/app/2840770/Avatar_Frontiers_of_Pandora/?snr=1_7_7_230_150_6'),(280,'call_of_duty®',NULL,'The Call of Duty® experience supports Call of Duty®: Black Ops 6, Call of Duty®: Modern Warfare® III, Call of Duty®: Modern Warfare® II and Call of Duty®: Warzone™.','2022/10/27','Released','https://store.steampowered.com/app/1938090/Call_of_Duty/?snr=1_7_7_230_150_6'),(281,'liar\'s_bar',NULL,'Dive into this multiplayer online experience set in a sketchy bar where the games are as dangerous as the patrons. Join a table of 4 and test your skills in Liar\'s Dice and Liar\'s Deck, where lying and bluffing are key to victory. Ready for a night at Liar\'s Bar?','2024/10/2','Released','https://store.steampowered.com/app/3097560/Liars_Bar/?snr=1_7_7_230_150_6'),(282,'carx_street',NULL,'Conquer mountain roads, highways, and city streets. Build your dream car with detailed tuning that unleashes the potential of “CarX Technology”© physics. Take part in thrilling races, enjoying realistic gameplay and dynamic driving.','2024/8/29','Released','https://store.steampowered.com/app/1114150/CarX_Street/?snr=1_7_7_230_150_6'),(283,'ark:_survival_evolved',NULL,'Stranded on the shores of a mysterious island, you must learn to survive. Use your cunning to kill or tame the primeval creatures roaming the land, and encounter other players to survive, dominate... and escape!','2017/8/27','Released','https://store.steampowered.com/app/346110/ARK_Survival_Evolved/?snr=1_7_7_230_150_6'),(284,'dead_by_daylight:_five_nights_at_freddy’s',NULL,'This content requires the base game Dead by Daylight on Steam in order to play.','2025/6/17','Released','https://store.steampowered.com/app/3796620/Dead_by_Daylight_Five_Nights_at_Freddys/?snr=1_7_7_230_150_6'),(285,'mortal_kombat_1',NULL,'Discover a reborn Mortal Kombat™ Universe created by the Fire God Liu Kang. Mortal Kombat™ 1 ushers in a new era of the iconic franchise with a new fighting system, game modes, and fatalities!','2023/9/19','Released','https://store.steampowered.com/app/1971870/Mortal_Kombat_1/?snr=1_7_7_230_150_6'),(286,'tiny_glade',NULL,'Tiny Glade is a small diorama builder where you doodle whimsical castles, cozy cottages & romantic ruins. Explore gridless building chemistry as the game adorns your glades with procedural detail. No management, combat or goals: just kick back and turn forgotten meadows into lovable dioramas.','2024/9/23','Released','https://store.steampowered.com/app/2198150/Tiny_Glade/?snr=1_7_7_230_150_6'),(287,'dead_cells',NULL,'Dead Cells is a roguelite, metroidvania inspired, action-platformer. You\'ll explore a sprawling, ever-changing castle... assuming you’re able to fight your way past its keepers in 2D souls-lite combat. No checkpoints. Kill, die, learn, repeat.','2018/8/6','Released','https://store.steampowered.com/app/588650/Dead_Cells/?snr=1_7_7_230_150_6'),(288,'suit_for_hire',NULL,'Suit for Hire is a challenging action shooter, tactically blend weapons and martial arts together to unleash beautifully crafted violence.','2025/6/20','Released','https://store.steampowered.com/app/1612420/Suit_for_Hire/?snr=1_7_7_230_150_6'),(289,'divinity:_original_sin_2_-_definitive_edition',NULL,'The critically acclaimed RPG that raised the bar, from the creators of Baldur\'s Gate 3. Gather your party. Master deep, tactical combat. Venture as a party of up to four - but know that only one of you will have the chance to become a God.','2017/9/14','Released','https://store.steampowered.com/app/435150/Divinity_Original_Sin_2__Definitive_Edition/?snr=1_7_7_230_150_6'),(290,'new_world:_aeternum',NULL,'Experience a thrilling action RPG set on the supernatural island of Aeternum. Forge your destiny on an adventure filled with danger and opportunity.','2021/9/28','Released','https://store.steampowered.com/app/1063730/New_World_Aeternum/?snr=1_7_7_230_150_6'),(291,'crime_scene_cleaner',NULL,'Once you get tangled with the mob, you will forever be a part of the mob. At least they pay a decent salary and all you have to do is clean up after their dirty work, but you know what you’re doing. So clean crime scenes, earn as much money as you can, and get ready for the next mission.','2024/8/14','Released','https://store.steampowered.com/app/1040200/Crime_Scene_Cleaner/?snr=1_7_7_230_150_6'),(292,'supermarket_simulator',NULL,'Run your own supermarket! Stock shelves, set your prices, take payments, hire staff, expand your store, handle shoplifters, and design your layout. Purchase goods from online or local markets around town, and personally deliver online orders to your customers.','2025/6/19','Released','https://store.steampowered.com/app/2670630/Supermarket_Simulator/?snr=1_7_7_230_150_6'),(293,'rune_factory:_guardians_of_azuma',NULL,'Welcome to the eastern nation of Azuma! In this fresh take on Rune Factory, use your powers as an Earth Dancer to restore the land, its people, and even its gods. Along the way, battle corrupted monsters, rebuild seasonal farms and villages, and form bonds with the colorful locals.','2025/6/4','Released','https://store.steampowered.com/app/2864560/Rune_Factory_Guardians_of_Azuma/?snr=1_7_7_230_150_6'),(294,'cash_cleaner_simulator',NULL,'Check it, clean it, sort it, ship it. Welcome to the life of a cash cleaner. Take jobs from underworld contacts and clean some cash. Just don\'t try to leave...','2025/5/8','Released','https://store.steampowered.com/app/2488370/Cash_Cleaner_Simulator/?snr=1_7_7_230_150_6'),(295,'risk_of_rain_2:_seekers_of_the_storm',NULL,'This content requires the base game Risk of Rain 2 on Steam in order to play.','2024/8/27','Released','https://store.steampowered.com/app/2306620/Risk_of_Rain_2_Seekers_of_the_Storm/?snr=1_7_7_230_150_6'),(296,'the_first_descendant',NULL,'The First Descendant is a third-person looter shooter powered by Unreal Engine 5. Become a Descendant. Fight for the survival of humanity. Descendants have unique abilities to tackle both solo and co-op missions. Up to 4 players use varied mechanics to defeat giant bosses. BE THE FIRST DESCENDANT!','2024/6/30','Released','https://store.steampowered.com/app/2074920/The_First_Descendant/?snr=1_7_7_230_150_6'),(297,'sniper_elite:_resistance',NULL,'Offering unparalleled sniping mechanics, stealth and tactical third-person combat, Sniper Elite: Resistance turns the attention of the award-winning series towards a hidden war, far from the front lines, deep within the heart of occupied France.','2025/1/30','Released','https://store.steampowered.com/app/2169200/Sniper_Elite_Resistance/?snr=1_7_7_230_150_7'),(298,'medieval_dynasty',NULL,'Hunt, survive, build and lead in the harsh Middle Ages: Create your own Medieval Dynasty and ensure its long-lasting prosperity or die trying! Play alone or team up with friends to enjoy the ultimate medieval experience.','2021/9/23','Released','https://store.steampowered.com/app/1129580/Medieval_Dynasty/?snr=1_7_7_230_150_7'),(299,'timberborn',NULL,'Humans are long gone. In a world struck by droughts and toxic waste, will your lumberpunk beavers do any better? A city-building game featuring ingenious animals, vertical architecture, water physics, and terraforming. Contains high amounts of wood.','2021/9/15','Released','https://store.steampowered.com/app/1062090/Timberborn/?snr=1_7_7_230_150_7'),(300,'hell_let_loose',NULL,'Join the ever expanding experience of Hell Let Loose - a hardcore World War Two first person shooter with epic battles of 100 players with infantry, tanks, artillery, a dynamically shifting front line and a unique resource based RTS-inspired meta-game.','2021/7/27','Released','https://store.steampowered.com/app/686810/Hell_Let_Loose/?snr=1_7_7_230_150_7'),(301,'guilty_gear_-strive-',NULL,'The cutting-edge 2D/3D hybrid graphics pioneered in the Guilty Gear series have been raised to the next level in “GUILTY GEAR -STRIVE-“. The new artistic direction and improved character animations will go beyond anything you’ve seen before in a fighting game!','2021/6/11','Released','https://store.steampowered.com/app/1384160/GUILTY_GEAR_STRIVE/?snr=1_7_7_230_150_7'),(302,'scum',NULL,'Traverse punishing environments, looting, crafting and evading the constant threats to your life. The unprecedented levels of character customization and progression are your ultimate tools for survival.','2025/6/17','Released','https://store.steampowered.com/app/513710/SCUM/?snr=1_7_7_230_150_7'),(303,'total_war:_warhammer',NULL,'Addictive turn-based empire-building with colossal, real-time battles, all set in a world of legendary heroes, giant monsters, flying creatures and storms of magical power.','2016/5/24','Released','https://store.steampowered.com/app/364360/Total_War_WARHAMMER/?snr=1_7_7_230_150_7'),(304,'uncharted™:_legacy_of_thieves_collection',NULL,'Play as Nathan Drake and Chloe Frazer in their own standalone adventures as they confront their pasts and forge their own legacies. This game includes the critically acclaimed single-player stories from both UNCHARTED 4: A Thief’s End and UNCHARTED: The Lost Legacy.','2022/10/19','Released','https://store.steampowered.com/app/1659420/UNCHARTED_Legacy_of_Thieves_Collection/?snr=1_7_7_230_150_7'),(305,'the_hundred_line_-last_defense_academy-',NULL,'Kazutaka Kodaka and Kotaro Uchikoshi join forces for the first time to deliver the ULTIMATE adventure game! 15 students are tasked with defending a school from grotesque monsters for 100 days. Can they make it to the end? And will they survive long enough to uncover the truth?','2025/4/23','Released','https://store.steampowered.com/app/3014080/The_Hundred_Line_Last_Defense_Academy/?snr=1_7_7_230_150_7'),(306,'haste',NULL,'Run fast, soar through the air, and master your landings as you speed through procedural worlds to outrun the end of the universe, by yourself and with friends!','2025/4/1','Released','https://store.steampowered.com/app/1796470/Haste/?snr=1_7_7_230_150_7'),(307,'total_war:_three_kingdoms',NULL,'Total War: THREE KINGDOMS is the first in the award-winning series to recreate epic conflict across ancient China. Combining a gripping turn-based campaign of empire-building & conquest with stunning real-time battles, THREE KINGDOMS redefines the series in an age of heroes & legends.','2019/5/23','Released','https://store.steampowered.com/app/779340/Total_War_THREE_KINGDOMS/?snr=1_7_7_230_150_7'),(308,'noita',NULL,'Noita is a magical action roguelite set in a world where every pixel is physically simulated. Fight, explore, melt, burn, freeze and evaporate your way through the procedurally generated world using spells you\'ve created yourself.','2020/10/15','Released','https://store.steampowered.com/app/881100/Noita/?snr=1_7_7_230_150_7'),(309,'fishing_planet',NULL,'Fishing Planet® is a free-to-play and highly realistic first-person online multiplayer fishing simulator. Developed by avid fishing enthusiasts to bring you the full thrill of actual angling on your PC.','2015/8/11','Released','https://store.steampowered.com/app/380600/Fishing_Planet/?snr=1_7_7_230_150_7'),(310,'blade_and_sorcery',NULL,'Blade & Sorcery is a built-for-VR medieval fantasy with full physics driven melee, ranged and magic combat. Become a powerful warrior, ranger or sorcerer and devastate your enemies.','2024/6/17','Released','https://store.steampowered.com/app/629730/Blade_and_Sorcery/?snr=1_7_7_230_150_7'),(311,'besiege',NULL,'Besiege is a physics building game about constructing mechanical machines to annihilate armies, obliterate castles and overcome challenging obstacles. Conquer the campaign or skirmish with friends in Multiplayer!','2020/2/18','Released','https://store.steampowered.com/app/346010/Besiege/?snr=1_7_7_230_150_7'),(312,'pga_tour_2k25',NULL,'Take your best shot at glory in PGA TOUR 2K25! In a 2K-first, compete in three prestigious major tournaments. Personalize your game with expanded MyCAREER, MyPLAYER and Course Designer options. Challenge friends across ranked, casual, and cross-platform multiplayer.','2025/2/27','Released','https://store.steampowered.com/app/2385530/PGA_TOUR_2K25/?snr=1_7_7_230_150_7'),(313,'warno',NULL,'Realistic, immersive, breathtaking. WARNO is the ultimate World War III battle simulator from the masters of strategy, Eugen Systems. A Cold War turns decisively hot as you command hundreds of units on a beautiful and brutal battlefield. Outsmart, outfight, and lead your forces to total victory.','2024/5/23','Released','https://store.steampowered.com/app/1611600/WARNO/?snr=1_7_7_230_150_7'),(314,'grand_theft_auto_iv:_the_complete_edition',NULL,'Niko Bellic, Johnny Klebitz and Luis Lopez all have one thing in common - they live in the worst city in America. Liberty City worships money and status, and is heaven for those who have them and a living nightmare for those who don\'t.','2020/3/24','Released','https://store.steampowered.com/app/12210/Grand_Theft_Auto_IV_The_Complete_Edition/?snr=1_7_7_230_150_7'),(315,'space_engineers',NULL,'Space Engineers is a sandbox game about engineering, construction, exploration and survival in space and on planets. Players build space ships, space stations, planetary outposts of various sizes and uses, pilot ships and travel through space to explore planets and gather resources to survive.','2019/2/28','Released','https://store.steampowered.com/app/244850/Space_Engineers/?snr=1_7_7_230_150_7'),(316,'grand_theft_auto:_san_andreas_–_the_definitive_edition',NULL,'Grand Theft Auto: San Andreas: It’s the early ’90s. After a couple of cops frame him for homicide, Carl ‘CJ’ Johnson is forced on a journey that takes him across the entire state of San Andreas, to save his family and to take control of the streets.','2023/1/19','Released','https://store.steampowered.com/app/1547000/Grand_Theft_Auto_San_Andreas__The_Definitive_Edition/?snr=1_7_7_230_150_7'),(317,'doom',NULL,'Now includes all three premium DLC packs (Unto the Evil, Hell Followed, and Bloodfall), maps, modes, and weapons, as well as all feature updates including Arcade Mode, Photo Mode, and the latest Update 6.66, which brings further multiplayer improvements as well as revamps multiplayer progression.','2016/5/12','Released','https://store.steampowered.com/app/379720/DOOM/?snr=1_7_7_230_150_7'),(318,'battlefield™_2042',NULL,'Battlefield™ 2042 is a first-person shooter that marks the return to the iconic all-out warfare of the franchise.','2021/11/19','Released','https://store.steampowered.com/app/1517290/Battlefield_2042/?snr=1_7_7_230_150_7'),(319,'fragpunk',NULL,'FragPunk is a thrilling 5v5 hero shooter where Shard Cards allow you to break the rules of combat and ensure that no two rounds are ever the same. Get ready to unleash your skills!','2025/3/6','Released','https://store.steampowered.com/app/2943650/FragPunk/?snr=1_7_7_230_150_7'),(320,'still_wakes_the_deep',NULL,'1975. Disaster strikes the Beira D oil rig off the coast of Scotland. Navigate the collapsing rig to save your crew from an otherworldly horror on the edge of all logic and reality.','2024/6/18','Released','https://store.steampowered.com/app/1622910/Still_Wakes_the_Deep/?snr=1_7_7_230_150_7'),(321,'my_summer_car',NULL,'My Summer Car is the ultimate car owning, building, fixing, tuning, maintenance AND permadeath life survival simulator. You start the game with hundreds of loose parts and assemble both car and engine.','2025/1/8','Released','https://store.steampowered.com/app/516750/My_Summer_Car/?snr=1_7_7_230_150_7'),(322,'escape_simulator',NULL,'First-person puzzler you can play solo or in an online co-op. Explore a set of highly interactive escape rooms. Move furniture, pick up and examine everything, smash pots and break locks! Play thousands of community-made rooms through the level editor.','2021/10/19','Released','https://store.steampowered.com/app/1435790/Escape_Simulator/?snr=1_7_7_230_150_7'),(323,'jdm:_japanese_drift_master',NULL,'Discover Japan’s legendary car culture in JDM: Japanese Drift Master! Take on challenging roads with refined simcade physics, immerse in the story through manga pages, and explore an open world inspired by stunning real-life areas. Every turn invites you to master the art of drift.','2025/5/21','Released','https://store.steampowered.com/app/1153410/JDM_Japanese_Drift_Master/?snr=1_7_7_230_150_7'),(324,'x4:_foundations',NULL,'Thrilling space battles meet deep strategy. X4 invites you to explore, fight, trade, and build an empire in a dynamic, fully simulated space sandbox, where every decision shapes your journey. Now featuring the 2025 flight model overhaul.','2018/11/30','Released','https://store.steampowered.com/app/392160/X4_Foundations/?snr=1_7_7_230_150_7'),(325,'ratchet_&_clank:_rift_apart',NULL,'Blast your way through an interdimensional adventure with Ratchet and Clank – now on PC! Help them take on an evil emperor from another reality as you jump between action-packed worlds and beyond at hyper-speed!','2023/7/26','Released','https://store.steampowered.com/app/1895880/Ratchet__Clank_Rift_Apart/?snr=1_7_7_230_150_7'),(326,'gtfo',NULL,'GTFO is a hardcore cooperative horror shooter that throws you from gripping suspense to explosive action in a heartbeat. Stealth, strategy, and teamwork are necessary to survive in your deadly, underground prison. Work together or die together.','2021/12/9','Released','https://store.steampowered.com/app/493520/GTFO/?snr=1_7_7_230_150_7'),(327,'batman™:_arkham_knight',NULL,'Batman™: Arkham Knight brings the award-winning Arkham trilogy from Rocksteady Studios to its epic conclusion. Developed exclusively for New-Gen platforms, Batman: Arkham Knight introduces Rocksteady\'s uniquely designed version of the Batmobile.','2015/6/23','Released','https://store.steampowered.com/app/208650/Batman_Arkham_Knight/?snr=1_7_7_230_150_7'),(328,'gray_zone_warfare',NULL,'In Gray Zone Warfare, realism meets tactics in an open-world MMOFPS where every move matters. Deploy with a Private Military Company, survive intense PvEvP or PvE encounters against players and AI, unravel the secrets of Lamang Island, and thrive through hard-earned progression.','2024/4/30','Released','https://store.steampowered.com/app/2479810/Gray_Zone_Warfare/?snr=1_7_7_230_150_7'),(329,'kingdom_come:_deliverance',NULL,'Story-driven open-world RPG that immerses you in an epic adventure in the Holy Roman Empire. Avenge your parents\' death as you battle invading forces, go on game-changing quests, and make influential choices. Explore castles, forests, villages and other realistic settings in medieval Bohemia!','2018/2/13','Released','https://store.steampowered.com/app/379430/Kingdom_Come_Deliverance/?snr=1_7_7_230_150_7'),(330,'euro_truck_simulator_2_-_greece',NULL,'This content requires the base game Euro Truck Simulator 2 on Steam in order to play.','2024/12/4','Released','https://store.steampowered.com/app/2604420/Euro_Truck_Simulator_2__Greece/?snr=1_7_7_230_150_7'),(331,'rimworld_-_anomaly',NULL,'This content requires the base game RimWorld on Steam in order to play.','2024/4/11','Released','https://store.steampowered.com/app/2380740/RimWorld__Anomaly/?snr=1_7_7_230_150_7'),(332,'avowed',NULL,'Avowed is a first-person fantasy RPG set in the world of Eora, where your choices carve a path through war, intrigue, and ancient mysteries. Navigate a land in turmoil, forge powerful alliances or deadly rivalries, and wield magic and steel to shape the fate of the Living Lands—and your own destiny.','2025/2/18','Released','https://store.steampowered.com/app/2457220/Avowed/?snr=1_7_7_230_150_7'),(333,'space_engineers_2',NULL,'The ultimate space sandbox, reimagined. Unleash your creativity with powerful building tools, explore the mysterious Almagest system, and uncover its captivating story. Join the Early Access and shape the future of space engineering!','2025/1/27','Released','https://store.steampowered.com/app/1133870/Space_Engineers_2/?snr=1_7_7_230_150_7'),(334,'two_point_hospital',NULL,'Design stunning hospitals, cure peculiar illnesses and manage troublesome staff as you spread your budding healthcare organisation across Two Point County.','2018/8/29','Released','https://store.steampowered.com/app/535930/Two_Point_Hospital/?snr=1_7_7_230_150_7'),(335,'crime_simulator',NULL,'You’re out of jail, but the debt isn’t gone. Sneak, steal, and break into houses solo or in 4-player co-op. Use lockpicks, sleeping gas, and brute force to complete jobs, outsmart security, and make enough money before time runs out. Will you pay back what you owe, or lose everything?','2025/6/17','Released','https://store.steampowered.com/app/2737070/Crime_Simulator/?snr=1_7_7_230_150_7'),(336,'dynasty_warriors:_origins',NULL,'Become immersed in exhilarating battles as a nameless hero in the Three Kingdoms','2025/1/16','Released','https://store.steampowered.com/app/2384580/DYNASTY_WARRIORS_ORIGINS/?snr=1_7_7_230_150_7'),(337,'tom_clancy\'s_ghost_recon®_breakpoint',NULL,'Become a Ghost, fighting against a rogue spec ops faction called the Wolves, in the latest Tom Clancy\'s Ghost Recon®!','2023/1/23','Released','https://store.steampowered.com/app/2231380/Tom_Clancys_Ghost_Recon_Breakpoint/?snr=1_7_7_230_150_7'),(338,'call_of_duty®:_black_ops_6_-_blackcell_(season_04)',NULL,'This content requires one of the following products to play:','2025/5/29','Released','https://store.steampowered.com/app/3203390/Call_of_Duty_Black_Ops_6__BlackCell_Season_04/?snr=1_7_7_230_150_7'),(339,'far_cry®_6',NULL,'Enter the adrenaline-filled world of a modern-day guerrilla revolution. With stunning vistas, visceral gunplay, and a huge variety of gameplay experiences, there\'s never been a better time to join the fight.','2023/5/11','Released','https://store.steampowered.com/app/2369390/Far_Cry_6/?snr=1_7_7_230_150_7'),(340,'ship,_inc.',NULL,'Run a wholesome shipping business! Ship, Inc. is a cozy job simulator where you are a packaging employee in a parcel shipment company. Follow the shipment orders, choose the package size, and prepare parcels. Upgrade your office, deliver orders safely and quickly!','2025/6/23','Released','https://store.steampowered.com/app/3496000/Ship_Inc/?snr=1_7_7_230_150_7'),(341,'a_little_to_the_left',NULL,'A Little to the Left is a cozy puzzle game that has you sort, stack, and organize household items into pleasing arrangements while you keep an eye out for a mischievous cat with an inclination for chaos. Check out this playful and intuitive puzzler with 100+ satisfying messes to tidy.','2022/11/8','Released','https://store.steampowered.com/app/1629520/A_Little_to_the_Left/?snr=1_7_7_230_150_7'),(342,'void_war',NULL,'Command an ancient starship and fight your way to the heart of a dying Empire. Fend off attacks from demented cultists, craven space pirates, and xenophobic Imperial soldiers. Discover powerful artifacts and use them to build your ship into a fearsome war engine.','2025/6/2','Released','https://store.steampowered.com/app/2853590/Void_War/?snr=1_7_7_230_150_7'),(343,'garry\'s_mod',NULL,'Garry\'s Mod is a physics sandbox. There aren\'t any predefined aims or goals. We give you the tools and leave you to play.','2006/11/29','Released','https://store.steampowered.com/app/4000/Garrys_Mod/?snr=1_7_7_230_150_7'),(344,'borderlands_2',NULL,'The Ultimate Vault Hunter’s Upgrade lets you get the most out of the Borderlands 2 experience.','2012/9/20','Released','https://store.steampowered.com/app/49520/Borderlands_2/?snr=1_7_7_230_150_7'),(345,'runescape_®',NULL,'RuneScape is a high fantasy open world MMORPG. Explore an ever changing and evolving living world where new challenges, skills, and quests await. Featuring unprecedented player freedom, you choose how to play, adventure, and grow.','2020/10/14','Released','https://store.steampowered.com/app/1343400/RuneScape/?snr=1_7_7_230_150_7'),(346,'brawlhalla',NULL,'An epic platform fighter for up to 8 players online or local. Try casual free-for-alls, ranked matches, or invite friends to a private room. And it\'s free! Play cross-platform with millions of players on PlayStation, Xbox, Nintendo Switch, iOS, Android & Steam! Frequent updates. Over sixty Legends.','2017/10/17','Released','https://store.steampowered.com/app/291550/Brawlhalla/?snr=1_7_7_230_150_8'),(347,'tower_wizard',NULL,'Help a wizard build and upgrade a wizard tower in this incremental game! Use the tower to study magic, summon spirits, create buildings, and influence the world.','2025/6/19','Released','https://store.steampowered.com/app/3372980/Tower_Wizard/?snr=1_7_7_230_150_8'),(348,'wwe_2k25',NULL,'Celebrate The Bloodline in Showcase. Compete online in MyGM. Expanded gameplay includes intergender wrestling, chain wrestling, barricade diving, the return of Promos + much more!','2025/3/13','Released','https://store.steampowered.com/app/2878960/WWE_2K25/?snr=1_7_7_230_150_8'),(349,'maplestory',NULL,'Join over 260 million players worldwide in MapleStory, the world’s biggest 2D MMORPG adventure! Play now for free.','2012/8/9','Released','https://store.steampowered.com/app/216150/MapleStory/?snr=1_7_7_230_150_8'),(350,'steins;gate',NULL,'Developed by 5pb. and Nitroplus, STEINS;GATE was awarded Famitsu magazine\'s coveted annual Game of Excellence award and was voted one of the most emotionally charged “tear-inducing games” ever made, in a Famitsu poll.　It is a gripping and moving Visual Novel, which has already spawned manga and anime adaptations.','2016/9/8','Released','https://store.steampowered.com/app/412830/STEINSGATE/?snr=1_7_7_230_150_8'),(351,'age_of_mythology:_retold',NULL,'From the creators of the award-winning Age of Empires franchise, Age of Mythology: Retold goes beyond history to a mythical age where gods, monsters, and humans collide.','2024/9/4','Released','https://store.steampowered.com/app/1934680/Age_of_Mythology_Retold/?snr=1_7_7_230_150_8'),(352,'foundation',NULL,'Foundation is a grid-less, laidback medieval city-building game with a focus on organic development, monument construction and resource management.','2025/1/31','Released','https://store.steampowered.com/app/690830/Foundation/?snr=1_7_7_230_150_8'),(353,'don\'t_starve_together',NULL,'Fight, Farm, Build and Explore Together in the standalone multiplayer expansion to the uncompromising wilderness survival game, Don\'t Starve.','2016/4/21','Released','https://store.steampowered.com/app/322330/Dont_Starve_Together/?snr=1_7_7_230_150_8'),(354,'forza_motorsport',NULL,'Compete in over 500 cars on 30 world-famous tracks – now featuring the legendary Fujimi Kaido! Play the new 20th Anniversary Tour and obtain special rewards.','2023/10/9','Released','https://store.steampowered.com/app/2440510/Forza_Motorsport/?snr=1_7_7_230_150_8'),(355,'marvel’s_spider-man:_miles_morales',NULL,'After the events of Marvel’s Spider-Man Remastered, teenage Miles Morales is adjusting to his new home while following in the footsteps of his mentor, Peter Parker, as a new Spider-Man. When a fierce power struggle threatens to destroy his home, Miles must take up the mantle of Spider-Man and own it','2022/11/18','Released','https://store.steampowered.com/app/1817190/Marvels_SpiderMan_Miles_Morales/?snr=1_7_7_230_150_8'),(356,'assassin\'s_creed®_odyssey',NULL,'Assassin\'s Creed Odyssey is an action-adventure game where you choose the hero you want to become. Embark on an epic journey from outcast to living legend to uncover the secrets of your past and change the fate of Ancient Greece. Fight in visceral battles on both land and sea to become a true hero','2018/10/5','Released','https://store.steampowered.com/app/812140/Assassins_Creed_Odyssey/?snr=1_7_7_230_150_8'),(357,'a_way_out',NULL,'A Way Out is an exclusively co-op adventure where you play the role of one of two prisoners making their daring escape from prison.','2018/3/23','Released','https://store.steampowered.com/app/1222700/A_Way_Out/?snr=1_7_7_230_150_8'),(358,'spyro™_reignited_trilogy',NULL,'Same sick burns, same smoldering attitude, now all scaled up in stunning HD, Spyro is back in the Spyro™ Reignited Trilogy! Rekindle the fire with remastered versions of the original three games, Spyro™ the Dragon, Spyro™ 2: Ripto\'s Rage! and Spyro™: Year of the Dragon.','2019/9/3','Released','https://store.steampowered.com/app/996580/Spyro_Reignited_Trilogy/?snr=1_7_7_230_150_8'),(359,'last_epoch',NULL,'Uncover the Past, Reforge the Future. Ascend into one of 15 mastery classes and explore dangerous dungeons, hunt epic loot, craft legendary weapons, and wield the power of over a hundred transformative skill trees. Last Epoch is being developed by a team of passionate Action RPG enthusiasts.','2024/2/21','Released','https://store.steampowered.com/app/899770/Last_Epoch/?snr=1_7_7_230_150_8'),(360,'vampire_survivors',NULL,'Mow down thousands of night creatures and survive until dawn! Vampire Survivors is a gothic horror casual game with rogue-lite elements, where your choices can allow you to quickly snowball against the hundreds of monsters that get thrown at you.','2022/10/20','Released','https://store.steampowered.com/app/1794680/Vampire_Survivors/?snr=1_7_7_230_150_8'),(361,'everspace™_2',NULL,'EVERSPACE 2 is a fast-paced single-player spaceship shooter with exploration in space and on planets, tons of loot, RPG elements, mining, and crafting. Experience an exciting sci-fi story set in a vivid, handcrafted open world full of secrets, puzzles, and perils.','2023/4/6','Released','https://store.steampowered.com/app/1128920/EVERSPACE_2/?snr=1_7_7_230_150_8'),(362,'the_isle',NULL,'Experience fierce open world survival gameplay as you attempt to stay alive on an unforgiving island inhabited by dinosaurs! Hunt. Grow. Survive.','2015/12/1','Released','https://store.steampowered.com/app/376210/The_Isle/?snr=1_7_7_230_150_8'),(363,'the_stanley_parable:_ultra_deluxe',NULL,'The Stanley Parable: Ultra Deluxe is an expanded re-imagining of 2013\'s The Stanley Parable. You will play as Stanley, and you will not play as Stanley. You will make a choice, and you will become powerless. You are not here to win. The Stanley Parable is a game that plays you.','2022/4/27','Released','https://store.steampowered.com/app/1703340/The_Stanley_Parable_Ultra_Deluxe/?snr=1_7_7_230_150_8'),(364,'aviassembly',NULL,'Build and fly your own airplane! Complete missions to earn money, upgrade your plane, and discover new locations in an open world.','2025/4/11','Released','https://store.steampowered.com/app/2660460/Aviassembly/?snr=1_7_7_230_150_8'),(365,'workers_&_resources:_soviet_republic',NULL,'Build a soviet republic from an impoverished country into a rich industrial superpower in a city builder with intricate production chains and a fully simulated global economy. Manage the lives of your citizens from education to work and party loyalty to criminal activity.','2024/6/20','Released','https://store.steampowered.com/app/784150/Workers__Resources_Soviet_Republic/?snr=1_7_7_230_150_8'),(366,'drop_duchy',NULL,'Build your duchy piece by piece in this refreshing hybrid rogue-lite game. Use block-dropping mechanics to collect resources, recruit troops to fight against belligerent armies, and let every block shape your realm, leading your path to victory!','2025/5/5','Released','https://store.steampowered.com/app/2525310/Drop_Duchy/?snr=1_7_7_230_150_8'),(367,'dark_souls™_iii',NULL,'Dark Souls continues to push the boundaries with the latest, ambitious chapter in the critically-acclaimed and genre-defining series. Prepare yourself and Embrace The Darkness!','2016/4/11','Released','https://store.steampowered.com/app/374320/DARK_SOULS_III/?snr=1_7_7_230_150_8'),(368,'remnant_ii®',NULL,'REMNANT II® pits survivors of humanity against new deadly creatures and god-like bosses across terrifying worlds. Play solo or co-op with two other friends to explore the depths of the unknown to stop an evil from destroying reality itself.','2023/7/25','Released','https://store.steampowered.com/app/1282100/REMNANT_II/?snr=1_7_7_230_150_8'),(369,'south_of_midnight',NULL,'South of Midnight is a new action-adventure from Compulsion Games. Explore the mythos and confront mysterious creatures of the Deep South in this modern folktale while learning to weave an ancient power to surmount obstacles and unravel your family’s hidden past.','2025/4/8','Released','https://store.steampowered.com/app/1934570/South_of_Midnight/?snr=1_7_7_230_150_8'),(370,'no_rest_for_the_wicked',NULL,'From Moon Studios, the award-winning developers of Ori and the Blind Forest and Ori and the Will of the Wisps comes No Rest for the Wicked, a visceral, precision Action RPG set to reinvent the genre.','2024/4/18','Released','https://store.steampowered.com/app/1371980/No_Rest_for_the_Wicked/?snr=1_7_7_230_150_8'),(371,'fast_food_simulator',NULL,'Welcome to the world\'s most chaotic place! Play solo or co-op with up to 6 players. Run a fast-food restaurant, and work with your friends to expand your business. Take orders, make burgers, and increase your earnings by dealing with customers.','2024/12/10','Released','https://store.steampowered.com/app/2916430/Fast_Food_Simulator/?snr=1_7_7_230_150_8'),(372,'dragon\'s_dogma_2',NULL,'Dragon’s Dogma 2 is a single player, narrative driven action-RPG that challenges the players to choose their own experience – from the appearance of their Arisen, their vocation, their party, how to approach different situations and more - in a truly immersive fantasy world.','2024/3/21','Released','https://store.steampowered.com/app/2054970/Dragons_Dogma_2/?snr=1_7_7_230_150_8'),(373,'the_roottrees_are_dead',NULL,'A genealogical mystery straight out of 1998. Scour the early Internet for clues, uncover hidden connections, and piece together the family tree behind the secretive Roottree Corporation.','2025/1/15','Released','https://store.steampowered.com/app/2754380/The_Roottrees_are_Dead/?snr=1_7_7_230_150_8'),(374,'chained_together',NULL,'From the depths of hell, climb chained to your friends through diverse worlds. Solo or co-op, try to reach the summit and discover what awaits you there...','2024/6/19','Released','https://store.steampowered.com/app/2567870/Chained_Together/?snr=1_7_7_230_150_8'),(375,'strinova',NULL,'Strinova is an anime-style third-person tactical competitive shooter. Switch freely between three-dimensional and two-dimensional forms in this one-of-a-kind game that offers a unique tactical shooting system for an unparalleled experience.','2024/11/21','Released','https://store.steampowered.com/app/1282270/Strinova/?snr=1_7_7_230_150_8'),(376,'call_of_duty®:_modern_warfare®_remastered_(2017)',NULL,'One of the most critically-acclaimed games in history, Call of Duty: Modern Warfare is back, remastered in true high-definition, featuring improved textures, physically based rendering, high-dynamic range lighting and much more.','2017/7/27','Released','https://store.steampowered.com/app/393080/Call_of_Duty_Modern_Warfare_Remastered_2017/?snr=1_7_7_230_150_8'),(377,'il-2_sturmovik:_battle_of_stalingrad',NULL,'IL-2 Sturmovik: Battle of Stalingrad is the continuation of the legendary IL-2 Sturmovik series that has set the standard for PC combat flight games for more than ten years. This new entry into the series will offer virtual pilots an even more accurate simulation of the most famous air battles.','2014/10/22','Released','https://store.steampowered.com/app/307960/IL2_Sturmovik_Battle_of_Stalingrad/?snr=1_7_7_230_150_8'),(378,'horizon_zero_dawn™_remastered',NULL,'Experience the critically acclaimed Horizon Zero Dawn™ with stunning new visuals and upgraded features. In a far future where colossal machines roam the Earth, pockets of humanity survive in unique tribes among the lush, overgrown ruins of our long-lost civilization.','2024/10/31','Released','https://store.steampowered.com/app/2561580/Horizon_Zero_Dawn_Remastered/?snr=1_7_7_230_150_8'),(379,'kenshi',NULL,'A free-roaming squad based RPG. Focusing on open-ended sandbox gameplay features rather than a linear story. Be a trader, a thief, a rebel, a warlord, an adventurer, a farmer, a slave, or just food for the cannibals. Train your men up from puny victims to master warriors.','2018/12/6','Released','https://store.steampowered.com/app/233860/Kenshi/?snr=1_7_7_230_150_8'),(380,'tekken_8',NULL,'TEKKEN 8 is the latest addition to the TEKKEN series, the pinnacle of 3D fighting games. Join the fight with over 32 characters and bear witness to the next installment in this epic saga. Get ready for the biggest and best TEKKEN game ever made!','2024/1/25','Released','https://store.steampowered.com/app/1778820/TEKKEN_8/?snr=1_7_7_230_150_8'),(381,'backrooms:_escape_together',NULL,'A visually lifelike co-op horror for 1-6 people. Journey through 9 procedurally generated levels, using what\'s available to survive and progress deeper into the Backrooms.','2022/10/18','Released','https://store.steampowered.com/app/2141730/Backrooms_Escape_Together/?snr=1_7_7_230_150_8'),(382,'crash_bandicoot™_4:_it’s_about_time',NULL,'It’s About Time - the critically-acclaimed Crash Bandicoot™ 4: It\'s About Time is now on Steam!','2022/10/18','Released','https://store.steampowered.com/app/1378990/Crash_Bandicoot_4_Its_About_Time/?snr=1_7_7_230_150_8'),(383,'foundry',NULL,'Build a sophisticated robot factory optimized to perfection in an infinite voxel world. Mine and harvest resources, automate your production lines and manage complex systems while researching your way to become the galaxy’s leading robotics megacorp.','2024/5/2','Released','https://store.steampowered.com/app/983870/FOUNDRY/?snr=1_7_7_230_150_8'),(384,'game_of_thrones:_kingsroad',NULL,'A story-driven action-adventure RPG, bringing the world of Westeros to life with remarkable detail and never-before seen scale.','2025/5/21','Released','https://store.steampowered.com/app/3183280/Game_of_Thrones_Kingsroad/?snr=1_7_7_230_150_8'),(385,'euro_truck_simulator_2_-_west_balkans',NULL,'This content requires the base game Euro Truck Simulator 2 on Steam in order to play.','2023/10/19','Released','https://store.steampowered.com/app/2004210/Euro_Truck_Simulator_2__West_Balkans/?snr=1_7_7_230_150_8'),(386,'farming_simulator_22',NULL,'Create your farm and let the good times grow! Harvest crops, tend to animals, manage productions, and take on seasonal challenges.','2021/11/21','Released','https://store.steampowered.com/app/1248130/Farming_Simulator_22/?snr=1_7_7_230_150_8'),(387,'stellaris:_the_machine_age',NULL,'This content requires the base game Stellaris on Steam in order to play.','2024/5/7','Released','https://store.steampowered.com/app/2840100/Stellaris_The_Machine_Age/?snr=1_7_7_230_150_8'),(388,'dragon_ball:_sparking!_zero',NULL,'DRAGON BALL: Sparking! ZERO takes the legendary gameplay of the Budokai Tenkaichi series and raises it to whole new levels. Make yours the destructive power of the strongest fighters ever to appear in Dragon Ball!','2024/10/10','Released','https://store.steampowered.com/app/1790600/DRAGON_BALL_Sparking_ZERO/?snr=1_7_7_230_150_8'),(389,'wreckfest_2',NULL,'Ready for mayhem? Wreckfest is back, offering the best in full-contact racing with unrivaled destruction! Witness head-to-head battles as you tear apart rival vehicles bit by bit. Powered by the enhanced physics engine, developed by the creators of Wreckfest & FlatOut!','2025/3/20','Released','https://store.steampowered.com/app/1203190/Wreckfest_2/?snr=1_7_7_230_150_8'),(390,'outlast_2',NULL,'Outlast 2 introduces you to Sullivan Knoth and his followers, who left our wicked world behind to give birth to Temple Gate, a town, deep in the wilderness and hidden from civilization. Knoth and his flock are preparing for the tribulations of the end of times and you’re right in the thick of it.','2017/4/25','Released','https://store.steampowered.com/app/414700/Outlast_2/?snr=1_7_7_230_150_8'),(391,'left_4_dead_2',NULL,'Set in the zombie apocalypse, Left 4 Dead 2 (L4D2) is the highly anticipated sequel to the award-winning Left 4 Dead, the #1 co-op game of 2008. This co-operative action horror FPS takes you and your friends through the cities, swamps and cemeteries of the Deep South, from Savannah to New Orleans across five expansive campaigns.','2009/11/19','Released','https://store.steampowered.com/app/550/Left_4_Dead_2/?snr=1_7_7_230_150_8'),(392,'tower_dominion',NULL,'Build and design the terrain while defending your stronghold against alien invasion in this unique Roguelike tower defense. Choose from 30 heroes, survive enemy waves, and upgrade a variety of destructive towers to hold the line!','2025/5/7','Released','https://store.steampowered.com/app/3226530/Tower_Dominion/?snr=1_7_7_230_150_8'),(393,'stormworks:_build_and_rescue',NULL,'Join a world where you design, create and pilot your own air sea rescue service. Release your inner hero as you battle fierce storms out at sea to rescue those in need.','2020/9/17','Released','https://store.steampowered.com/app/573090/Stormworks_Build_and_Rescue/?snr=1_7_7_230_150_8'),(394,'the_sims™_4_businesses_&_hobbies_expansion_pack',NULL,'This content requires the base game The Sims™ 4 on Steam in order to play.','2025/3/6','Released','https://store.steampowered.com/app/2815310/The_Sims_4_Businesses__Hobbies_Expansion_Pack/?snr=1_7_7_230_150_8'),(395,'the_lord_of_the_rings:_return_to_moria™',NULL,'The only survival crafting game set in the Fourth Age of Middle-earth™. Embark on an epic journey to reclaim the Dwarven homeland of Moria, and explore, craft, and build in procedurally generated worlds. Play as a solo adventurer, or join friends in co-op gameplay for up to 8 players.','2024/8/27','Released','https://store.steampowered.com/app/2933130/The_Lord_of_the_Rings_Return_to_Moria/?snr=1_7_7_230_150_8'),(396,'ark:_bob\'s_tall_tales',NULL,'This content requires the base game ARK: Survival Ascended on Steam in order to play.','2024/4/1','Released','https://store.steampowered.com/app/2881150/ARK_Bobs_Tall_Tales/?snr=1_7_7_230_150_9'),(397,'bellwright',NULL,'Establish and expand your own settlements, liberate the land and assist its villagers, and recruit others to your cause while learning more about a life you had to leave behind. Command your forces, prove your valor through combat, and cement yourself as the hero of your people.','2024/4/23','Released','https://store.steampowered.com/app/1812450/Bellwright/?snr=1_7_7_230_150_9'),(398,'world_of_tanks_blitz',NULL,'Tanks, not war: jump into a free-to-play MMO action shooter with over 400 tanks. Enjoy stunning graphics and intuitive touch controls. Engage in 7vs7 battles, strategize with your team to conquer diverse maps. Customize tanks, unlock upgrades, and dive into adrenaline-pumping action on mobile and PC','2016/11/9','Released','https://store.steampowered.com/app/444200/World_of_Tanks_Blitz/?snr=1_7_7_230_150_9'),(399,'middle-earth™:_shadow_of_war™',NULL,'Experience an epic open-world brought to life by the award-winning Nemesis System. Forge a new Ring of Power, conquer Fortresses in massive battles and dominate Mordor with your personal orc army in Middle-earth™: Shadow of War™.','2017/10/9','Released','https://store.steampowered.com/app/356190/Middleearth_Shadow_of_War/?snr=1_7_7_230_150_9'),(400,'titanfall®_2',NULL,'Respawn Entertainment gives you the most advanced titan technology in its new, single player campaign & multiplayer experience. Combine & conquer with new titans & pilots, deadlier weapons, & customization and progression systems that help you and your titan flow as one unstoppable killing force.','2016/10/28','Released','https://store.steampowered.com/app/1237970/Titanfall_2/?snr=1_7_7_230_150_9'),(401,'rain_world',NULL,'You are a nomadic slugcat, both predator and prey in a broken ecosystem. Grab your spear and brave the industrial wastes, hunting enough food to survive, but be wary— other, bigger creatures have the same plan... and slugcats look delicious.','2017/3/28','Released','https://store.steampowered.com/app/312520/Rain_World/?snr=1_7_7_230_150_9'),(402,'sunderfolk',NULL,'Rediscover game night in this tactical RPG where clever teamwork and shared strategy shape every turn and build lasting memories. One copy is all you need. Friends join using their phones, which become their character sheet, guidebook, and controller. Play the first 4 missions for free.','2025/4/23','Released','https://store.steampowered.com/app/2414270/Sunderfolk/?snr=1_7_7_230_150_9'),(403,'company_of_heroes_3',NULL,'Company of Heroes 3 combines heart-pounding combat with deeper strategic choices in a stunning Mediterranean theatre of war. In Company of Heroes 3, every battle tells a story...what\'s yours?','2023/2/23','Released','https://store.steampowered.com/app/1677280/Company_of_Heroes_3/?snr=1_7_7_230_150_9'),(404,'bitcraft_online',NULL,'Join thousands of players in a true single-world MMORPG. Carve out a cozy nook, master a player-driven economy, or band together to transform the ancient wilderness into thriving cities. From humble beginnings to legend, your choices matter - because in BitCraft, your actions shape our world.','2025/6/21','Released','https://store.steampowered.com/app/3454650/BitCraft_Online/?snr=1_7_7_230_150_9'),(405,'resident_evil_2',NULL,'A deadly virus engulfs the residents of Raccoon City in September of 1998, plunging the city into chaos as flesh eating zombies roam the streets for survivors. An unparalleled adrenaline rush, gripping storyline, and unimaginable horrors await you. Witness the return of Resident Evil 2.','2019/1/24','Released','https://store.steampowered.com/app/883710/Resident_Evil_2/?snr=1_7_7_230_150_9'),(406,'worldbox_-_god_simulator',NULL,'WorldBox is the ULTIMATE god simulator and sandbox game. A petri dish for your fantasy civilizations. Create your own world or destroy it using many powers. Watch civilizations grow, form kingdoms, colonize new lands, sail to far continents, wars to ignite, empires to fall and towns to burn!','2021/12/2','Released','https://store.steampowered.com/app/1206560/WorldBox__God_Simulator/?snr=1_7_7_230_150_9'),(407,'sonic_x_shadow_generations',NULL,'Shadow the Hedgehog is back with Classic and Modern Sonic in SONIC X SHADOW GENERATIONS, an all-new collection featuring two unique experiences!','2024/10/24','Released','https://store.steampowered.com/app/2513280/SONIC_X_SHADOW_GENERATIONS/?snr=1_7_7_230_150_9'),(408,'far_cry®_5',NULL,'Discover the open world of Hope County, Montana, besieged by a fanatical doomsday cult. Dive into the action solo or two-player co-op in the story campaign, use a vast arsenal of weapons and allies, and free Hope County from Joseph Seed and his cult.','2018/3/26','Released','https://store.steampowered.com/app/552520/Far_Cry_5/?snr=1_7_7_230_150_9'),(409,'contraband_police',NULL,'Take over the duties of a border guard inspector in a communist country of the 80\'s. Smuggling, corruption and forgery are the order of the day here. Be vigilant and earn the respect of your superiors.','2023/3/8','Released','https://store.steampowered.com/app/756800/Contraband_Police/?snr=1_7_7_230_150_9'),(410,'the_binding_of_isaac:_repentance',NULL,'This content requires the base game The Binding of Isaac: Rebirth on Steam in order to play.','2021/3/31','Released','https://store.steampowered.com/app/1426300/The_Binding_of_Isaac_Repentance/?snr=1_7_7_230_150_9'),(411,'void_crew',NULL,'Void Crew is a Chaotic, Co-op Roguelite game for 1 to 6 players: Outfit your spaceship and crew for thrilling quests, brave fierce enemies in Space Battles... and try not to panic!','2024/11/25','Released','https://store.steampowered.com/app/1063420/Void_Crew/?snr=1_7_7_230_150_9'),(412,'assassin\'s_creed_valhalla',NULL,'Assassin’s Creed Valhalla is an action-adventure game in which you are a Viking warrior raised on tales of battle and glory. Explore a dynamic open world set in England’s Dark Ages. Raid your enemies and grow your settlement to earn your place among the gods in Valhalla.','2022/12/6','Released','https://store.steampowered.com/app/2208920/Assassins_Creed_Valhalla/?snr=1_7_7_230_150_9'),(413,'party_animals',NULL,'Fight your friends as puppies, kittens and other fuzzy creatures in PARTY ANIMALS! Paw it out with your friends remotely, or huddle together for chaotic fun on the same screen. Interact with the world under our realistic physics engine. Did I mention PUPPIES?','2023/9/20','Released','https://store.steampowered.com/app/1260320/Party_Animals/?snr=1_7_7_230_150_9'),(414,'warhammer_40,000:_battlesector',NULL,'Warhammer 40,000: Battlesector is a fast-paced turn-based strategy game set in the grimdark universe of the 41st Millennium. Pick your force, develop your army, field mighty heroes and fight for victory using superior strategy, awesome abilities, and devastating weaponry.','2021/7/22','Released','https://store.steampowered.com/app/1295500/Warhammer_40000_Battlesector/?snr=1_7_7_230_150_9'),(415,'abiotic_factor',NULL,'Abiotic Factor is a survival crafting experience for 1-6 players set in the depths of an underground research facility. Caught between paranormal containment failure, a military crusade, and chaos from a dozen realms, the world’s greatest minds must survive against the universe’s biggest threats.','2024/5/2','Released','https://store.steampowered.com/app/427410/Abiotic_Factor/?snr=1_7_7_230_150_9'),(416,'fields_of_mistria',NULL,'Start your new life! Build the farm of your dreams as you discover a world brimming with possibilities. Magic, romance, and adventure all await you in this nostalgic farming / life sim RPG!','2024/8/5','Released','https://store.steampowered.com/app/2142790/Fields_of_Mistria/?snr=1_7_7_230_150_9'),(417,'rift_of_the_necrodancer',NULL,'The NecroDancer\'s back in an all-new rhythm game! Dragged into a strange new world, Cadence must engage in musical combat with monsters surging through the Rift! Face pulse-pounding Rhythm Rifts where every beat is a battle, all set to an original soundtrack by Danny Baranowsky & friends.','2025/2/5','Released','https://store.steampowered.com/app/2073250/Rift_of_the_NecroDancer/?snr=1_7_7_230_150_9'),(418,'slime_rancher_2',NULL,'Continue the adventures of Beatrix LeBeau as she journeys across the Slime Sea to Rainbow Island, a land brimming with ancient mysteries, and bursting with wiggly, new slimes to wrangle in this sequel to the smash-hit, Slime Rancher.','2022/9/22','Released','https://store.steampowered.com/app/1657630/Slime_Rancher_2/?snr=1_7_7_230_150_9'),(419,'final_fantasy_x/x-2_hd_remaster',NULL,'FINAL FANTASY X/X-2 HD Remaster celebrates two of the most cherished and beloved entries to the world-renowned franchise, completely remastered in gorgeous High Definition & now available on PC / Windows!','2016/5/12','Released','https://store.steampowered.com/app/359870/FINAL_FANTASY_XX2_HD_Remaster/?snr=1_7_7_230_150_9'),(420,'the_riftbreaker',NULL,'The Riftbreaker™ is a base-building, survival game with Action-RPG elements. You are an elite scientist/commando inside an advanced Mecha-Suit capable of dimensional rift travel. Hack & slash countless enemies. Build up your base, collect samples and research new inventions to survive.','2021/10/14','Released','https://store.steampowered.com/app/780310/The_Riftbreaker/?snr=1_7_7_230_150_9'),(421,'foxhole',NULL,'Foxhole is a massively multiplayer game where thousands of players shape the outcome of a persistent online war. Every individual soldier is a player that contributes to the war effort through logistics, base building, reconnaissance, combat, and more.','2022/9/28','Released','https://store.steampowered.com/app/505460/Foxhole/?snr=1_7_7_230_150_9'),(422,'call_of_duty®:_black_ops',NULL,'The biggest first-person action series of all time and the follow-up to critically acclaimed Call of Duty®: Modern Warfare 2 returns with Call of Duty®: Black Ops.','2010/11/8','Released','https://store.steampowered.com/app/42700/Call_of_Duty_Black_Ops/?snr=1_7_7_230_150_9'),(423,'shapez_2',NULL,'Dive into a factory-building game with the focus on just that – building huge space factories! Construct sprawling multi-level factories and satisfying production lines without limits. Tackle increasingly complex automation challenges at your own pace – you won’t have to worry about enemies.','2024/8/15','Released','https://store.steampowered.com/app/2162800/shapez_2/?snr=1_7_7_230_150_9'),(424,'ready_or_not:_dark_waters',NULL,'This content requires the base game Ready or Not on Steam in order to play.','2024/12/10','Released','https://store.steampowered.com/app/3174120/Ready_or_Not_Dark_Waters/?snr=1_7_7_230_150_9'),(425,'dwarf_fortress',NULL,'The deepest, most intricate simulation of a world that\'s ever been created. The legendary Dwarf Fortress is now on Steam. Build a fortress and try to help your dwarves survive against a deeply generated world.','2022/12/6','Released','https://store.steampowered.com/app/975370/Dwarf_Fortress/?snr=1_7_7_230_150_9'),(426,'stellaris:_biogenesis',NULL,'This content requires the base game Stellaris on Steam in order to play.','2025/5/5','Released','https://store.steampowered.com/app/3417840/Stellaris_BioGenesis/?snr=1_7_7_230_150_9'),(427,'celeste',NULL,'Help Madeline survive her inner demons on her journey to the top of Celeste Mountain, in this super-tight platformer from the creators of TowerFall. Brave hundreds of hand-crafted challenges, uncover devious secrets, and piece together the mystery of the mountain.','2018/1/25','Released','https://store.steampowered.com/app/504230/Celeste/?snr=1_7_7_230_150_9'),(428,'fallout:_new_vegas',NULL,'Welcome to Vegas. New Vegas. Enjoy your stay!','2010/10/21','Released','https://store.steampowered.com/app/22380/Fallout_New_Vegas/?snr=1_7_7_230_150_9'),(429,'payday_3',NULL,'PAYDAY 3 is the much anticipated sequel to one of the most popular co-op shooters ever. Since its release, PAYDAY-players have been reveling in the thrill of a perfectly planned and executed heist. That’s what makes PAYDAY a high-octane, co-op FPS experience without equal.','2023/9/21','Released','https://store.steampowered.com/app/1272080/PAYDAY_3/?snr=1_7_7_230_150_9'),(430,'chivalry_2',NULL,'Chivalry 2 is a multiplayer first person slasher inspired by epic medieval movie battles. Players are thrust into the action of every iconic moment of the era - from clashing swords, to storms of flaming arrows, to sprawling castle sieges and more.','2022/6/12','Released','https://store.steampowered.com/app/1824220/Chivalry_2/?snr=1_7_7_230_150_9'),(431,'soulstone_survivors',NULL,'Face the Lords of the Void and their endless minions, collect their Soulstones and become a god! In this Action Roguelite, unveil secret spells, craft mighty weapons, unlock multiple characters, discover game-breaking synergies and conquer the power of the void.','2025/6/17','Released','https://store.steampowered.com/app/2066020/Soulstone_Survivors/?snr=1_7_7_230_150_9'),(432,'two_point_campus',NULL,'Build the university of your dreams with Two Point Campus, the sim with a twist from the makers of Two Point Hospital. Build, hire staff and run an academic institution packed with wild courses.','2022/8/9','Released','https://store.steampowered.com/app/1649080/Two_Point_Campus/?snr=1_7_7_230_150_9'),(433,'plague_inc:_evolved',NULL,'Plague Inc: Evolved is a unique mix of high strategy and terrifyingly realistic simulation. Your pathogen has just infected \'Patient Zero\' - now you must bring about the end of human history by evolving a deadly, global Plague whilst adapting against everything humanity can do to defend itself.','2016/2/18','Released','https://store.steampowered.com/app/246620/Plague_Inc_Evolved/?snr=1_7_7_230_150_9'),(434,'payday_2',NULL,'PAYDAY 2 is an action-packed, four-player co-op shooter that once again lets gamers don the masks of the original PAYDAY crew - Dallas, Hoxton, Wolf and Chains - as they descend on Washington DC for an epic crime spree.','2013/8/13','Released','https://store.steampowered.com/app/218620/PAYDAY_2/?snr=1_7_7_230_150_9'),(435,'omori',NULL,'Explore a strange world full of colorful friends and foes. When the time comes, the path you’ve chosen will determine your fate... and perhaps the fate of others as well.','2020/12/25','Released','https://store.steampowered.com/app/1150690/OMORI/?snr=1_7_7_230_150_9'),(436,'planet_zoo:_asia_animal_pack',NULL,'This content requires the base game Planet Zoo on Steam in order to play.','2025/6/25','Released','https://store.steampowered.com/app/3586990/Planet_Zoo_Asia_Animal_Pack/?snr=1_7_7_230_150_9'),(437,'star_trek_online',NULL,'In Star Trek Online, the Star Trek universe appears for the first time on a truly massive scale. Players take the captain\'s chair as they command their own starship and crew. Explore strange new worlds, seek out new life and new civilizations, and boldly go where no one has gone before.','2010/2/2','Released','https://store.steampowered.com/app/9900/Star_Trek_Online/?snr=1_7_7_230_150_9'),(438,'grim_dawn',NULL,'Enter an apocalyptic fantasy world where humanity is on the brink of extinction, iron is valued above gold and trust is hard earned. This ARPG features complex character development, hundreds of unique items, crafting and quests with choice & consequence.','2016/2/25','Released','https://store.steampowered.com/app/219990/Grim_Dawn/?snr=1_7_7_230_150_9'),(439,'infection_free_zone',NULL,'Choose any real region from the world. Choose your base of operations, then rebuild and readapt the buildings around you to create a self-sustaining settlement. Take charge of a group of survivors from your city. And when the night falls - Defend the zone from the infected!','2024/4/11','Released','https://store.steampowered.com/app/1465460/Infection_Free_Zone/?snr=1_7_7_230_150_9'),(440,'dinkum',NULL,'Dinkum is a survival life simulation game set on an island inspired by the rugged Australian outback. Farm, hunt, mine, fish, and forage to gather resources, expand your town, and discover what makes Dinkum so special—either solo or with friends.','2025/4/22','Released','https://store.steampowered.com/app/1062520/Dinkum/?snr=1_7_7_230_150_9'),(441,'the_headliners',NULL,'Co-op horror game where you play in teams of 1 to 8 reckless journalists, ready to explore a city overrun by deadly creatures to snap spectacular footage. Your only goal: make the headlines without becoming one.','2025/1/30','Released','https://store.steampowered.com/app/3059070/The_Headliners/?snr=1_7_7_230_150_9'),(442,'for_honor™',NULL,'Fight alone or with friends in For Honor, a third-person hero-based melee fighting game. Enter the chaos of war as a Knight, a Viking, a Samurai, a Wu Lin, or an Outlander. Fight in brutal PvP and team-oriented modes, or play the thrilling story campaign.','2024/3/14','Released','https://store.steampowered.com/app/304390/FOR_HONOR/?snr=1_7_7_230_150_9'),(443,'warhammer_40,000:_gladius_-_relics_of_war',NULL,'Warhammer 40,000: Gladius – Relics of War brings you to a world of terror and violence. Four factions will engage in a brutal war for dominance over the planet’s resources. In the first turn-based 4X strategy game set in Warhammer 40,000 you will lead one of four unique factions.','2018/7/12','Released','https://store.steampowered.com/app/489630/Warhammer_40000_Gladius__Relics_of_War/?snr=1_7_7_230_150_9'),(444,'slay_the_princess_—_the_pristine_cut',NULL,'You\'re here to slay the princess. Don\'t believe her lies.','2023/10/23','Released','https://store.steampowered.com/app/1989270/Slay_the_Princess__The_Pristine_Cut/?snr=1_7_7_230_150_9'),(445,'shin_megami_tensei_v:_vengeance',NULL,'Become a mighty demigod and battle through a decimated Tokyo in a war between angels and demons. Make new allies along your journey, engage in intense, turn-based combat, recruit hundreds of demons and forge your own path to dictate the fate of all existence.','2024/6/13','Released','https://store.steampowered.com/app/1875830/Shin_Megami_Tensei_V_Vengeance/?snr=1_7_7_230_150_10'),(446,'sifu',NULL,'Sifu is a realistic third-person brawler with tight Kung Fu combat mechanics and cinematic martial arts action embarking you on a path for revenge.','2023/3/28','Released','https://store.steampowered.com/app/2138710/Sifu/?snr=1_7_7_230_150_10'),(447,'battlefield™_1',NULL,'Battlefield™ 1 takes you back to The Great War, WW1, where new technology and worldwide conflict changed the face of warfare forever.','2016/10/20','Released','https://store.steampowered.com/app/1238840/Battlefield_1/?snr=1_7_7_230_150_10'),(448,'elite_dangerous',NULL,'Take control of your own starship in a cutthroat galaxy. Elite Dangerous is the definitive massively multiplayer space epic.','2015/4/2','Released','https://store.steampowered.com/app/359320/Elite_Dangerous/?snr=1_7_7_230_150_10'),(449,'conan_exiles',NULL,'An online multiplayer survival game, now with sorcery, set in the lands of Conan the Barbarian. Survive in a vast open world sandbox, build your home into a kingdom, and dominate your enemies in single or multiplayer.','2018/5/8','Released','https://store.steampowered.com/app/440900/Conan_Exiles/?snr=1_7_7_230_150_10'),(450,'total_war:_warhammer_iii_-_forge_of_the_chaos_dwarfs',NULL,'This content requires the base game Total War: WARHAMMER III on Steam in order to play.','2023/4/13','Released','https://store.steampowered.com/app/2059190/Total_War_WARHAMMER_III__Forge_of_the_Chaos_Dwarfs/?snr=1_7_7_230_150_10'),(451,'overcooked!_2',NULL,'Overcooked returns with a brand-new helping of chaotic cooking action! Journey back to the Onion Kingdom and assemble your team of chefs in classic couch co-op or online play for up to four players. Hold onto your aprons… it’s time to save the world again!','2018/8/7','Released','https://store.steampowered.com/app/728880/Overcooked_2/?snr=1_7_7_230_150_10'),(452,'transport_fever_2',NULL,'The classic transport simulation genre has a new gold standard with Transport Fever 2. Discover a whole new world by navigating transport routes through land, water and air. May progress and prosperity find their way!','2019/12/11','Released','https://store.steampowered.com/app/1066780/Transport_Fever_2/?snr=1_7_7_230_150_10'),(453,'the_midnight_walk',NULL,'Follow The Midnight Walk in a dark adventure from the minds behind Lost in Random. Befriend a lost lantern creature and light your way through a world of wonder and terror. Outsmart monsters and marvel at details in a landscape handcrafted with real clay and animated in a stop motion style.','2025/5/8','Released','https://store.steampowered.com/app/2863640/The_Midnight_Walk/?snr=1_7_7_230_150_10'),(454,'rooftops_&_alleys:_the_parkour_game',NULL,'In solo or with your friends, explore in total freedom massive-parkour-ready maps. Uncover hidden spots, time trials, trick challenges, and more! In multiplayer, dive into game modes like TAG, Capture The Flag, and Trick Battles!','2025/6/16','Released','https://store.steampowered.com/app/2703850/Rooftops__Alleys_The_Parkour_Game/?snr=1_7_7_230_150_10'),(455,'like_a_dragon:_infinite_wealth',NULL,'Two larger-than-life heroes, Ichiban Kasuga and Kazuma Kiryu are brought together by the hand of fate, or perhaps something more sinister… Live it up in Japan and explore all that Hawaii has to offer in an RPG adventure so big it spans the Pacific.','2024/1/25','Released','https://store.steampowered.com/app/2072450/Like_a_Dragon_Infinite_Wealth/?snr=1_7_7_230_150_10'),(456,'monster_hunter_rise',NULL,'Rise to the challenge and join the hunt! In Monster Hunter Rise, the latest installment in the award-winning and top-selling Monster Hunter series, you’ll become a hunter, explore brand new maps and use a variety of weapons to take down fearsome monsters as part of an all-new storyline.','2022/1/12','Released','https://store.steampowered.com/app/1446780/MONSTER_HUNTER_RISE/?snr=1_7_7_230_150_10'),(457,'subnautica:_below_zero',NULL,'Dive into a freezing underwater adventure on an alien planet. Below Zero is set two years after the original Subnautica. Return to Planet 4546B to uncover the truth behind a deadly cover-up. Survive by building habitats, crafting tools, & diving deeper into the world of Subnautica.','2021/5/13','Released','https://store.steampowered.com/app/848450/Subnautica_Below_Zero/?snr=1_7_7_230_150_10'),(458,'tactical_breach_wizards',NULL,'In Tactical Breach Wizards, you lead a team of renegade wizards in kevlar through turn-based battles to unravel a modern conspiracy plot. Combine their unique spells in clever ways, or rewind time to try every crazy plan you can think of to punch a Traffic Warlock through a 4th story window.','2024/8/22','Released','https://store.steampowered.com/app/1043810/Tactical_Breach_Wizards/?snr=1_7_7_230_150_10'),(459,'cyber_knights:_flashpoint',NULL,'Cyberpunk mercenaries RPG! Turn-based squad tactics with unique heist-planning strategy. Build your crew wisely; their stories will become interwoven with your own. Pull off heists with powerful cyberware, faction connections, multiclassing, weapon modding, stealth, hacking, and more!','2025/6/2','Released','https://store.steampowered.com/app/1021210/Cyber_Knights_Flashpoint/?snr=1_7_7_230_150_10'),(460,'ai_limit',NULL,'In the distant future when civilization is on the verge of extinction, people follow the legend of the Elysium in the last city, Havenswell. In this post-apocalyptic wasteland sci-fi ARPG, you will play as Arrisa, a Blader with immortality, and explore the city ruin to find the hope of a new life.','2025/3/27','Released','https://store.steampowered.com/app/2407270/AI_LIMIT/?snr=1_7_7_230_150_10'),(461,'blasphemous_2',NULL,'The Penitent One awakens as Blasphemous 2 joins him once again in an endless struggle against The Miracle. Dive into a perilous new world filled with mysteries and secrets to discover, and tear your way through monstrous foes that stand between you and your quest to end the cycle once and for all. ','2023/8/24','Released','https://store.steampowered.com/app/2114740/Blasphemous_2/?snr=1_7_7_230_150_10'),(462,'astroneer',NULL,'Interact with strange new worlds in a unique and tactile way, molding the environment itself as if it were clay in your hands. Build your base, master resource management, automate your production lines, and more as you unravel the mysteries of the universe, alone or with friends.','2016/12/16','Released','https://store.steampowered.com/app/361420/ASTRONEER/?snr=1_7_7_230_150_10'),(463,'warhammer:_vermintide_2',NULL,'The critically acclaimed Vermintide 2 is a visually stunning and groundbreaking melee action game pushing the boundaries of the first person co-op genre. Join the fight now!','2018/3/8','Released','https://store.steampowered.com/app/552500/Warhammer_Vermintide_2/?snr=1_7_7_230_150_10'),(464,'pacific_drive',NULL,'Face the supernatural dangers of the Olympic Exclusion Zone with a car as your only lifeline in this driving survival adventure! Scavenge resources, load up your trusty station wagon, and drive like hell to make it through alive.','2024/2/21','Released','https://store.steampowered.com/app/1458140/Pacific_Drive/?snr=1_7_7_230_150_10'),(465,'rimworld_-_ideology',NULL,'This content requires the base game RimWorld on Steam in order to play.','2021/7/20','Released','https://store.steampowered.com/app/1392840/RimWorld__Ideology/?snr=1_7_7_230_150_10'),(466,'marvel_snap',NULL,'MARVEL SNAP is a fast-paced Collectible Card Game that reimagines the genre with innovative mechanics. Winner of multiple awards like \'Best Strategy Game\' and \'Breakthrough Game of the Year,\' we invite you to join millions of players worldwide – Jump right in!','2023/8/22','Released','https://store.steampowered.com/app/1997040/MARVEL_SNAP/?snr=1_7_7_230_150_10'),(467,'blacksmith_master',NULL,'Manage your own medieval smithy in Blacksmith Master and supervise the entire process from mining ores and gems to designing and selling finished products. Forge everything from weapons and armor to tools and cooking utensils to fund your craft and become the Blacksmith Master.','2025/5/15','Released','https://store.steampowered.com/app/2292800/Blacksmith_Master/?snr=1_7_7_230_150_10'),(468,'dark_souls™:_remastered',NULL,'Then, there was fire. Re-experience the critically acclaimed, genre-defining game that started it all. Beautifully remastered, return to Lordran in stunning high-definition detail running at 60fps.','2018/5/23','Released','https://store.steampowered.com/app/570940/DARK_SOULS_REMASTERED/?snr=1_7_7_230_150_10'),(469,'motor_town:_behind_the_wheel',NULL,'Enjoy realistic driving in the open world. Relaxing cargo deliveries or driving buses and taxis will give you enough money to buy new cars and parts. You can test your driving skills at the race track. It\'s all about pure driving pleasure!','2021/12/17','Released','https://store.steampowered.com/app/1369670/Motor_Town_Behind_The_Wheel/?snr=1_7_7_230_150_10'),(470,'mafia:_definitive_edition',NULL,'An inadvertent brush with the mob thrusts cabdriver Tommy Angelo into the world of organized crime. Initially uneasy about falling in with the Salieri family, the rewards become too big to ignore.','2020/9/24','Released','https://store.steampowered.com/app/1030840/Mafia_Definitive_Edition/?snr=1_7_7_230_150_10'),(471,'gris',NULL,'Gris is a hopeful young girl lost in her own world, dealing with a painful experience in her life. Her journey through sorrow is manifested in her dress, which grants new abilities to better navigate her faded reality.','2018/12/13','Released','https://store.steampowered.com/app/683320/GRIS/?snr=1_7_7_230_150_10'),(472,'mx_bikes',NULL,'MX Bikes is a realistic motocross simulator, based on a scratch built physics engine that accurately simulates motorcycle dynamics and setup options.','2019/10/7','Released','https://store.steampowered.com/app/655500/MX_Bikes/?snr=1_7_7_230_150_10'),(473,'trailmakers',NULL,'Build the ultimate vehicle and explore a vast open world filled with challenges and adventure. Play solo or team up with friends in multiplayer to conquer the toughest obstacles. With a thrilling campaign mode and endless creative possibilities, Trailmakers is the ultimate sandbox for adventurers.','2019/9/18','Released','https://store.steampowered.com/app/585420/Trailmakers/?snr=1_7_7_230_150_10'),(474,'golf_with_your_friends',NULL,'Why have friends if not to play Golf... With Your Friends! Nothing is out of bounds as you take on courses filled with fast paced, exciting, simultaneous mini golf for up to 12 players!','2020/5/19','Released','https://store.steampowered.com/app/431240/Golf_With_Your_Friends/?snr=1_7_7_230_150_10'),(475,'portal_2',NULL,'The \"Perpetual Testing Initiative\" has been expanded to allow you to design co-op puzzles for you and your friends!','2011/4/18','Released','https://store.steampowered.com/app/620/Portal_2/?snr=1_7_7_230_150_10'),(476,'tony_hawk\'s™_pro_skater™_1_+_2',NULL,'Play the fully-remastered Tony Hawk’s™ Pro Skater™ & Tony Hawk’s™ Pro Skater™ 2 games in one epic collection, rebuilt from the ground up in incredible HD.','2023/10/3','Released','https://store.steampowered.com/app/2395210/Tony_Hawks_Pro_Skater_1__2/?snr=1_7_7_230_150_10'),(477,'dragon_age™:_the_veilguard',NULL,'Unite the Veilguard and defy the gods in Dragon Age™: The Veilguard, an immersive single-player RPG.','2024/10/31','Released','https://store.steampowered.com/app/1845910/Dragon_Age_The_Veilguard/?snr=1_7_7_230_150_10'),(478,'automation_-_the_car_company_tycoon_game',NULL,'Make your dream cars a reality with Automation’s unparalleled car and engine design tools. Gain a competitive edge through smart engineering and business decisions to help you build an automotive empire. Will you become an industry leader, or just a footnote in automotive history?','2015/3/12','Released','https://store.steampowered.com/app/293760/Automation__The_Car_Company_Tycoon_Game/?snr=1_7_7_230_150_10'),(479,'gas_station_simulator',NULL,'Buy an abandoned gas station and restore it to its full glory. Renovate, upgrade and expand upon the offered services to keep up with your clients demands.','2021/9/15','Released','https://store.steampowered.com/app/1149620/Gas_Station_Simulator/?snr=1_7_7_230_150_10'),(480,'resident_evil_3',NULL,'Jill Valentine is one of the last remaining people in Raccoon City to witness the atrocities Umbrella performed. To stop her, Umbrella unleashes their ultimate secret weapon: Nemesis! Also includes Resident Evil Resistance, a new 1 vs 4 online multiplayer game set in the Resident Evil universe.','2020/4/2','Released','https://store.steampowered.com/app/952060/Resident_Evil_3/?snr=1_7_7_230_150_10'),(481,'world_war_z',NULL,'World War Z is a heart-pounding coop third-person shooter for up to 4 players featuring massive swarms of hundreds of zombies, focused on fast-paced, gruesomely spectacular action.','2021/9/21','Released','https://store.steampowered.com/app/699130/World_War_Z/?snr=1_7_7_230_150_10'),(482,'frostpunk_2',NULL,'Develop, expand, and advance your city in a society survival game set 30 years after an apocalyptic blizzard ravaged Earth. In Frostpunk 2, you face not only the perils of never-ending winter, but also the powerful factions that watch your every step inside the Council Hall.','2024/9/20','Released','https://store.steampowered.com/app/1601580/Frostpunk_2/?snr=1_7_7_230_150_10'),(483,'assetto_corsa_evo',NULL,'Assetto Corsa EVO redefines the realism and features of one of the most popular multiplatform driving simulations ever developed. Featuring cars and tracks from different classes spanning across years of motoring history.','2025/1/16','Released','https://store.steampowered.com/app/3058630/Assetto_Corsa_EVO/?snr=1_7_7_230_150_10'),(484,'fbc:_firebreak',NULL,'A three-player cooperative first-person shooter set within a mysterious federal agency under assault by otherworldly forces.','2025/6/17','Released','https://store.steampowered.com/app/2272540/FBC_Firebreak/?snr=1_7_7_230_150_10'),(485,'sea_power_:_naval_combat_in_the_missile_age',NULL,'From the lead designer of Cold Waters, Sea Power lets you control NATO and Warsaw Pact forces in modern naval conflict campaigns. Use your advanced naval weaponry and sensors to respect rules of engagement and defeat the enemy forces in a tense fight for initiative and air/naval supremacy.','2024/11/12','Released','https://store.steampowered.com/app/1286220/Sea_Power__Naval_Combat_in_the_Missile_Age/?snr=1_7_7_230_150_10'),(486,'thank_goodness_you\'re_here!',NULL,'Thank Goodness You\'re Here! is an absurd comedy slapformer set in the bizarre Northern English town of Barnsworth. As a traveling salesman, take the time to see the sights and meet the locals, who are very eager to give you a series of increasingly odd jobs…','2024/8/1','Released','https://store.steampowered.com/app/2366980/Thank_Goodness_Youre_Here/?snr=1_7_7_230_150_10'),(487,'crusader_kings_iii:_tours_&_tournaments',NULL,'This content requires the base game Crusader Kings III on Steam in order to play.','2023/5/11','Released','https://store.steampowered.com/app/2311920/Crusader_Kings_III_Tours__Tournaments/?snr=1_7_7_230_150_10'),(488,'naraka:_bladepoint',NULL,'Dive into the legends of the Far East in NARAKA: BLADEPOINT; team up with friends in fast-paced melee fights for a Battle Royale experience unlike any other. Find your playstyle with a varied cast of heroes with unique skills. More than 20 million players have already joined the fray, play free now!','2021/8/11','Released','https://store.steampowered.com/app/1203220/NARAKA_BLADEPOINT/?snr=1_7_7_230_150_10'),(489,'easy_red_2',NULL,'Fight massive battles between infantry, armored vehicles, tanks, cannons and planes. Realistically manage your weapons and equipment, coordinate with your squad, and tactically navigate large, fully destructible open world maps. Experience the WW2 in singleplayer, PVP and Co-Op.','2020/11/10','Released','https://store.steampowered.com/app/1324780/Easy_Red_2/?snr=1_7_7_230_150_10'),(490,'papers,_please',NULL,'Congratulations. The October labor lottery is complete. Your name was pulled. For immediate placement, report to the Ministry of Admission at Grestin Border Checkpoint. An apartment will be provided for you and your family in East Grestin. Expect a Class-8 dwelling.','2013/8/8','Released','https://store.steampowered.com/app/239030/Papers_Please/?snr=1_7_7_230_150_10'),(491,'pathfinder:_wrath_of_the_righteous_-_enhanced_edition',NULL,'Embark on a journey to a realm overrun by demons in a new epic RPG from the creators of the critically acclaimed Pathfinder: Kingmaker. Explore the nature of good and evil, learn the true cost of power, and rise as a Mythic Hero capable of deeds beyond mortal expectations.','2021/9/2','Released','https://store.steampowered.com/app/1184370/Pathfinder_Wrath_of_the_Righteous__Enhanced_Edition/?snr=1_7_7_230_150_10'),(492,'aimlabs',NULL,'Aimlabs is the aim trainer of choice for over 40 Million players, from beginners to esports pros. Our unique aim analysis optimizes your gameplay, targets your weaknesses & builds key skills for any FPS game! Time to warm up with our unlimited scenarios & rank up in-game!','2023/6/16','Released','https://store.steampowered.com/app/714010/Aimlabs/?snr=1_7_7_230_150_10'),(493,'ready_or_not:_home_invasion',NULL,'This content requires the base game Ready or Not on Steam in order to play.','2024/7/23','Released','https://store.steampowered.com/app/3015760/Ready_or_Not_Home_Invasion/?snr=1_7_7_230_150_10'),(494,'animal_well',NULL,'Explore a dense, interconnected labyrinth, and unravel its many secrets. Collect items to manipulate your environment in surprising and meaningful ways. Encounter beautiful and unsettling creatures, as you attempt to survive what lurks in the dark. There is more than what you see.','2024/5/9','Released','https://store.steampowered.com/app/813230/ANIMAL_WELL/?snr=1_7_7_230_150_11'),(495,'police_simulator:_patrol_officers',NULL,'Welcome to Brighton! Join the police force of this fictitious American city and experience the day to day life of a police officer.','2022/11/10','Released','https://store.steampowered.com/app/997010/Police_Simulator_Patrol_Officers/?snr=1_7_7_230_150_11'),(496,'warhammer_40,000:_rogue_trader_-_lex_imperialis',NULL,'This content requires the base game Warhammer 40,000: Rogue Trader on Steam in order to play.','2025/6/24','Released','https://store.steampowered.com/app/3622820/Warhammer_40000_Rogue_Trader__Lex_Imperialis/?snr=1_7_7_230_150_11'),(497,'beat_saber',NULL,'Beat Saber is a VR rhythm game where you slash the beats of adrenaline-pumping music as they fly towards you, surrounded by a futuristic world.','2019/5/21','Released','https://store.steampowered.com/app/620980/Beat_Saber/?snr=1_7_7_230_150_11'),(498,'ufo_50',NULL,'UFO 50 is a collection of 50 single and multiplayer games that span a variety of genres, from platformers and shoot \'em ups to puzzle games, roguelites, and RPGs. Our goal is to combine a familiar 8-bit aesthetic with new ideas and modern game design.','2024/9/18','Released','https://store.steampowered.com/app/1147860/UFO_50/?snr=1_7_7_230_150_11'),(499,'into_the_dead:_our_darkest_days',NULL,'Texas, 1980. Walton City has fallen to a zombie outbreak. Lead a band of desperate survivors from refuge to refuge by scavenging, crafting, and fighting in a relentless struggle for survival. Plan wisely, stick together, and — above all — keep moving if you want to make it out alive.','2025/4/9','Released','https://store.steampowered.com/app/2239710/Into_the_Dead_Our_Darkest_Days/?snr=1_7_7_230_150_11'),(500,'rimworld_-_royalty',NULL,'This content requires the base game RimWorld on Steam in order to play.','2020/2/24','Released','https://store.steampowered.com/app/1149640/RimWorld__Royalty/?snr=1_7_7_230_150_11'),(501,'pummel_party',NULL,'Pummel Party is a 4-8 player online and local-multiplayer party game. Pummel friends or AI using a wide array of absurd items in the board mode and compete to destroy friendships in the unique collection of minigames.','2018/9/20','Released','https://store.steampowered.com/app/880940/Pummel_Party/?snr=1_7_7_230_150_11'),(502,'tom_clancy\'s_ghost_recon®_wildlands',NULL,'Create a team with up to 3 friends in Tom Clancy’s Ghost Recon® Wildlands and enjoy the ultimate military shooter experience set in a massive, dangerous, and responsive open world.','2017/3/6','Released','https://store.steampowered.com/app/460930/Tom_Clancys_Ghost_Recon_Wildlands/?snr=1_7_7_230_150_11'),(503,'assassin’s_creed®_iv_black_flag™',NULL,'The year is 1715. Pirates rule the Caribbean and have established their own lawless Republic where corruption, greediness and cruelty are commonplace.Among these outlaws is a brash young captain named Edward Kenway.',NULL,NULL,'https://store.steampowered.com/app/242050/Assassins_Creed_IV_Black_Flag/?snr=1_7_7_230_150_11'),(504,'door_kickers_2:_task_force_north',NULL,'Command military Special Ops Teams in gripping tactical combat against a Middle East-based terrorist network. Sequel to RockPaperShotgun\'s \"Best Tactics Game of 2014\".','2025/2/10','Released','https://store.steampowered.com/app/1239080/Door_Kickers_2_Task_Force_North/?snr=1_7_7_230_150_11'),(505,'mechwarrior_5:_clans',NULL,'In MECHWARRIOR 5: CLANS, players become new Smoke Jaguar pilots in the Clan Invasion of the Inner Sphere. Lead a five-mech \"Star\" squad across diverse planets, engaging in an expansive campaign with immersive gameplay and intricate combat. Customize BattleMechs and explore strategic options.','2024/10/16','Released','https://store.steampowered.com/app/2000890/MechWarrior_5_Clans/?snr=1_7_7_230_150_11'),(506,'raidou_remastered:_the_mystery_of_the_soulless_army',NULL,'The story of apprentice detective and Devil Summoner extraordinaire Raidou Kuzunoha XIV returns in this remastered classic! Call upon your demons to solve supernatural mysteries and dispose of enemies.','2025/6/18','Released','https://store.steampowered.com/app/2288350/RAIDOU_Remastered_The_Mystery_of_the_Soulless_Army/?snr=1_7_7_230_150_11'),(507,'the_crew_motorfest',NULL,'Welcome to Motorfest, the ultimate open-world driving experience. Explore the Hawaiian islands of O\'ahu and Maui. Celebrate the best of car culture through 20+ themed campaigns (street racing, offroad, drift...) and collect hundreds of iconic vehicles. Enjoy the game free for five hours!','2024/4/18','Released','https://store.steampowered.com/app/2698940/The_Crew_Motorfest/?snr=1_7_7_230_150_11'),(508,'starvaders',NULL,'Pilot a powerful mech to fight off the alien invasion in this ULTIMATE fusion of deckbuilding and grid-based tactics. Discover game-breaking combos, rewind time to alter your fate, and protect the future of humanity in this endlessly replayable roguelike.','2025/4/30','Released','https://store.steampowered.com/app/2097570/StarVaders/?snr=1_7_7_230_150_11'),(509,'like_a_dragon:_pirate_yakuza_in_hawaii',NULL,'Embark on an over-the-top, modern-day pirate adventure with an ex-yakuza, now pirate captain & his crew. Engage in exhilarating combat on land and sea in the hunt for lost memories and treasure.','2025/2/20','Released','https://store.steampowered.com/app/3061810/Like_a_Dragon_Pirate_Yakuza_in_Hawaii/?snr=1_7_7_230_150_11'),(510,'lightyear_frontier',NULL,'In Lightyear Frontier you use your powerful trusty mech to farm on a large beautiful alien planet. Settle your homestead, farm and deliver produce to remote colonies, gather and manage resources, build, craft, explore, expand, improve your mech, meet neighbors, and make a place to call your own.','2024/3/19','Released','https://store.steampowered.com/app/1677110/Lightyear_Frontier/?snr=1_7_7_230_150_11'),(511,'omsi_2:_steam_edition',NULL,'Off to the next round! Experience a new omnibus simulator with OMSI 2 and start discovering Spandau while driving the omnibus. OMSI 2 is the successor of the well-known and awarded omnibus simulator \"OMSI - The Bus Simulator\".','2013/12/11','Released','https://store.steampowered.com/app/252530/OMSI_2_Steam_Edition/?snr=1_7_7_230_150_11'),(512,'luma_island',NULL,'Get ready to farm, explore, raise Lumas, solve puzzles, and embark on quests across Luma Island! This vibrant 1-4 player co-op game offers Cozy, Adventure, or Hero modes for every type of player. Dive into the FREE Pirates update for treasure hunts, pirate mischief, and exciting mini-games!','2024/11/20','Released','https://store.steampowered.com/app/2408820/Luma_Island/?snr=1_7_7_230_150_11'),(513,'insurgency:_sandstorm',NULL,'Insurgency: Sandstorm is a team-based, tactical FPS based on lethal close quarters combat and objective-oriented multiplayer gameplay. Experience the intensity of modern combat where skill is rewarded, and teamwork wins the fight.','2018/12/12','Released','https://store.steampowered.com/app/581320/Insurgency_Sandstorm/?snr=1_7_7_230_150_11'),(514,'among_us',NULL,'An online and local party game of teamwork and betrayal for 4-15 players...in space!','2018/11/16','Released','https://store.steampowered.com/app/945360/Among_Us/?snr=1_7_7_230_150_11'),(515,'cubic_odyssey',NULL,'Embark on a galactic journey in Cubic Odyssey, an open-world adventure where you explore vibrant planets, craft tools, build vehicles, and fight the Red Darkness. Uncover ancient mysteries, and shape a universe full of life, danger, and limitless possibilities!','2025/5/14','Released','https://store.steampowered.com/app/3400000/Cubic_Odyssey/?snr=1_7_7_230_150_11'),(516,'splitgate_2',NULL,'Splitgate 2 is the only free-to-play shooter with portals, delivering next-level gunplay, fluid movement, and a constantly evolving experience, featuring a new Battle Royale where you can portal between unique worlds. Welcome to the future of sport.','2025/5/22','Released','https://store.steampowered.com/app/2918300/Splitgate_2/?snr=1_7_7_230_150_11'),(517,'crypt_of_the_necrodancer',NULL,'Crypt of the NecroDancer is an award winning hardcore roguelike rhythm game. Move to the music and deliver beatdowns to the beat! Groove to the epic Danny Baranowsky soundtrack, or select songs from your own MP3 collection!','2015/4/23','Released','https://store.steampowered.com/app/247080/Crypt_of_the_NecroDancer/?snr=1_7_7_230_150_11'),(518,'potion_craft:_alchemist_simulator',NULL,'Potion Craft is an alchemist simulator where you physically interact with your tools and ingredients to brew potions. You\'re in full control of the whole shop: invent new recipes, attract customers and experiment to your heart\'s content. Just remember: the whole town is counting on you.','2022/12/13','Released','https://store.steampowered.com/app/1210320/Potion_Craft_Alchemist_Simulator/?snr=1_7_7_230_150_11'),(519,'geometry_dash',NULL,'Jump and fly your way through danger in this rhythm-based action platformer!','2014/12/22','Released','https://store.steampowered.com/app/322170/Geometry_Dash/?snr=1_7_7_230_150_11'),(520,'russian_fishing_4',NULL,'Russian Fishing 4 is a fishing simulator with RPG elements. There is no story line and the whole process is based on the concept of an open, free to roam and free to play game.','2021/11/10','Released','https://store.steampowered.com/app/766570/Russian_Fishing_4/?snr=1_7_7_230_150_11'),(521,'white_knuckle',NULL,'White Knuckle is a first-person roguelite speed-climbing game. Ascend through the guts of SUB-STRUCTURE 17 using precision movement mechanics. Sharp reflexes and resource management will bring you out from under ten thousand meters of concrete and decay.','2025/4/17','Released','https://store.steampowered.com/app/3195790/White_Knuckle/?snr=1_7_7_230_150_11'),(522,'content_warning',NULL,'Film your friends doing scary things to become SpöökTube famous! (strongly advised to not go alone)','2024/4/1','Released','https://store.steampowered.com/app/2881650/Content_Warning/?snr=1_7_7_230_150_11'),(523,'tropico_6',NULL,'El Presidente is back! Prove yourself once again as a feared dictator or peace-loving statesman on the island state of Tropico and shape the fate of your very own banana republic through four distinctive eras.','2019/3/29','Released','https://store.steampowered.com/app/492720/Tropico_6/?snr=1_7_7_230_150_11'),(524,'expansion_-_hearts_of_iron_iv:_götterdämmerung',NULL,'This content requires the base game Hearts of Iron IV on Steam in order to play.','2024/11/14','Released','https://store.steampowered.com/app/3152780/Expansion__Hearts_of_Iron_IV_Gtterdmmerung/?snr=1_7_7_230_150_11'),(525,'total_war:_pharaoh',NULL,'In Total War: PHARAOH, the newest entry in the award-winning grand strategy series, immerse yourself in ancient Egypt at the zenith of its power and experience the dramatic events that threaten its destruction.','2023/10/11','Released','https://store.steampowered.com/app/1937780/Total_War_PHARAOH/?snr=1_7_7_230_150_11'),(526,'the_sims™_4_cats_&_dogs',NULL,'This content requires the base game The Sims™ 4 on Steam in order to play.','2017/11/9','Released','https://store.steampowered.com/app/1235721/The_Sims_4_Cats__Dogs/?snr=1_7_7_230_150_11'),(527,'smite_2',NULL,'Become a god and wage war in SMITE 2, the free-to-play Unreal Engine 5-powered sequel to the legendary third-person action MOBA. If you love challenging competition, intense action, ability-driven combat, rewarding teamwork, or godly mythology, you’ll see why 40+ million players love SMITE.','2024/8/27','Released','https://store.steampowered.com/app/2437170/SMITE_2/?snr=1_7_7_230_150_11'),(528,'look_outside',NULL,'Look Outside is a survival horror RPG set in a single apartment building. A mysterious event turns anyone who looks out the window into grotesque monsters, leaving the world in absolute chaos. Scavenge the building to seek food, supplies, and weapons while encountering strange characters.','2025/3/21','Released','https://store.steampowered.com/app/3373660/Look_Outside/?snr=1_7_7_230_150_11'),(529,'granblue_fantasy:_relink',NULL,'A grand adventure in the skies awaits! Form a party of four from a diverse roster of skyfarers and slash—or shoot or hex—your way to victory against treacherous foes in this action RPG. Take on quests solo or with the help of others in up to 4-player co-op play!','2024/1/31','Released','https://store.steampowered.com/app/881020/Granblue_Fantasy_Relink/?snr=1_7_7_230_150_11'),(530,'f1®_manager_2024',NULL,'Lead your team to glory in F1® Manager 2024. A new Formula 1® season has arrived, and with it, the most comprehensive F1® management experience to date. Build a legacy with one of 10 official F1® constructors or create your own team for the very first time.','2024/7/23','Released','https://store.steampowered.com/app/2591280/F1_Manager_2024/?snr=1_7_7_230_150_11'),(531,'poppy_playtime',NULL,'You must stay alive in this horror/puzzle adventure. Try to survive the vengeful toys waiting for you in the abandoned toy factory. Use your GrabPack to hack electrical circuits or nab anything from afar. Explore the mysterious facility... and don\'t get caught.','2021/10/12','Released','https://store.steampowered.com/app/1721470/Poppy_Playtime/?snr=1_7_7_230_150_11'),(532,'jurassic_world_evolution_2:_dominion_biosyn_expansion',NULL,'This content requires the base game Jurassic World Evolution 2 on Steam in order to play.','2022/6/14','Released','https://store.steampowered.com/app/1966010/Jurassic_World_Evolution_2_Dominion_Biosyn_Expansion/?snr=1_7_7_230_150_11'),(533,'outlast',NULL,'Hell is an experiment you can\'t survive in Outlast, a first-person survival horror game developed by veterans of some of the biggest game franchises in history. As investigative journalist Miles Upshur, explore Mount Massive Asylum and try to survive long enough to discover its terrible secret... if you dare.','2013/9/4','Released','https://store.steampowered.com/app/238320/Outlast/?snr=1_7_7_230_150_11'),(534,'control_ultimate_edition',NULL,'Winner of over 80 awards, Control is a visually stunning third-person action-adventure that will keep you on the edge of your seat.','2020/8/27','Released','https://store.steampowered.com/app/870780/Control_Ultimate_Edition/?snr=1_7_7_230_150_11'),(535,'monster_prom_4:_monster_con',NULL,'Can you find love at the nerdiest convention ever? \"Monster Con\" goes back to the multiplayer dating sim formula: go through absurd and funny situations as you find love among six sexy monsters! Who will you romance? The mimic who cosplays? The idol clown? Or the eldritch cutie? (There\'s also Liam)','2025/4/24','Released','https://store.steampowered.com/app/2869860/Monster_Prom_4_Monster_Con/?snr=1_7_7_230_150_11'),(536,'prison_architect',NULL,'Only the world’s most ruthless Warden can contain the world’s most ruthless inmates. Design and develop your personalized penitentiary in Prison Architect.','2015/10/6','Released','https://store.steampowered.com/app/233450/Prison_Architect/?snr=1_7_7_230_150_11'),(537,'icarus',NULL,'ICARUS is a PvE survival game for up to eight players. Explore a savage wilderness in the aftermath of terraforming gone wrong. Survive the Open World, complete timed Missions or build your Outpost. Explore, build, craft and hunt while seeking your fortune and prospecting for exotic matter.','2021/12/3','Released','https://store.steampowered.com/app/1149460/ICARUS/?snr=1_7_7_230_150_11'),(538,'little_nightmares',NULL,'Take on the role of Six, a lone child lost in a massive metal vessel known as the Maw, surrounded by dangerous, distorted versions of adults. You’ll need to do your best to escape in one piece or your fate will be worse than you ever dared dream.','2017/4/27','Released','https://store.steampowered.com/app/424840/Little_Nightmares/?snr=1_7_7_230_150_11'),(539,'vtol_vr',NULL,'VTOL VR is a near-futuristic combat flight game built for Virtual Reality. Pilot advanced multi-role jets, using your hands to flip switches, press buttons, and manipulate the virtual flight controls.','2017/8/3','Released','https://store.steampowered.com/app/667970/VTOL_VR/?snr=1_7_7_230_150_11'),(540,'gunfire_reborn',NULL,'Gunfire Reborn is a level-based adventure game featuring FPS, Roguelite and RPG. Players can control heroes with various abilities to experience diverse Build gameplay, use various weapons to explore procedurally-generated levels. You can play the game alone, or join 4-player coop.','2021/11/17','Released','https://store.steampowered.com/app/1217060/Gunfire_Reborn/?snr=1_7_7_230_150_11'),(541,'battlefield™_v',NULL,'This is the ultimate Battlefield V experience. Enter mankind’s greatest conflict with the complete arsenal of weapons, vehicles, and gadgets plus the best customization content of Year 1 and 2.','2018/11/9','Released','https://store.steampowered.com/app/1238810/Battlefield_V/?snr=1_7_7_230_150_11'),(542,'the_elder_scrolls_v:_skyrim_anniversary_upgrade',NULL,'This content requires the base game The Elder Scrolls V: Skyrim Special Edition on Steam in order to play.','2021/11/10','Released','https://store.steampowered.com/app/1746860/The_Elder_Scrolls_V_Skyrim_Anniversary_Upgrade/?snr=1_7_7_230_150_11'),(543,'until_dawn™',NULL,'Rebuilt and enhanced for PC – Until Dawn invites you to relive the nightmare, and immerse yourself in a gripping slasher horror where every decision can make the difference between life and death.','2024/10/4','Released','https://store.steampowered.com/app/2172010/Until_Dawn/?snr=1_7_7_230_150_12'),(544,'lost_records:_bloom_&_rage',NULL,'Embark on a new narrative journey by the creators of Life is Strange. Film your summer of 1995 and create memories of a lifetime with your new friends. 27 years later, confront the dark secrets that made you all promise to never speak again after that fateful summer.','2025/2/18','Released','https://store.steampowered.com/app/1902960/Lost_Records_Bloom__Rage/?snr=1_7_7_230_150_12'),(545,'high_on_life',NULL,'HIGH ON KNIFE DLC OUT NOW!! - Humanity is being threatened by an alien cartel who wants to use them as drugs. It’s up to you to rescue and partner with charismatic, talking guns, take down Garmantuous and his gang, and save the world!','2022/12/13','Released','https://store.steampowered.com/app/1583230/High_On_Life/?snr=1_7_7_230_150_12'),(546,'furi',NULL,'The jailer is the key, kill him and you’ll be free. Fight your way free in this ultra-responsive, fast-paced sword-fighting and dual-stick shooting game.','2016/7/5','Released','https://store.steampowered.com/app/423230/Furi/?snr=1_7_7_230_150_12'),(547,'halo_infinite',NULL,'From one of gaming\'s most iconic sagas, Halo is bigger than ever. Featuring an expansive open-world campaign and a dynamic free to play multiplayer experience. ','2021/11/15','Released','https://store.steampowered.com/app/1240440/Halo_Infinite/?snr=1_7_7_230_150_12'),(548,'rise_of_the_tomb_raider™',NULL,'Rise of the Tomb Raider: 20 Year Celebration includes the base game and Season Pass featuring all-new content. Explore Croft Manor in the new “Blood Ties” story, then defend it against a zombie invasion in “Lara’s Nightmare”.','2016/2/9','Released','https://store.steampowered.com/app/391220/Rise_of_the_Tomb_Raider/?snr=1_7_7_230_150_12'),(549,'mouthwashing',NULL,'The five crew members of the Tulpar are stranded in the empty reaches of space, shrouded in perpetual sunset. God is not watching.','2024/9/26','Released','https://store.steampowered.com/app/2475490/Mouthwashing/?snr=1_7_7_230_150_12'),(550,'ravenswatch',NULL,'Fallen heroes of old folk tales and legends: you are on the verge of a crucial battle against the Nightmare invading and corrupting your world. A roguelike action game from the creators of Curse of the Dead Gods©, playable solo or in online co-op.','2024/9/26','Released','https://store.steampowered.com/app/2071280/Ravenswatch/?snr=1_7_7_230_150_12'),(551,'shadow_gambit:_the_cursed_crew',NULL,'Assemble your crew and set sail on an infamous ghost ship to sneak, stab, and spellcast your way through the Inquisition in this non-linear stealth strategy game. Chart a course, develop uncanny abilities, and use unconventional tactics to find a powerful pirate artifact!','2023/8/17','Released','https://store.steampowered.com/app/1545560/Shadow_Gambit_The_Cursed_Crew/?snr=1_7_7_230_150_12'),(552,'warhammer_40,000:_boltgun',NULL,'Load up your Boltgun and unleash the awesome Space Marine arsenal to blast your way through an explosion of sprites, pixels and blood in a perfect blend of Warhammer 40,000, frenetic gameplay and the stylish visuals of 90’s retro shooters.','2023/5/23','Released','https://store.steampowered.com/app/2005010/Warhammer_40000_Boltgun/?snr=1_7_7_230_150_12'),(553,'sins_of_a_solar_empire_ii',NULL,'Battle for galactic dominance in this real-time 4X strategy game with unrivaled scale! You’ll explore, expand, exploit, and exterminate through military force, diplomacy, trade, culture, influence, and other underhanded tactics.','2024/8/15','Released','https://store.steampowered.com/app/1575940/Sins_of_a_Solar_Empire_II/?snr=1_7_7_230_150_12'),(554,'tomb_raider_iv-vi_remastered',NULL,'Her legacy lives on! Play the next series of Tomb Raider adventures in this remastered collection of Lara Croft\'s darkest adventures.','2025/2/14','Released','https://store.steampowered.com/app/2525380/Tomb_Raider_IVVI_Remastered/?snr=1_7_7_230_150_12'),(555,'aneurism_iv',NULL,'A dystopian simulator where your choices shape a decaying city. Join other players to protect the metropolis from ruin, hasten its downfall, or simply work in the factories. With no set goals or rules, every action has consequences in a world teetering on the brink.','2025/3/11','Released','https://store.steampowered.com/app/2773280/ANEURISM_IV/?snr=1_7_7_230_150_12'),(556,'kindergarten_2',NULL,'Welcome to Kindergarten 2, which takes place on Tuesday! After the events of Monday, you\'ll find yourself in a new school with new friends...and new ways to get ruthlessly murdered.','2019/7/29','Released','https://store.steampowered.com/app/1067850/Kindergarten_2/?snr=1_7_7_230_150_12'),(557,'tunic',NULL,'Explore a land filled with lost legends, ancient powers, and ferocious monsters in TUNIC, an isometric action game about a small fox on a big adventure.','2022/3/16','Released','https://store.steampowered.com/app/553420/TUNIC/?snr=1_7_7_230_150_12'),(558,'ark:_astraeos',NULL,'This content requires the base game ARK: Survival Ascended on Steam in order to play.','2025/2/13','Released','https://store.steampowered.com/app/3483400/ARK_Astraeos/?snr=1_7_7_230_150_12'),(559,'mechwarrior_5:_mercenaries',NULL,'The year is 3015. The battlefields are dominated by war machines known as BattleMechs. Level entire cities and decimate the enemy in your BattleMech. Follow a quest for glory and revenge. Manage an expanding mercenary company. Fight alongside your friends with a four-player PvE co-op.','2021/5/26','Released','https://store.steampowered.com/app/784080/MechWarrior_5_Mercenaries/?snr=1_7_7_230_150_12'),(560,'the_slormancer',NULL,'Fight hordes of enemies led by The Slormancer, an evil warlock from the past, in an absurd yet epic Action RPG! Experience fast-paced gameplay, loads of shiny loot, tons of collectibles, countless hours of content, and carefully crafted pixel art.','2025/5/13','Released','https://store.steampowered.com/app/1104280/The_Slormancer/?snr=1_7_7_230_150_12'),(561,'witchfire',NULL,'Witchfire is a first-person dark fantasy RPG shooter in which you play as a wicked sinner turned witch hunter on his final mission to reach salvation.','2024/9/23','Released','https://store.steampowered.com/app/3156770/Witchfire/?snr=1_7_7_230_150_12'),(562,'assassin\'s_creed_mirage',NULL,'Become a deadly Master Assassin in this action-adventure game. Explore the streets of ninth-century Baghdad through the eyes of Basim. Take down your targets while seeking justice as part of the Hidden Ones.','2024/10/17','Released','https://store.steampowered.com/app/3035570/Assassins_Creed_Mirage/?snr=1_7_7_230_150_12'),(563,'ride_5',NULL,'Rev up your engine and get ready to hit the track with RIDE 5. An adrenaline-filled gaming experience that is so authentic it will make you feel like you\'re truly racing at break-neck speed.','2023/8/24','Released','https://store.steampowered.com/app/1650010/RIDE_5/?snr=1_7_7_230_150_12'),(564,'out_of_ore',NULL,'A casual heavy equipment experience. Mine ore, Move dirt, Build and repair.','2022/10/31','Released','https://store.steampowered.com/app/2009350/Out_of_Ore/?snr=1_7_7_230_150_12'),(565,'against_the_storm',NULL,'A dark fantasy city builder where you must rebuild civilization in the face of apocalyptic rains. As the Queen’s Viceroy, lead humans, beavers, lizards, foxes, and harpies to reclaim the wilderness and secure a future for civilization\'s last survivors.','2023/12/8','Released','https://store.steampowered.com/app/1336490/Against_the_Storm/?snr=1_7_7_230_150_12'),(566,'gorilla_tag',NULL,'Run, jump, and climb using only your hands. Play tag or infection with people online. Run away from the infected players, or outmaneuver the survivors to catch them. Embrace your inner ape.','2023/1/1','Released','https://store.steampowered.com/app/1533390/Gorilla_Tag/?snr=1_7_7_230_150_12'),(567,'shadowverse:_worlds_beyond',NULL,'Shadowverse: Worlds Beyond is a brand-new strategy card game from the popular Shadowverse CCG. With the newly added super-evolution mechanic and Shadowverse Park, among other brand-new content, there is lots to enjoy for both seasoned and brand-new players.','2025/6/14','Released','https://store.steampowered.com/app/2584990/Shadowverse_Worlds_Beyond/?snr=1_7_7_230_150_12'),(568,'total_war:_warhammer_iii_-_skulltaker_–_omens_of_destruction',NULL,'This content requires the base game Total War: WARHAMMER III on Steam in order to play.','2024/12/12','Released','https://store.steampowered.com/app/3130750/Total_War_WARHAMMER_III__Skulltaker__Omens_of_Destruction/?snr=1_7_7_230_150_12'),(569,'thehunter:_call_of_the_wild™_-_alberta_hunting_preserve',NULL,'This content requires the base game theHunter: Call of the Wild™ on Steam in order to play.','2025/6/17','Released','https://store.steampowered.com/app/3570290/theHunter_Call_of_the_Wild__Alberta_Hunting_Preserve/?snr=1_7_7_230_150_12'),(570,'core_keeper',NULL,'Explore a vast cavern of creatures, relics and resources in a mining sandbox adventure for 1-8 players. Mine, build, fight, craft and farm to unravel the mystery of the ancient Core.','2024/8/27','Released','https://store.steampowered.com/app/1621690/Core_Keeper/?snr=1_7_7_230_150_12'),(571,'signalis',NULL,'A classic survival horror experience set in a dystopian future where humanity has uncovered a dark secret. Unravel a cosmic mystery, escape terrifying creatures, and scavenge an off-world government facility as Elster, a technician Replika searching for her lost dreams.','2022/10/27','Released','https://store.steampowered.com/app/1262350/SIGNALIS/?snr=1_7_7_230_150_12'),(572,'call_of_duty®:_modern_warfare®',NULL,'Experience a visceral Campaign or assemble your team in the ultimate online playground with multiple Special Ops challenges and a mix of Multiplayer maps and modes.','2023/3/8','Released','https://store.steampowered.com/app/2000950/Call_of_Duty_Modern_Warfare/?snr=1_7_7_230_150_12'),(573,'my_time_at_sandrock',NULL,'Travel to the desert community of Sandrock and take on the role of a fledgling Builder. Use your trusty toolset to gather resources, construct machines, and turn your run-down workshop into a well-oiled production facility to save the town from the jaws of economic ruin!','2023/11/2','Released','https://store.steampowered.com/app/1084600/My_Time_at_Sandrock/?snr=1_7_7_230_150_12'),(574,'the_long_drive',NULL,'Random generated open world semi-post apocalyptic survival car driving game.','2019/9/25','Released','https://store.steampowered.com/app/1017180/The_Long_Drive/?snr=1_7_7_230_150_12'),(575,'call_of_duty®:_infinite_warfare',NULL,'Infinite Warfare delivers three unique game modes: Campaign, Multiplayer, and Zombies.','2016/11/3','Released','https://store.steampowered.com/app/292730/Call_of_Duty_Infinite_Warfare/?snr=1_7_7_230_150_12'),(576,'nice_day_for_fishing',NULL,'The world needs you Adventurer! Embark on an RPG pixel adventure where you’ll play as Baelin the humble fisherman, who must rise-up to become the hero of Honeywood. Battle fish with precision timing and magic spells, upgrade your abilities, defeat evil and rebuild Honeywood.','2025/5/29','Released','https://store.steampowered.com/app/2393160/Nice_Day_for_Fishing/?snr=1_7_7_230_150_12'),(577,'risk_of_rain_2:_survivors_of_the_void',NULL,'This content requires the base game Risk of Rain 2 on Steam in order to play.','2022/3/1','Released','https://store.steampowered.com/app/1607890/Risk_of_Rain_2_Survivors_of_the_Void/?snr=1_7_7_230_150_12'),(578,'escape_the_backrooms',NULL,'Escape the Backrooms is a 1-4 player co-op horror exploration game. Traverse through eerie backrooms levels while avoiding entities and other danger to try and escape. Free content updates with new levels and game modes keep the community rewarded.','2022/8/11','Released','https://store.steampowered.com/app/1943950/Escape_the_Backrooms/?snr=1_7_7_230_150_12'),(579,'darkest_dungeon®_ii',NULL,'Darkest Dungeon II is a roguelike road trip of the damned. Form a party, equip your stagecoach, and set off across the decaying landscape on a last gasp quest to avert the apocalypse. The greatest dangers you face, however, may come from within...','2023/5/8','Released','https://store.steampowered.com/app/1940340/Darkest_Dungeon_II/?snr=1_7_7_230_150_12'),(580,'six_days_in_fallujah',NULL,'NEW! Play solo with an AI fireteam or co-op online. Six Days in Fallujah is an intensely realistic first-person tactical shooter based on true stories from one of this century’s toughest urban battles.','2023/6/22','Released','https://store.steampowered.com/app/1548850/Six_Days_in_Fallujah/?snr=1_7_7_230_150_12'),(581,'jurassic_world_evolution_3',NULL,'Pre-Purchase now to unlock the Badlands Set at launch. Build your own Jurassic World. Nurture generations of dinosaurs with the series debut of juveniles, create and manage sprawling prehistoric parks around the globe, and let your imagination roar with powerful new creative options.','2025/10/21','Unreleased','https://store.steampowered.com/app/2958130/Jurassic_World_Evolution_3/?snr=1_7_7_230_150_12'),(582,'keep_driving',NULL,'An atmospheric management RPG about life on the open road. Pick up hitchhikers, work odd jobs, customize and repair your car, and map your route across the country. Use upgrades, skills and items to overcome challenges. And remember to take it easy. You’re young. You have time.','2025/2/6','Released','https://store.steampowered.com/app/2756920/Keep_Driving/?snr=1_7_7_230_150_12'),(583,'victoria_3:_sphere_of_influence',NULL,'This content requires the base game Victoria 3 on Steam in order to play.','2024/6/24','Released','https://store.steampowered.com/app/2411231/Victoria_3_Sphere_of_Influence/?snr=1_7_7_230_150_12'),(584,'sultan\'s_game',NULL,'The Sultan commands you to play a cruel game. Each week you draw a card, and have to complete its challenge within seven days. Forced to make dreadful choices to beat the Sultan’s Game and save your own life, you will have to find a way to survive not just the Game, but its consequences too.','2025/3/30','Released','https://store.steampowered.com/app/3117820/Sultans_Game/?snr=1_7_7_230_150_12'),(585,'nioh_2_–_the_complete_edition',NULL,'Battle hordes of yokai in this masocore Action RPG. Create your protagonist and embark on an adventure through a myriad of locales across Japan during the Sengoku period. Utilize the new Yokai Shift ability to defeat even the most ferocious yokai and be prepared to brave through Dark Realms created by your enemies.','2021/2/5','Released','https://store.steampowered.com/app/1325200/Nioh_2__The_Complete_Edition/?snr=1_7_7_230_150_12'),(586,'the_lord_of_the_rings_online™',NULL,'Join the world’s greatest fellowship of players in the award-winning online re-creation of J. R. R. Tolkien’s legendary Middle-earth.','2012/6/6','Released','https://store.steampowered.com/app/212500/The_Lord_of_the_Rings_Online/?snr=1_7_7_230_150_12'),(587,'unpacking',NULL,'Unpacking is a zen puzzle game about the familiar experience of pulling possessions out of boxes and fitting them into a new home. Part block-fitting puzzle, part home decoration, you are invited to create a satisfying living space while learning clues about the life you’re unpacking.','2021/11/1','Released','https://store.steampowered.com/app/1135690/Unpacking/?snr=1_7_7_230_150_12'),(588,'call_of_duty®:_wwii',NULL,'Call of Duty® returns to its roots with Call of Duty®: WWII - a breathtaking experience that redefines World War II for a new gaming generation.','2017/11/2','Released','https://store.steampowered.com/app/476600/Call_of_Duty_WWII/?snr=1_7_7_230_150_12'),(589,'inscryption',NULL,'Inscryption is an inky black card-based odyssey that blends the deckbuilding roguelike, escape-room style puzzles, and psychological horror into a blood-laced smoothie. Darker still are the secrets inscrybed upon the cards...','2021/10/19','Released','https://store.steampowered.com/app/1092790/Inscryption/?snr=1_7_7_230_150_12'),(590,'need_for_speed™_heat',NULL,'Hustle by day and risk it all at night in Need for Speed™ Heat Deluxe Edition, a white-knuckle street racer, where the lines of the law fade as the sun starts to set.','2019/11/8','Released','https://store.steampowered.com/app/1222680/Need_for_Speed_Heat/?snr=1_7_7_230_150_12'),(591,'granblue_fantasy_versus:_rising',NULL,'Rise to the challenge in Granblue Fantasy Versus: Rising! This powered up, revamped sequel to GBVS is more enjoyable and accessible than ever before. With simplified input options, even newcomers can engage in thrilling and strategic matches!','2023/12/13','Released','https://store.steampowered.com/app/2157560/Granblue_Fantasy_Versus_Rising/?snr=1_7_7_230_150_12'),(592,'blazblue_entropy_effect',NULL,'Enjoy action-packed flashy combat with incredibly satisfying combos and responsive controls! Numerous characters, each with completely unique playstyles and loads of unlockable moves & upgrades! This action roguelike sets the bar for fluid fast-paced action.','2024/2/14','Released','https://store.steampowered.com/app/2273430/BlazBlue_Entropy_Effect/?snr=1_7_7_230_150_13'),(593,'total_war:_attila',NULL,'Against a darkening background of famine, disease and war, a new power is rising in the great steppes of the East. With a million horsemen at his back, the ultimate warrior king approaches, and his sights are set on Rome… The next instalment in the multi award-winning PC series that combines turn-based strategy with real-time tactics,...','2015/2/17','Released','https://store.steampowered.com/app/325610/Total_War_ATTILA/?snr=1_7_7_230_150_13'),(594,'total_war:_warhammer_iii_-_golgfag_–_omens_of_destruction',NULL,'This content requires the base game Total War: WARHAMMER III on Steam in order to play.','2024/12/12','Released','https://store.steampowered.com/app/3130740/Total_War_WARHAMMER_III__Golgfag__Omens_of_Destruction/?snr=1_7_7_230_150_13'),(595,'ace_combat™_7:_skies_unknown',NULL,'Become an ace pilot and soar through photorealistic skies with full 360 degree movement; down enemy aircraft and experience the thrill of engaging in realistic sorties! Aerial combat has never looked or felt better!','2019/1/31','Released','https://store.steampowered.com/app/502500/ACE_COMBAT_7_SKIES_UNKNOWN/?snr=1_7_7_230_150_13'),(596,'stellaris:_grand_archive',NULL,'This content requires the base game Stellaris on Steam in order to play.','2024/10/29','Released','https://store.steampowered.com/app/2863080/Stellaris_Grand_Archive/?snr=1_7_7_230_150_13'),(597,'euro_truck_simulator_2_-_scandinavia',NULL,'This content requires the base game Euro Truck Simulator 2 on Steam in order to play.','2015/5/6','Released','https://store.steampowered.com/app/304212/Euro_Truck_Simulator_2__Scandinavia/?snr=1_7_7_230_150_13'),(598,'aloft',NULL,'Soar the skies in Aloft, the co-op sandbox survival game set in a world of floating islands. Build any island into a skyship, your home in the clouds. Find lost knowledge, cure the fungal corruption, and brave the hurricane to restore the ecosystem.','2025/1/15','Released','https://store.steampowered.com/app/1660080/Aloft/?snr=1_7_7_230_150_13'),(599,'metro_exodus',NULL,'Flee the shattered ruins of the Moscow Metro and embark on an epic, continent-spanning journey across the post-apocalyptic Russian wilderness. Explore vast, non-linear levels, lose yourself in an immersive, sandbox survival experience, and follow a thrilling story-line that spans an entire year in the greatest Metro adventure yet.','2019/2/14','Released','https://store.steampowered.com/app/412020/Metro_Exodus/?snr=1_7_7_230_150_13'),(600,'the_sims™_3',NULL,'The Sims 3: Create the perfect world with full customization at your fingertips. Refine personalities and help fulfill destinies.','2009/6/2','Released','https://store.steampowered.com/app/47890/The_Sims_3/?snr=1_7_7_230_150_13'),(601,'universe_sandbox',NULL,'Create & destroy on an unimaginable scale with a realistic physics-based space simulator. Explore the beauty of our universe and the fragility of our planet. Use science to bend the laws of gravity, collide planets, boil away oceans, fire epic space lasers, and customize your universe.','2015/8/24','Released','https://store.steampowered.com/app/230290/Universe_Sandbox/?snr=1_7_7_230_150_13'),(602,'little_kitty,_big_city',NULL,'You\'re a curious little kitty with a big personality, on an adventure to find your way back home. Explore the city, make new friends with stray animals, wear delightful hats, and leave more than a little chaos in your wake. After all, isn\'t that what cats do best?','2024/5/9','Released','https://store.steampowered.com/app/1177980/Little_Kitty_Big_City/?snr=1_7_7_230_150_13'),(603,'nier_replicant™_ver.1.22474487139...',NULL,'The upgraded prequel of NieR:Automata. A kind young man sets out with Grimoire Weiss, a strange talking book, to search for the \"Sealed verses\" in order to save his sister Yonah, who fell terminally ill to the Black Scrawl.','2021/4/23','Released','https://store.steampowered.com/app/1113560/NieR_Replicant_ver122474487139/?snr=1_7_7_230_150_13'),(604,'devil_may_cry_hd_collection',NULL,'The popular stylish action games Devil May Cry, Devil May Cry 2, and Devil May Cry 3 Special Edition return in one collection!','2018/3/13','Released','https://store.steampowered.com/app/631510/Devil_May_Cry_HD_Collection/?snr=1_7_7_230_150_13'),(605,'phoenix_wright:_ace_attorney_trilogy',NULL,'Become Phoenix Wright and experience the thrill of battle as you fight to save your innocent clients in a court of law. Play all 14 episodes, spanning the first three games, in one gorgeous collection.','2019/4/9','Released','https://store.steampowered.com/app/787480/Phoenix_Wright_Ace_Attorney_Trilogy/?snr=1_7_7_230_150_13'),(606,'plants_vs._zombies™_garden_warfare_2:_deluxe_edition',NULL,'Ready the Peashooters and prepare for the craziest, funniest shooter in the universe: Plants vs. Zombies Garden Warfare 2.','2022/5/16','Released','https://store.steampowered.com/app/1922560/Plants_vs_Zombies_Garden_Warfare_2_Deluxe_Edition/?snr=1_7_7_230_150_13'),(607,'buckshot_roulette',NULL,'Play Russian roulette with a 12-gauge shotgun. Four enter. One leaves. Roll the dice with your life. Good luck!','2024/4/4','Released','https://store.steampowered.com/app/2835570/Buckshot_Roulette/?snr=1_7_7_230_150_13'),(608,'horizon_zero_dawn™_complete_edition',NULL,'Experience Aloy’s legendary quest to unravel the mysteries of a future Earth ruled by Machines. Use devastating tactical attacks against your prey and explore a majestic open world in this award-winning action RPG!','2020/8/7','Released','https://store.steampowered.com/app/1151640/Horizon_Zero_Dawn_Complete_Edition/?snr=1_7_7_230_150_13'),(609,'duck_detective:_the_ghost_of_glamping',NULL,'You are the one and only Duck Detective, a depressed and recently divorced duck who must quack the case. Inspect evidence, make de-duck-tions, and solve this no-murder mystery!','2025/5/22','Released','https://store.steampowered.com/app/2714620/Duck_Detective_The_Ghost_of_Glamping/?snr=1_7_7_230_150_13'),(610,'the_sims™_4_life_&_death_expansion_pack',NULL,'This content requires the base game The Sims™ 4 on Steam in order to play.','2024/10/31','Released','https://store.steampowered.com/app/2815290/The_Sims_4_Life__Death_Expansion_Pack/?snr=1_7_7_230_150_13'),(611,'dragon_quest_iii_hd-2d_remake',NULL,'DRAGON QUEST III HD-2D Remake is a stunning reimagining of the beloved masterpiece and narrative beginning to The Erdrick Trilogy.','2024/11/14','Released','https://store.steampowered.com/app/2701660/DRAGON_QUEST_III_HD2D_Remake/?snr=1_7_7_230_150_13'),(612,'metal_gear_&_metal_gear_2:_solid_snake',NULL,'The first and second title in the METAL GEAR series that established the stealth action genre, as well as the basic mechanics of the series.','2023/10/24','Released','https://store.steampowered.com/app/2131680/METAL_GEAR__METAL_GEAR_2_Solid_Snake/?snr=1_7_7_230_150_13'),(613,'wingspan',NULL,'Wingspan is a relaxing, award-winning strategy card game about birds for 1 to 5 players. Each bird you play extends a chain of powerful combinations in one of your three habitats. Your goal is to discover and attract the best birds to your network of wildlife preserves.','2020/9/17','Released','https://store.steampowered.com/app/1054490/Wingspan/?snr=1_7_7_230_150_13'),(614,'state_of_decay_2:_juggernaut_edition',NULL,'The dead have risen and civilization has fallen. Now it\'s up to you to gather survivors, scavenge for resources and build a community in a post-apocalyptic world – a world where you define what it means to survive in this ultimate zombie survival simulation.','2020/3/13','Released','https://store.steampowered.com/app/495420/State_of_Decay_2_Juggernaut_Edition/?snr=1_7_7_230_150_13'),(615,'xcom®_2',NULL,'XCOM 2 is the sequel to XCOM: Enemy Unknown, the 2012 award-winning strategy game of the year. Earth has changed and is now under alien rule. Facing impossible odds you must rebuild XCOM, and ignite a global resistance to reclaim our world and save humanity.','2016/2/4','Released','https://store.steampowered.com/app/268500/XCOM_2/?snr=1_7_7_230_150_13'),(616,'war_robots',NULL,'War Robots is an online third-person 6v6 PvP shooter—we’re talking dozens of combat robots, hundreds of weapons combinations, and heated clan battles.','2018/4/5','Released','https://store.steampowered.com/app/767560/War_Robots/?snr=1_7_7_230_150_13'),(617,'jurassic_world_evolution_2:_dominion_malta_expansion',NULL,'This content requires the base game Jurassic World Evolution 2 on Steam in order to play.','2022/12/8','Released','https://store.steampowered.com/app/2177430/Jurassic_World_Evolution_2_Dominion_Malta_Expansion/?snr=1_7_7_230_150_13'),(618,'sun_haven',NULL,'Build your farm and relationships with townsfolk, or forge ahead on a quest of magic, monsters, and dragons. Level up through a skill tree in 8 person multiplayer, or adventure solo!','2023/3/10','Released','https://store.steampowered.com/app/1432860/Sun_Haven/?snr=1_7_7_230_150_13'),(619,'northgard',NULL,'Northgard is a critically acclaimed strategy game based on Norse mythology. Lead your clan, uncover the secrets of a mysterious newfound continent and defeat your enemies to conquer the Throne!','2018/3/7','Released','https://store.steampowered.com/app/466560/Northgard/?snr=1_7_7_230_150_13'),(620,'skin_deep',NULL,'Skin Deep is an immersive first-person shooter. We got sneezing. We got things getting stuck in your feet. Stalk through a vast non-linear starship and sneak, subvert, and sabotage to survive in this stellar sandbox. You\'re outnumbered, outgunned, and have no shoes. Welcome to Skin Deep!','2025/4/30','Released','https://store.steampowered.com/app/301280/Skin_Deep/?snr=1_7_7_230_150_13'),(621,'the_binding_of_isaac:_afterbirth',NULL,'This content requires the base game The Binding of Isaac: Rebirth on Steam in order to play.','2015/10/30','Released','https://store.steampowered.com/app/401920/The_Binding_of_Isaac_Afterbirth/?snr=1_7_7_230_150_13'),(622,'age_of_empires_ii:_de_-_the_three_kingdoms_',NULL,'This content requires the base game Age of Empires II: Definitive Edition on Steam in order to play.','2025/5/6','Released','https://store.steampowered.com/app/3080080/Age_of_Empires_II_DE__The_Three_Kingdoms/?snr=1_7_7_230_150_13'),(623,'bioshock_infinite',NULL,'Indebted to the wrong people, with his life on the line, veteran of the U.S. Cavalry and now hired gun, Booker DeWitt has only one opportunity to wipe his slate clean. He must rescue Elizabeth, a mysterious girl imprisoned since childhood and locked up in the flying city of Columbia.','2013/3/25','Released','https://store.steampowered.com/app/8870/BioShock_Infinite/?snr=1_7_7_230_150_13'),(624,'call_of_duty®:_black_ops_cold_war',NULL,'Black Ops Cold War, the direct sequel to Call of Duty®: Black Ops, will drop fans into the depths of the Cold War’s volatile geopolitical battle of the early 1980s.','2023/3/8','Released','https://store.steampowered.com/app/1985810/Call_of_Duty_Black_Ops_Cold_War/?snr=1_7_7_230_150_13'),(625,'galactic_civilizations_iv',NULL,'Take command of a civilization that has just achieved faster-than-light travel in Galactic Civilizations IV, the newest entry in the award-winning space 4X strategy game series. Explore the galaxy, colonize worlds, shape cultures, make alliances, fight wars and pioneer new technologies.','2023/10/19','Released','https://store.steampowered.com/app/1357210/Galactic_Civilizations_IV/?snr=1_7_7_230_150_13'),(626,'armored_core™_vi_fires_of_rubicon™',NULL,'A new action game based on the concept of the ARMORED CORE series that uses the knowledge gained from FromSoftware\'s recent action game development.','2023/8/24','Released','https://store.steampowered.com/app/1888160/ARMORED_CORE_VI_FIRES_OF_RUBICON/?snr=1_7_7_230_150_13'),(627,'resident_evil_5',NULL,'This game is a port of the Games for Windows - Live version that was released in 2009. If you buy the Untold Stories Bundle here on Steam, it will be the same as upgrading to Resident Evil 5 Gold Edition.','2009/9/15','Released','https://store.steampowered.com/app/21690/Resident_Evil_5/?snr=1_7_7_230_150_13'),(628,'totally_accurate_battle_simulator',NULL,'Be the leader of wobblers from ancient lands, spooky places, and fantasy worlds. Watch them fight in simulations made with the wobbliest physics system ever created, make your own wobblers in the unit creator and send your army off to fight your friends in multiplayer.','2021/4/1','Released','https://store.steampowered.com/app/508440/Totally_Accurate_Battle_Simulator/?snr=1_7_7_230_150_13'),(629,'cauldron',NULL,'Cauldron is an upgrade-heavy, minigame-centric, turn-based RPG. Play minigames to strengthen your party, then win battles to uncover more map, more heroes, more minigames, more everything! If your favorite plant is an upgrade tree, then this game is for you!','2025/5/21','Released','https://store.steampowered.com/app/2619650/Cauldron/?snr=1_7_7_230_150_13'),(630,'enlisted',NULL,'In Enlisted, you are not only commanding a single soldier, but an entire squad! This MMO squad based shooter recreates the key battles of the bloodiest war of the 20th century, with hundreds of soldiers, tanks and aircraft taking part in each battle.','2024/7/16','Released','https://store.steampowered.com/app/2051620/Enlisted/?snr=1_7_7_230_150_13'),(631,'star_wars™_empire_at_war_-_gold_pack',NULL,'Command or corrupt an entire galaxy in the definitive Star Wars strategy collection. It is a time of galactic civil war. Will you take up the reins of the Rebellion, assume control of the Empire, or rule the Star Wars Underworld?','2006/2/16','Released','https://store.steampowered.com/app/32470/STAR_WARS_Empire_at_War__Gold_Pack/?snr=1_7_7_230_150_13'),(632,'storage_hunter_simulator',NULL,'Play as one of the bidders for abandoned warehouses and uncover hidden treasures! Storage Hunter is a garage auction simulation game. Bid, win, and sell for profit! Become the king of storage auction.','2024/10/10','Released','https://store.steampowered.com/app/1442430/Storage_Hunter_Simulator/?snr=1_7_7_230_150_13'),(633,'scp:_5k',NULL,'SCP: 5K is a co-op or singleplayer tactical horror FPS project that puts players in the midst of a conspiracy where the SCP Foundation has turned on humanity. Enjoy Early Access as we continue to work towards a completed full release of the project!','2022/2/22','Released','https://store.steampowered.com/app/872670/SCP_5K/?snr=1_7_7_230_150_13'),(634,'barotrauma',NULL,'Barotrauma is a 2D co-op submarine simulator – in space, with survival horror and RPG elements. Steer your submarine, complete missions, fight monsters, fix leaks, operate machinery, man the guns and craft items, and stay alert: danger in Barotrauma doesn’t announce itself!','2023/3/13','Released','https://store.steampowered.com/app/602960/Barotrauma/?snr=1_7_7_230_150_13'),(635,'taxi_life:_a_city_driving_simulator',NULL,'Climb into the driver\'s seat of your car and your business, transport passengers across Barcelona and grow your company! Can you help relieve the transportation challenges of a city that never sleeps?','2024/3/7','Released','https://store.steampowered.com/app/1351240/Taxi_Life_A_City_Driving_Simulator/?snr=1_7_7_230_150_13'),(636,'octopath_traveler_ii',NULL,'This game is a brand-new entry in the OCTOPATH TRAVELER series, the first installment of which was initially released in 2018 and sold over 3 million copies worldwide.','2023/2/24','Released','https://store.steampowered.com/app/1971650/OCTOPATH_TRAVELER_II/?snr=1_7_7_230_150_13'),(637,'ranch_simulator:_build,_hunt,_farm',NULL,'Builder. Farmer. Hunter. Trader. Ranching certainly isn’t your average job. Think you have the skills to turn your family’s rundown homestead into the most prosperous ranch in the valley? Then it’s time to head out into the wilderness in this captivating single and multiplayer open-world simulator.','2023/11/3','Released','https://store.steampowered.com/app/1119730/Ranch_Simulator_Build_Hunt_Farm/?snr=1_7_7_230_150_13'),(638,'assassin\'s_creed®_origins',NULL,'ASSASSIN’S CREED® ORIGINS IS A NEW BEGINNING *The Discovery Tour by Assassin’s Creed®: Ancient Egypt is available now as a free update!* Ancient Egypt, a land of majesty and intrigue, is disappearing in a ruthless fight for power.','2017/10/26','Released','https://store.steampowered.com/app/582160/Assassins_Creed_Origins/?snr=1_7_7_230_150_13'),(639,'goat_simulator_3',NULL,'Pilgor\'s baaack! Gather your herd and venture forth into Goat Simulator 3; an all-new (at least on Steam), totally realistic, sandbox farmyard experience. Invite up to three friends in local or online co-op, create carnage as a team, or compete in mini-games and then not be friends anymore.','2024/2/15','Released','https://store.steampowered.com/app/850190/Goat_Simulator_3/?snr=1_7_7_230_150_13'),(640,'brotato',NULL,'Brotato is a top-down arena shooter roguelite where you play a potato wielding up to 6 weapons at a time to fight off hordes of aliens. Choose from a variety of traits and items to create unique builds and survive until help arrives.','2023/6/23','Released','https://store.steampowered.com/app/1942280/Brotato/?snr=1_7_7_230_150_13'),(641,'deep_rock_galactic:_survivor',NULL,'DEEP ROCK GALACTIC: SURVIVOR is a single player survivor-like auto-shooter. Take on hordes of lethal aliens, mine riches, and unlock powerful upgrades to survive, as you wield the full arsenal of Deep Rock Galactic. It\'s one dwarf against all of Planet Hoxxes!','2024/2/14','Released','https://store.steampowered.com/app/2321470/Deep_Rock_Galactic_Survivor/?snr=1_7_7_230_150_14'),(642,'conqueror\'s_blade',NULL,'Conqueror\'s Blade gives you a chance to be a true warlord. Commanding medieval troops in epic 15 vs. 15 siege battles, conquering cities with allies in the open world or fighting against players from all over the world – it\'s you who make the choice.','2020/4/5','Released','https://store.steampowered.com/app/835570/Conquerors_Blade/?snr=1_7_7_230_150_14'),(643,'the_sims™_4_cottage_living_expansion_pack',NULL,'This content requires the base game The Sims™ 4 on Steam in order to play.','2021/7/22','Released','https://store.steampowered.com/app/1458150/The_Sims_4_Cottage_Living_Expansion_Pack/?snr=1_7_7_230_150_14'),(644,'total_war:_shogun_2',NULL,'Total War: SHOGUN 2 is the perfect mix of real-time and turn-based strategy gaming for newcomers and veterans alike.','2011/3/14','Released','https://store.steampowered.com/app/201270/Total_War_SHOGUN_2/?snr=1_7_7_230_150_14'),(645,'wolfenstein_ii:_the_new_colossus',NULL,'America, 1961. The assassination of Nazi General Deathshead was a short-lived victory. The Nazis maintain their stranglehold on the world. You are BJ Blazkowicz, aka “Terror-Billy,” member of the Resistance, scourge of the Nazi empire, and humanity’s last hope for liberty.','2017/10/26','Released','https://store.steampowered.com/app/612880/Wolfenstein_II_The_New_Colossus/?snr=1_7_7_230_150_14'),(646,'project_silverfish',NULL,'Explore a hostile, living world: Uncover forgotten horrors, both man-made and supernatural, as you hunt for powerful weapons and exotic artifacts.','2025/6/25','Released','https://store.steampowered.com/app/2941710/Project_Silverfish/?snr=1_7_7_230_150_14'),(647,'monster_hunter_world:_iceborne',NULL,'This content requires the base game Monster Hunter: World on Steam in order to play.','2020/1/9','Released','https://store.steampowered.com/app/1118010/Monster_Hunter_World_Iceborne/?snr=1_7_7_230_150_14'),(648,'miside',NULL,'Let\'s imagine that you have a game in which you care for a character. But could you imagine one day getting into that game yourself?','2024/12/10','Released','https://store.steampowered.com/app/2527500/MiSide/?snr=1_7_7_230_150_14'),(649,'dragon_ball_xenoverse_2',NULL,'DRAGON BALL XENOVERSE 2 builds upon the highly popular DRAGON BALL XENOVERSE with enhanced graphics that will further immerse players into the largest and most detailed Dragon Ball world ever developed.','2016/10/27','Released','https://store.steampowered.com/app/454650/DRAGON_BALL_XENOVERSE_2/?snr=1_7_7_230_150_14'),(650,'the_long_dark',NULL,'THE LONG DARK is a thoughtful, exploration-survival experience that challenges solo players to think for themselves as they explore an expansive frozen wilderness in the aftermath of a geomagnetic disaster. There are no zombies -- only you, the cold, and all the threats Mother Nature can muster.','2017/8/1','Released','https://store.steampowered.com/app/305620/The_Long_Dark/?snr=1_7_7_230_150_14'),(651,'american_truck_simulator_-_missouri',NULL,'This content requires the base game American Truck Simulator on Steam in order to play.','2025/4/3','Released','https://store.steampowered.com/app/2730870/American_Truck_Simulator__Missouri/?snr=1_7_7_230_150_14'),(652,'final_fantasy_ix',NULL,'Selling over five million copies since its release in 2000, FINAL FANTASY IX proudly returns on Steam! Now you can relive the adventures of Zidane and his crew on PC !','2016/4/14','Released','https://store.steampowered.com/app/377840/FINAL_FANTASY_IX/?snr=1_7_7_230_150_14'),(653,'tiny_tina\'s_wonderlands',NULL,'Embark on an epic adventure full of whimsy, wonder, and high-powered weaponry! Roll your own multiclass hero then shoot, loot, slash, and cast on a quest to stop the Dragon Lord.','2022/6/23','Released','https://store.steampowered.com/app/1286680/Tiny_Tinas_Wonderlands/?snr=1_7_7_230_150_14'),(654,'watch_dogs®_2',NULL,'Welcome to San Francisco. Play as Marcus, a brilliant young hacker, and join the most notorious hacker group, DedSec. Your objective: execute the biggest hack of history.','2016/11/28','Released','https://store.steampowered.com/app/447040/Watch_Dogs_2/?snr=1_7_7_230_150_14'),(655,'conquest_dark',NULL,'Experience an ARPG\'s rapid ascension to power in minutes, packed with savage, survivors-like action and devastating sword & sorcery combat. Perfect your builds through Dark Ritual runs that will decide humanity\'s future as you battle endless hordes across haunting ruins and cursed kingdoms.','2025/4/30','Released','https://store.steampowered.com/app/3238670/Conquest_Dark/?snr=1_7_7_230_150_14'),(656,'euro_truck_simulator_2_-_iberia',NULL,'This content requires the base game Euro Truck Simulator 2 on Steam in order to play.','2021/4/8','Released','https://store.steampowered.com/app/1209460/Euro_Truck_Simulator_2__Iberia/?snr=1_7_7_230_150_14'),(657,'kerbal_space_program:_breaking_ground_expansion',NULL,'This content requires the base game Kerbal Space Program on Steam in order to play.','2019/5/30','Released','https://store.steampowered.com/app/982970/Kerbal_Space_Program_Breaking_Ground_Expansion/?snr=1_7_7_230_150_14'),(658,'call_of_duty®:_modern_warfare®_3_(2011)',NULL,'The best-selling first-person action series of all-time returns with an epic sequel to the multiple GOTY award winner Call of Duty®: Modern Warfare® 2','2011/11/7','Released','https://store.steampowered.com/app/115300/Call_of_Duty_Modern_Warfare_3_2011/?snr=1_7_7_230_150_14'),(659,'legacy:_steel_&_sorcery',NULL,'Legacy: Steel & Sorcery is an action-combat PvPvE extraction RPG set in the classic fantasy world of Mithrigarde, rich with expansive outdoor zones. Play solo or with friends to gather loot, slay creatures, and defeat other players.','2025/2/12','Released','https://store.steampowered.com/app/2344320/Legacy_Steel__Sorcery/?snr=1_7_7_230_150_14'),(660,'v_rising_-_eternal_dominance_pack',NULL,'This content requires the base game V Rising on Steam in order to play.','2025/4/28','Released','https://store.steampowered.com/app/3604340/V_Rising__Eternal_Dominance_Pack/?snr=1_7_7_230_150_14'),(661,'spiritfarer®:_farewell_edition',NULL,'Spiritfarer® is a cozy management game about dying. As ferrymaster to the deceased, build a boat to explore the world, care for your spirit friends, and release them into the afterlife. The Spiritfarer Farewell Edition includes the heartwarming base game and three major content updates.','2020/8/18','Released','https://store.steampowered.com/app/972660/Spiritfarer_Farewell_Edition/?snr=1_7_7_230_150_14'),(662,'final_fantasy_xv_windows_edition',NULL,'Take the journey, now in ultimate quality. Boasting a wealth of bonus content and supporting ultra high-resolution graphical options and HDR 10, you can now enjoy the beautiful and carefully-crafted experience of FINAL FANTASY XV like never before.','2018/3/6','Released','https://store.steampowered.com/app/637650/FINAL_FANTASY_XV_WINDOWS_EDITION/?snr=1_7_7_230_150_14'),(663,'green_hell',NULL,'Plunge into the open-world survival simulation set in the extreme conditions of the uncharted Amazon jungle. Use real-life survival techniques to craft, hunt, fight, and gather resources, set a makeshift shelter, or raise a fortress. Survive alone or team up with your friends and challenge the jungle together.','2019/9/5','Released','https://store.steampowered.com/app/815370/Green_Hell/?snr=1_7_7_230_150_14'),(664,'across_the_obelisk',NULL,'Set forth in a co-op roguelite deckbuilder where every choice matters! Craft decks of breathtaking power. Journey alone or with up to three friends. Plot your party’s path to glory and face powerful enemies in deep tactical combat on your quest to save the kingdom of Senenthia in Across the Obelisk!','2021/4/8','Released','https://store.steampowered.com/app/1385380/Across_the_Obelisk/?snr=1_7_7_230_150_14'),(665,'slime_rancher',NULL,'Slime Rancher is the tale of Beatrix LeBeau, a plucky, young rancher who sets out for a life a thousand light years away from Earth on the ‘Far, Far Range’ where she tries her hand at making a living wrangling slimes.','2017/8/1','Released','https://store.steampowered.com/app/433340/Slime_Rancher/?snr=1_7_7_230_150_14'),(666,'lockdown_protocol',NULL,'A first person social deduction game, combining real time action and communication, 3 to 8 players. While most players will do their best to complete objectives and ensure victory, a small portion of dissidents will try to stop them at all costs, without getting caught.','2024/7/22','Released','https://store.steampowered.com/app/2780980/LOCKDOWN_Protocol/?snr=1_7_7_230_150_14'),(667,'after_inc:_revival',NULL,'Can you rebuild civilisation after a zombie apocalypse? From the creator of Plague Inc. comes a unique blend of strategic simulation, survival city builder and ‘mini 4X’. Build settlements, harvest resources and shape society as you lead Humanity out of the darkness.','2025/6/17','Released','https://store.steampowered.com/app/3337140/After_Inc_Revival/?snr=1_7_7_230_150_14'),(668,'demonologist',NULL,'Demonologist is a Co-Op horror game that can be played with at least 1 and up to 4 players. Your goal is to identify the type of evil spirit in cursed places and exorcise it using your equipment, either alone or with your team.','2023/9/25','Released','https://store.steampowered.com/app/1929610/Demonologist/?snr=1_7_7_230_150_14'),(669,'heavy_rain',NULL,'Experience a gripping psychological thriller filled with innumerable twists and turns. The hunt is on for a murderer known only as the Origami Killer. Four characters, each following their own leads, must take part in a desperate attempt to prevent the killer from claiming a new victim.','2020/6/18','Released','https://store.steampowered.com/app/960910/Heavy_Rain/?snr=1_7_7_230_150_14'),(670,'djmax_respect_v',NULL,'DJMAX RESPECT V is the latest installment from the creators of the critically acclaimed rhythm game franchise ‘DJMAX.’ Experience tracks from popular artists such as Marshmello, Porter Robinson, and Yukika, exclusive Full HD Music Videos, online multiplayer, new game modes, and more!','2020/3/11','Released','https://store.steampowered.com/app/960170/DJMAX_RESPECT_V/?snr=1_7_7_230_150_14'),(671,'sunkenland',NULL,'Get ready for a Waterworld-themed survival game with modular base building, sunken city scavenging, crafting, base defense, and invasions of NPC clans for resources and territory. Ready for the water apocalypse?','2023/8/25','Released','https://store.steampowered.com/app/2080690/Sunkenland/?snr=1_7_7_230_150_14'),(672,'call_of_duty:_world_at_war',NULL,'Call of Duty is back, redefining war like you\'ve never experienced before. Building on the Call of Duty 4®: Modern Warfare engine, Call of Duty: World at War immerses players into the most gritty and chaotic WWII combat ever experienced.','2008/11/18','Released','https://store.steampowered.com/app/10090/Call_of_Duty_World_at_War/?snr=1_7_7_230_150_14'),(673,'crossout',NULL,'Crossout - the postapocalyptic MMO action game where you can create a unique design for an armoured vehicle from dozens of parts and then drive it into multiplayer battles raging on land and in the skies alike.','2017/7/26','Released','https://store.steampowered.com/app/386180/Crossout/?snr=1_7_7_230_150_14'),(674,'my_hero_ultra_rumble',NULL,'Pick your favorite character, team up and fight to be the last ones standing in the new 24-player Battle Royale free to play game \"MY HERO ULTRA RUMBLE\"!','2023/9/28','Released','https://store.steampowered.com/app/1607250/MY_HERO_ULTRA_RUMBLE/?snr=1_7_7_230_150_14'),(675,'prince_of_persia_the_lost_crown',NULL,'Dash into a stylish and thrilling action-adventure platformer set in a mythological Persian world where the boundaries of time and space are yours to manipulate.','2024/8/8','Released','https://store.steampowered.com/app/2751000/Prince_of_Persia_The_Lost_Crown/?snr=1_7_7_230_150_14'),(676,'house_party',NULL,'House Party is an edgy comedy adventure game inspired by classic comedies of the \'90s. Every decision changes your story and every character has something to reveal. There’s also a button to take your pants off.','2022/7/15','Released','https://store.steampowered.com/app/611790/House_Party/?snr=1_7_7_230_150_14'),(677,'library_of_ruina',NULL,'\"May you find your book in this place.\" Combat between the guests and the librarians breaks out as if it were on a stage. Defeated guests turn into books, and the Library grows onward. And eventually, get your hands on… The one singular, perfect book.','2021/8/10','Released','https://store.steampowered.com/app/1256670/Library_Of_Ruina/?snr=1_7_7_230_150_14'),(678,'destiny_2:_the_final_shape',NULL,'This content requires the base game Destiny 2 on Steam in order to play.','2024/6/4','Released','https://store.steampowered.com/app/2336880/Destiny_2_The_Final_Shape/?snr=1_7_7_230_150_14'),(679,'roboquest',NULL,'Roboquest is a fast FPS Roguelite in a scorched futureworld. You\'re a rebooted Guardian, ready to kick some metal ass! Fight with your buddy or by yourself and annihilate hordes of deadly bots in ever-changing environments.','2023/11/7','Released','https://store.steampowered.com/app/692890/Roboquest/?snr=1_7_7_230_150_14'),(680,'metal_gear_solid_v:_the_phantom_pain',NULL,'Ushering in a new era for the METAL GEAR franchise with cutting-edge technology powered by the Fox Engine, METAL GEAR SOLID V: The Phantom Pain, will provide players a first-rate gaming experience as they are offered tactical freedom to carry out open-world missions.','2015/9/1','Released','https://store.steampowered.com/app/287700/METAL_GEAR_SOLID_V_THE_PHANTOM_PAIN/?snr=1_7_7_230_150_14'),(681,'construction_simulator',NULL,'Construction Simulator has returned – larger and more impressive than ever! Fulfil your ambition to become a successful construction entrepreneur by establishing your business from scratch, assisted by your mentor Hape.','2022/9/20','Released','https://store.steampowered.com/app/1273400/Construction_Simulator/?snr=1_7_7_230_150_14'),(682,'total_war:_rome_remastered',NULL,'Total War: ROME REMASTERED lets you relive the legacy that defined the award-winning strategy game series. Remastered to 4K with multiple improvements to visuals as well as refinements to gameplay, it’s time to revisit a true classic. Not everyone gets a second chance to conquer the Roman Empire.','2021/4/29','Released','https://store.steampowered.com/app/885970/Total_War_ROME_REMASTERED/?snr=1_7_7_230_150_14'),(683,'wrap_house_simulator🌯',NULL,'Welcome to Wrap House Simulator! Run your own wrap shop, chop, grill, and serve in this cooking adventure. Customize your shop, master the grill, and survive the rush solo or co-op with up to 4 players. Keep up with orders, satisfy customers, and build your dream restaurant!','2025/5/29','Released','https://store.steampowered.com/app/3533100/Wrap_House_Simulator/?snr=1_7_7_230_150_14'),(684,'derail_valley',NULL,'Drive massive trains and build your career in a vast open railway network. For both PC and VR.','2019/1/25','Released','https://store.steampowered.com/app/588030/Derail_Valley/?snr=1_7_7_230_150_14'),(685,'the_sims™_2_legacy_collection',NULL,'The game you know and love. For Windows 10/11. In The Sims 2, you direct your Sims over a lifetime. Give them a long existence or leave their lives in shambles. Guide their characteristics from one generation to the next.','2025/1/31','Released','https://store.steampowered.com/app/3314070/The_Sims_2_Legacy_Collection/?snr=1_7_7_230_150_14'),(686,'chants_of_sennaar',NULL,'In this award-winning puzzle adventure game, play as the Traveler on a quest to reunite the Peoples of the Tower. Observe, listen, and decipher ancient languages in a fascinating universe inspired by the Myth of Babel.','2023/9/5','Released','https://store.steampowered.com/app/1931770/Chants_of_Sennaar/?snr=1_7_7_230_150_14'),(687,'planet_zoo:_americas_animal_pack',NULL,'This content requires the base game Planet Zoo on Steam in order to play.','2025/4/15','Released','https://store.steampowered.com/app/3473820/Planet_Zoo_Americas_Animal_Pack/?snr=1_7_7_230_150_14'),(688,'carx_drift_racing_online',NULL,'CarX Drift Racing Online is your chance to immerse yourself in the real world of drifting. Get together with friends, tune your car and burn some tires!','2017/11/17','Released','https://store.steampowered.com/app/635260/CarX_Drift_Racing_Online/?snr=1_7_7_230_150_15'),(689,'dyson_sphere_program',NULL,'Build the most efficient intergalactic factory in space simulation strategy game Dyson Sphere Program! Harness the power of stars, collect resources, plan and design production lines and develop your interstellar factory from a small space workshop to a galaxy-wide industrial empire.','2021/1/20','Released','https://store.steampowered.com/app/1366540/Dyson_Sphere_Program/?snr=1_7_7_230_150_15'),(690,'sea_of_stars',NULL,'Sea of Stars is a turn-based RPG inspired by the classics. It tells the story of two Children of the Solstice who will combine the powers of the sun and moon to perform Eclipse Magic, the only force capable of fending off the monstrous creations of the evil alchemist known as The Fleshmancer.','2023/8/28','Released','https://store.steampowered.com/app/1244090/Sea_of_Stars/?snr=1_7_7_230_150_15'),(691,'still_wakes_the_deep:_siren’s_rest',NULL,'This content requires the base game Still Wakes the Deep on Steam in order to play.','2025/6/18','Released','https://store.steampowered.com/app/3465690/Still_Wakes_the_Deep_Sirens_Rest/?snr=1_7_7_230_150_15'),(692,'mafia_ii:_definitive_edition',NULL,'War hero Vito Scaletta becomes entangled with the mob in hopes of paying his father’s debts. Vito works to prove himself, climbing the family ladder with crimes of larger reward and consequence.','2020/5/19','Released','https://store.steampowered.com/app/1030830/Mafia_II_Definitive_Edition/?snr=1_7_7_230_150_15'),(693,'songs_of_conquest',NULL,'Raise mighty armies, wield ancient magic and forge an empire. This turn-based strategy adventure game fuses strategic decision making, tactical combat and kingdom management.','2024/5/20','Released','https://store.steampowered.com/app/867210/Songs_of_Conquest/?snr=1_7_7_230_150_15'),(694,'the_planet_crafter_-_planet_humble',NULL,'This content requires the base game The Planet Crafter on Steam in order to play.','2024/10/9','Released','https://store.steampowered.com/app/3142540/The_Planet_Crafter__Planet_Humble/?snr=1_7_7_230_150_15'),(695,'lego®_star_wars™_-_the_complete_saga',NULL,'Kick Some Brick in I through VI! Play through all six Star Wars movies in one videogame! Adding new characters, new levels, new features and for the first time ever, the chance to build and battle your way through a fun Star Wars galaxy on your PC!','2009/11/12','Released','https://store.steampowered.com/app/32440/LEGO_Star_Wars__The_Complete_Saga/?snr=1_7_7_230_150_15'),(696,'total_war:_warhammer_iii_-_elspeth_–_thrones_of_decay',NULL,'This content requires the base game Total War: WARHAMMER III on Steam in order to play.','2024/4/30','Released','https://store.steampowered.com/app/2325832/Total_War_WARHAMMER_III__Elspeth__Thrones_of_Decay/?snr=1_7_7_230_150_15'),(697,'camper_van:_make_it_home',NULL,'Decorate and organize the camper van of your dreams! Embark on a journey of self-discovery as you build your own home-on-wheels, using a combination of creative block organization puzzles and relaxing interior design. Make your heart feel at ease and your camper van feel like home.','2025/6/7','Released','https://store.steampowered.com/app/2843190/Camper_Van_Make_it_Home/?snr=1_7_7_230_150_15'),(698,'final_fantasy_vi',NULL,'The original FINAL FANTASY VI comes to life with completely new graphics and audio! A remodeled 2D take on the sixth game in the world-renowned FINAL FANTASY series! Enjoy the timeless story told through charming retro graphics.','2022/2/23','Released','https://store.steampowered.com/app/1173820/FINAL_FANTASY_VI/?snr=1_7_7_230_150_15'),(699,'call_to_arms_-_gates_of_hell:_liberation',NULL,'This content requires the base game Call to Arms - Gates of Hell: Ostfront on Steam in order to play.','2023/11/29','Released','https://store.steampowered.com/app/2447590/Call_to_Arms__Gates_of_Hell_Liberation/?snr=1_7_7_230_150_15'),(700,'holdfast:_nations_at_war',NULL,'Fight on multiple fronts in Holdfast: Nations At War - A multiplayer first and third-person shooter set during the great Napoleonic Era and WW1. Charge into battle with over 150 players per server!','2020/3/5','Released','https://store.steampowered.com/app/589290/Holdfast_Nations_At_War/?snr=1_7_7_230_150_15'),(701,'mafia_iii:_definitive_edition',NULL,'After Lincoln Clay\'s surrogate family, the black mob, is betrayed and killed by the Italian Mafia, Lincoln builds a new family and blazes a path of revenge through the Mafioso responsible.','2020/5/19','Released','https://store.steampowered.com/app/360430/Mafia_III_Definitive_Edition/?snr=1_7_7_230_150_15'),(702,'sid_meier\'s_civilization®_v',NULL,'Create, discover, and download new player-created maps, scenarios, interfaces, and more!','2010/9/23','Released','https://store.steampowered.com/app/8930/Sid_Meiers_Civilization_V/?snr=1_7_7_230_150_15'),(703,'lobotomy_corporation_|_monster_management_simulation',NULL,'A roguelite monster-management simulation inspired by the likes of the SCP Foundation, Cabin in the Woods, and Warehouse 13. Order your employees to perform work with the creatures and watch as it unfolds; harness greater energy, and expand the facility','2018/4/9','Released','https://store.steampowered.com/app/568220/Lobotomy_Corporation__Monster_Management_Simulation/?snr=1_7_7_230_150_15'),(704,'phantasy_star_online_2_new_genesis',NULL,'Phantasy Star Online 2 New Genesis is a free-to-play action MMO. Join players around the world to explore the planet Halpha and fight in epic battles as ARKS Defenders! Unleash your imagination with our ultimate character creation experience and creative spaces to create your own phantasy.','2020/8/5','Released','https://store.steampowered.com/app/1056640/Phantasy_Star_Online_2_New_Genesis/?snr=1_7_7_230_150_15'),(705,'ale_&_tale_tavern',NULL,'Get ready for a thrilling mix of genres: a cooperative, first-person, open-world fantasy tavern simulator, action, fishing, hunting, exploration, and completing fun and diverse quests. And, of course, COOKING! Play with friends, feed and quench the thirst of the entire world!','2024/9/5','Released','https://store.steampowered.com/app/2683150/Ale__Tale_Tavern/?snr=1_7_7_230_150_15'),(706,'just_shapes_&_beats',NULL,'\"Just Shapes & Beats\" is a chaotic co-op musical bullet-hell based on three simple things: avoid Shapes, move to the kick-ass Beats, and die, repeatedly.','2018/5/31','Released','https://store.steampowered.com/app/531510/Just_Shapes__Beats/?snr=1_7_7_230_150_15'),(707,'thronefall',NULL,'A minimalist game about building and defending your little kingdom.','2024/10/11','Released','https://store.steampowered.com/app/2239150/Thronefall/?snr=1_7_7_230_150_15'),(708,'star_wars™:_squadrons',NULL,'Master the art of starfighter combat in the authentic piloting experience STAR WARS™: Squadrons. Feel the adrenaline of first-person multiplayer space dogfights alongside your squadron, and buckle up in a thrilling STAR WARS™ story.','2020/10/1','Released','https://store.steampowered.com/app/1222730/STAR_WARS_Squadrons/?snr=1_7_7_230_150_15'),(709,'vellum',NULL,'Write on! Defend the books in Vellum, a co-op, literary roguelike! Harness class-defining colors, master an inspired spellbook, and influence the growth of your enemy! As a group or solo, you\'ll craft plot-twisting builds to rewrite the rules in Ink!','2025/5/2','Released','https://store.steampowered.com/app/917950/Vellum/?snr=1_7_7_230_150_15'),(710,'baldur\'s_gate_3_-_digital_deluxe_edition_dlc',NULL,'This content requires the base game Baldur\'s Gate 3 on Steam in order to play.','2023/8/3','Released','https://store.steampowered.com/app/2378500/Baldurs_Gate_3__Digital_Deluxe_Edition_DLC/?snr=1_7_7_230_150_15'),(711,'far_cry®_4',NULL,'Hidden in the towering Himalayas lies Kyrat, a country steeped in tradition and violence. You are Ajay Ghale. Traveling to Kyrat to fulfill your mother’s dying wish, you find yourself caught up in a civil war to overthrow the oppressive regime of dictator Pagan Min.','2014/11/18','Released','https://store.steampowered.com/app/298110/Far_Cry_4/?snr=1_7_7_230_150_15'),(712,'warhammer_40,000:_rogue_trader_-_deluxe_pack',NULL,'This content requires the base game Warhammer 40,000: Rogue Trader on Steam in order to play.','2023/12/7','Released','https://store.steampowered.com/app/2682660/Warhammer_40000_Rogue_Trader__Deluxe_Pack/?snr=1_7_7_230_150_15'),(713,'diplomacy_is_not_an_option',NULL,'Diplomacy is Not an Option is a strategy game set in a medieval fantasy world. Build your town and defenses, raise huge armies and fight against massive hordes of enemies. How long can you survive?','2024/10/4','Released','https://store.steampowered.com/app/1272320/Diplomacy_is_Not_an_Option/?snr=1_7_7_230_150_15'),(714,'the_sims™_4_seasons',NULL,'This content requires the base game The Sims™ 4 on Steam in order to play.','2018/6/21','Released','https://store.steampowered.com/app/1235733/The_Sims_4_Seasons/?snr=1_7_7_230_150_15'),(715,'frostpunk',NULL,'Frostpunk is the first society survival game. As the ruler of the last city on Earth, it is your duty to manage both its citizens and infrastructure. What decisions will you make to ensure your society\'s survival? What will you do when pushed to breaking point? Who will you become in the process?','2018/4/24','Released','https://store.steampowered.com/app/323190/Frostpunk/?snr=1_7_7_230_150_15'),(716,'star_trek:_resurgence',NULL,'Authentic Star Trek adventure from former members of Telltale Games. Engage in diplomacy, pilot shuttlecraft, and use your tricorder and phaser to overcome challenging puzzles and deadly threats. Tough decisions will impact relationships, your story, and the fate of the galaxy. What will YOU do?','2024/5/23','Released','https://store.steampowered.com/app/2653940/Star_Trek_Resurgence/?snr=1_7_7_230_150_15'),(717,'rocksmith®_2014_edition_remastered_learn_&_play',NULL,'Play guitar or bass and start your musical journey with Rocksmith 2014 Remastered Learn & Play! Perfect for beginners and pros, learn at your own rythmm with 60 tracks and customizable tools. Get ready to rock!','2024/12/19','Released','https://store.steampowered.com/app/221680/Rocksmith_2014_Edition_REMASTERED_LEARN__PLAY/?snr=1_7_7_230_150_15'),(718,'hatsune_miku:_project_diva_mega_mix+',NULL,'Take center stage in Hatsune Miku’s premier rhythm game starring the world’s #1 virtual pop star! With a stunner setlist and enormous wardrobe to style, it’s Miku’s ultimate tour—all it needs is you.','2022/5/26','Released','https://store.steampowered.com/app/1761390/Hatsune_Miku_Project_DIVA_Mega_Mix/?snr=1_7_7_230_150_15'),(719,'kerbal_space_program:_making_history_expansion',NULL,'This content requires the base game Kerbal Space Program on Steam in order to play.','2018/3/13','Released','https://store.steampowered.com/app/283740/Kerbal_Space_Program_Making_History_Expansion/?snr=1_7_7_230_150_15'),(720,'final_fantasy_xii_the_zodiac_age',NULL,'FINAL FANTASY XII THE ZODIAC AGE - This revered classic returns, now fully remastered for the first time for PC, featuring all new and enhanced gameplay.','2018/2/1','Released','https://store.steampowered.com/app/595520/FINAL_FANTASY_XII_THE_ZODIAC_AGE/?snr=1_7_7_230_150_15'),(721,'mechabellum',NULL,'Mechabellum is a rewarding tactical wargame where you gain victory by adapting your strategy and outthinking your opponents. Command a mechanized army in battles against humans or AI, customize your units and strategically place them on the battlefield to watch them destroy your enemies.','2024/9/26','Released','https://store.steampowered.com/app/669330/Mechabellum/?snr=1_7_7_230_150_15'),(722,'oxygen_not_included:_the_prehistoric_planet_pack',NULL,'This content requires the base game Oxygen Not Included on Steam in order to play.','2025/6/12','Released','https://store.steampowered.com/app/3655420/Oxygen_Not_Included_The_Prehistoric_Planet_Pack/?snr=1_7_7_230_150_15'),(723,'prehistoric_kingdom',NULL,'Take on the role of park manager and design the ultimate zoo for nature\'s greatest creations.','2022/4/27','Released','https://store.steampowered.com/app/666150/Prehistoric_Kingdom/?snr=1_7_7_230_150_15'),(724,'coral_island',NULL,'Coral Island is a vibrant and laid-back reimagining of farm sim games. Be who you want and experience enchanting island living at your own pace—live off the land, nurture animals, build relationships with a diverse cast of townsfolk, and make the world around you a more vital and harmonious place.','2023/11/14','Released','https://store.steampowered.com/app/1158160/Coral_Island/?snr=1_7_7_230_150_15'),(725,'rise_of_the_ronin',NULL,'Embark on an epic journey across war-torn 19th-century Japan in this open-world action RPG from Team NINJA, the veteran studio behind \"Nioh\" and \"NINJA GAIDEN.\"','2025/3/10','Released','https://store.steampowered.com/app/1340990/Rise_of_the_Ronin/?snr=1_7_7_230_150_15'),(726,'caves_of_qud',NULL,'Caves of Qud is a science fantasy roguelike epic steeped in retrofuturism, deep simulation, and swathes of sentient plants. Come inhabit an exotic world and chisel through layers of thousand-year-old civilizations.','2024/12/5','Released','https://store.steampowered.com/app/333640/Caves_of_Qud/?snr=1_7_7_230_150_15'),(727,'shadow_of_the_tomb_raider:_definitive_edition',NULL,'As Lara Croft races to save the world from a Maya apocalypse, she must become the Tomb Raider she is destined to be.','2018/9/14','Released','https://store.steampowered.com/app/750920/Shadow_of_the_Tomb_Raider_Definitive_Edition/?snr=1_7_7_230_150_15'),(728,'outer_wilds_-_echoes_of_the_eye',NULL,'This content requires the base game Outer Wilds on Steam in order to play.','2021/9/28','Released','https://store.steampowered.com/app/1622100/Outer_Wilds__Echoes_of_the_Eye/?snr=1_7_7_230_150_15'),(729,'dark_souls™_ii:_scholar_of_the_first_sin',NULL,'DARK SOULS™ II: Scholar of the First Sin brings the franchise’s renowned obscurity & gripping gameplay to a new level. Join the dark journey and experience overwhelming enemy encounters, diabolical hazards, and unrelenting challenge.','2015/4/1','Released','https://store.steampowered.com/app/335300/DARK_SOULS_II_Scholar_of_the_First_Sin/?snr=1_7_7_230_150_15'),(730,'dredge_-_the_iron_rig',NULL,'This content requires the base game DREDGE on Steam in order to play.','2024/8/15','Released','https://store.steampowered.com/app/2561450/DREDGE__The_Iron_Rig/?snr=1_7_7_230_150_15'),(731,'call_of_duty®:_modern_warfare®_2_(2009)',NULL,'The most-anticipated game of the year and the sequel to the best-selling first-person action game of all time, Modern Warfare 2 continues the gripping and heart-racing action as players face off against a new threat dedicated to bringing the world to the brink of collapse.','2009/11/12','Released','https://store.steampowered.com/app/10180/Call_of_Duty_Modern_Warfare_2_2009/?snr=1_7_7_230_150_15'),(732,'albion_online',NULL,'Albion Online is a fantasy sandbox MMORPG featuring a player-driven economy, classless combat system, and intense PvP battles. Explore a vast open world full of danger and opportunity. Grow your wealth, forge alliances, and leave your mark on the world of Albion.','2017/7/17','Released','https://store.steampowered.com/app/761890/Albion_Online/?snr=1_7_7_230_150_15'),(733,'tower!_simulator_3',NULL,'Immerse yourself in an ultra-realistic environment that brings the challenges of air traffic control right to your fingertips. With brand-new lighting system, intuitive 2D graphical user interface (GUI), improved voice recognition, 9 airports included, Tower! Sim 3 sets a new gold standard.','2022/12/13','Released','https://store.steampowered.com/app/2176130/Tower_Simulator_3/?snr=1_7_7_230_150_15'),(734,'final_fantasy_vii_ever_crisis',NULL,'Relive the most memorable moments from FFVII and experience the journey of a young hero Sephiroth in FINAL FANTASY VII EVER CRISIS.','2023/12/6','Released','https://store.steampowered.com/app/2484110/FINAL_FANTASY_VII_EVER_CRISIS/?snr=1_7_7_230_150_15'),(735,'erenshor',NULL,'Erenshor is a single player nod to the MMORPGs of the past. Partner up with our signature \"Simulated Players\" to experience all of the joys of open-world MMORPG gameplay on your own schedule and without the time commitments. There are thousands of items, quests, raids, and secrets to discover!','2025/4/14','Released','https://store.steampowered.com/app/2382520/Erenshor/?snr=1_7_7_230_150_15'),(736,'the_walking_dead:_the_telltale_definitive_series',NULL,'The Walking Dead: The Telltale Definitive Series contains all 4 Seasons, 400 Days, and The Walking Dead: Michonne, which includes over 50 hours of gameplay across 23 unique episodes.','2020/10/29','Released','https://store.steampowered.com/app/1449690/The_Walking_Dead_The_Telltale_Definitive_Series/?snr=1_7_7_230_150_15'),(737,'travellers_rest',NULL,'Craft, farm, build and cook! In Travellers Rest you will have to use all the available tools to become the best tavern keeper in the realm. Create unique dishes and drinks to please your customers as you discover the world and its colorful characters.','2020/7/28','Released','https://store.steampowered.com/app/1139980/Travellers_Rest/?snr=1_7_7_230_150_16'),(738,'the_elder_scrolls_online:_2025_content_pass',NULL,'This content requires the base game The Elder Scrolls® Online on Steam in order to play.','2025/4/10','Released','https://store.steampowered.com/app/3474740/The_Elder_Scrolls_Online_2025_Content_Pass/?snr=1_7_7_230_150_16'),(739,'labyrinth_of_the_demon_king',NULL,'Venture through the Labyrinth Of The Demon King, solving puzzles and fighting fearsome monsters in an epic quest to track down the demon who betrayed your lord and end its life.','2025/5/13','Released','https://store.steampowered.com/app/1804010/Labyrinth_Of_The_Demon_King/?snr=1_7_7_230_150_16'),(740,'total_war:_warhammer_iii_-_malakai_–_thrones_of_decay',NULL,'This content requires the base game Total War: WARHAMMER III on Steam in order to play.','2024/4/30','Released','https://store.steampowered.com/app/2891710/Total_War_WARHAMMER_III__Malakai__Thrones_of_Decay/?snr=1_7_7_230_150_16'),(741,'far_cry®_primal',NULL,'The award-winning Far Cry franchise returns with its innovative open world gameplay, bringing together massive beasts, breathtaking environments, and unpredictable savage encounters. Welcome to the Stone Age, a time of danger and adventure.','2016/2/29','Released','https://store.steampowered.com/app/371660/Far_Cry_Primal/?snr=1_7_7_230_150_16'),(742,'among_us_3d',NULL,'Teamwork and betrayal in space! In this PC & VR party game, Crewmates work together to complete tasks before one or more Impostors kill everyone aboard. Experience all of the same deception and deceit as the original Among Us, but now in all three dimensions.','2025/5/6','Released','https://store.steampowered.com/app/3168600/Among_Us_3D/?snr=1_7_7_230_150_16'),(743,'dragon_quest®_xi_s:_echoes_of_an_elusive_age™_-_definitive_edition',NULL,'The Definitive Edition includes the critically acclaimed DRAGON QUEST XI, plus additional scenarios, orchestral soundtrack, 2D mode and more! Whether you are a longtime fan or a new adventurer, this is the ultimate DQXI experience.','2020/12/4','Released','https://store.steampowered.com/app/1295510/DRAGON_QUEST_XI_S_Echoes_of_an_Elusive_Age__Definitive_Edition/?snr=1_7_7_230_150_16'),(744,'fishing_planet:_chamaeleon_cruiser_pack',NULL,'This content requires the base game Fishing Planet on Steam in order to play.','2025/6/18','Released','https://store.steampowered.com/app/3743490/Fishing_Planet_Chamaeleon_Cruiser_Pack/?snr=1_7_7_230_150_16'),(745,'the_binding_of_isaac:_afterbirth+',NULL,'This content requires the base game The Binding of Isaac: Afterbirth on Steam in order to play.','2017/1/3','Released','https://store.steampowered.com/app/570660/The_Binding_of_Isaac_Afterbirth/?snr=1_7_7_230_150_16'),(746,'card_shop_simulator_multiplayer',NULL,'You and your friends are going to compete to see whose card shop can earn more money! Starting from a humble little shop, decorate your store, hire staff, formulate marketing strategies. Finally, use the coolest cards to engage in card battles, and win away your friends\' precious cards!','2025/6/17','Released','https://store.steampowered.com/app/3569500/Card_Shop_Simulator_Multiplayer/?snr=1_7_7_230_150_16'),(747,'little_nightmares_iii',NULL,'Little Nightmares III is an atmospheric adventure game in which you follow the journey of Low and Alone, two best friends in search of a way out of the Nowhere. In 2 players online cooperation or solo with an A.I., work together to solve puzzles and survive in this nightmarish world.','2025/10/9','Unreleased','https://store.steampowered.com/app/1392860/Little_Nightmares_III/?snr=1_7_7_230_150_16'),(748,'stalcraft:_x',NULL,'STALCRAFT: X is the largest