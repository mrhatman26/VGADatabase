--
-- Table structure for table `link_game_age_rating`
--

DROP TABLE IF EXISTS `link_game_age_rating`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `link_game_age_rating` (
  `link_id` int NOT NULL AUTO_INCREMENT,
  `game_id` int NOT NULL,
  `age_id` int NOT NULL,
  `user_id` int NOT NULL,
  `age_cDate` text,
  `age_link_approved` tinyint(1) DEFAULT '0',
  `age_aDate` text,
  `age_denied` tinyint(1) DEFAULT '0',
  `age_dDate` text,
  `age_dDes` text,
  PRIMARY KEY (`link_id`),
  KEY `game_id` (`game_id`),
  KEY `age_id` (`age_id`),
  KEY `user_id` (`user_id`),
  CONSTRAINT `link_game_age_rating_ibfk_1` FOREIGN KEY (`game_id`) REFERENCES `table_games` (`game_id`),
  CONSTRAINT `link_game_age_rating_ibfk_2` FOREIGN KEY (`age_id`) REFERENCES `table_age_ratings` (`age_id`),
  CONSTRAINT `link_game_age_rating_ibfk_3` FOREIGN KEY (`user_id`) REFERENCES `table_users` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

